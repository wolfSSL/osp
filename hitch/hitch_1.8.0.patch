diff --git a/src/tests/test13-r82.sh b/src/tests/test13-r82.sh
index 87e8e39..0a60506 100755
--- a/src/tests/test13-r82.sh
+++ b/src/tests/test13-r82.sh
@@ -56,33 +56,36 @@ EOF
 
 start_hitch --config=hitch.cfg
 
+# The cipher list above is TLS 1.2-only; with wolfSSL it applies to
+# TLS 1.3 as well, so connect with TLS 1.2.
+
 # Wildcard cert on frontend #1
-s_client -servername foo.example.com \
+s_client -tls1_2 -servername foo.example.com \
 	-connect localhost:$PORT1 \
 	>wildcard1.dump
 subject_field_eq CN "*.example.com" wildcard1.dump
 
 # Wildcard cert on frontend #2
-s_client -servername bar.example.com \
+s_client -tls1_2 -servername bar.example.com \
 	-connect localhost:$PORT2 \
 	>wildcard2.dump
 subject_field_eq CN "*.example.com" wildcard2.dump
 
 # Exact match on frontend #2
-s_client -servername site1.example.com \
+s_client -tls1_2 -servername site1.example.com \
 	-connect localhost:$PORT2 \
 	>exact2.dump
 subject_field_eq CN "site1.example.com" exact2.dump
 
 # Verify that sni-nomatch-abort = off is respected for frontend #1
-s_client -servername "asdf" \
+s_client -tls1_2 -servername "asdf" \
 	-connect localhost:$PORT1 \
 	>abort1.dump
 subject_field_eq CN "*.example.com" abort1.dump
 
 # And also verify that global setting sni-nomatch-abort = on is respected
 # for other frontend
-! s_client -servername "asdf" \
+! s_client -tls1_2 -servername "asdf" \
 	-connect localhost:$PORT3 \
 	>abort3.dump
 run_cmd grep -q 'unrecognize' abort3.dump
