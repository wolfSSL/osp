+	TEST_ASSERT_EQUAL(-1, fdo_tpm_get_hmac(data, sizeof(data), NULL,
+					       sizeof(hmac),
+					       TPM_HMAC_KEY_PERSISTANT_HANDLE));
+	TEST_ASSERT_EQUAL(-1, fdo_tpm_get_hmac(data, sizeof(data), hmac, 0,
+					       TPM_HMAC_KEY_PERSISTANT_HANDLE));
+	TEST_ASSERT_EQUAL(-1,
