+#ifdef USE_WOLFSSL
+ecc_key *generateECDSA_key(int curve, WC_RNG *rng)
+{
+	int curve_id;
+	ecc_key *key = fdo_alloc(sizeof(ecc_key));
+
+	if (!key) {
+		return NULL;
+	}
+	curve_id = (curve == 256) ? ECC_SECP256R1 : ECC_SECP384R1;
+	if (wc_InitRng(rng) != 0 || wc_ecc_init(key) != 0 ||
+	    wc_ecc_make_key_ex(rng, 0, key, curve_id) != 0) {
+		fdo_free(key);
+		return NULL;
+	}
+	return key;
+}
+
+/* Returns 1 on success, 0/-1 on failure. Produces a raw r||s signature
+ * (not DER), as crypto_hal_sig_verify() expects for this backend. */
+int sha_ECCsign(int curve, uint8_t *msg, uint32_t mlen, uint8_t *out,
+		uint32_t *outlen, ecc_key *key, WC_RNG *rng)
+{
+	uint8_t hash[WC_SHA512_DIGEST_SIZE] = {0};
+	size_t hash_length =
+	    (curve == 256) ? SHA256_DIGEST_SIZE : SHA384_DIGEST_SIZE;
+	mp_int r, s;
+	int result = -1;
+	int coord = wc_ecc_size(key);
+	int ret;
+
+	if (curve == 256) {
+		ret = wc_Sha256Hash((const byte *)msg, mlen, hash);
+	} else {
+		ret = wc_Sha384Hash((const byte *)msg, mlen, hash);
+	}
+	if (ret != 0) {
+		goto done;
+	}
+
+	mp_init(&r);
+	mp_init(&s);
+	if (wc_ecc_sign_hash_ex(hash, (word32)hash_length, rng, key, &r, &s) !=
+	    0) {
+		mp_clear(&r);
+		mp_clear(&s);
+		goto done;
+	}
+
+	/* Pad r and s to the coordinate size: mp_to_unsigned_bin() strips
+	 * leading zeros, which would misplace s and give an odd length. */
+	if (coord <= 0 || mp_to_unsigned_bin_len(&r, out, coord) != MP_OKAY ||
+	    mp_to_unsigned_bin_len(&s, out + coord, coord) != MP_OKAY) {
+		mp_clear(&r);
+		mp_clear(&s);
+		goto done;
+	}
+	*outlen = (uint32_t)(2 * coord);
+	mp_clear(&r);
+	mp_clear(&s);
+	result = 1;
+
+done:
+	/* NOTE: `key` is not freed here; caller retains ownership for getFDOpk(). */
+	return result;
+}
+
+fdo_public_key_t *getFDOpk(int curve, ecc_key *key)
+{
+	unsigned char key_buf[DER_PUBKEY_LEN_MAX];
+	int key_buf_len;
+	fdo_public_key_t *pk = NULL;
+
+	/* X509 encoding means a DER SubjectPublicKeyInfo, which is what
+	 * crypto_hal_sig_verify() decodes. */
+	key_buf_len = wc_EccPublicKeyToDer(key, key_buf, sizeof(key_buf), 1);
+	if (key_buf_len <= 0) {
+		return NULL;
+	}
+
+	if (curve == 256) {
+		pk = fdo_public_key_alloc(FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp256,
+					  FDO_CRYPTO_PUB_KEY_ENCODING_X509,
+					  key_buf_len, key_buf);
+	} else {
+		pk = fdo_public_key_alloc(FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp384,
+					  FDO_CRYPTO_PUB_KEY_ENCODING_X509,
+					  key_buf_len, key_buf);
+	}
+	if (!pk || !pk->key1) {
+		return NULL;
+	}
+	pk->key2 = NULL;
+	return pk;
+}
