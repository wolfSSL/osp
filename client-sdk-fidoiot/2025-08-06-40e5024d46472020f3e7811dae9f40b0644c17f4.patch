+# verify_signature <tarball> <detached-sig-url> <armored-pubkey> <expected-fingerprint>
+verify_signature()
+{
+    local tarball="$1" sig_url="$2" pubkey="$3" expected_fpr="$4"
+    local gnupg_home sig_file
+
+    gnupg_home=$(mktemp -d)
+    sig_file=$(mktemp)
+    trap 'rm -rf "$gnupg_home" "$sig_file"' RETURN
+
+    wget -O "$sig_file" "$sig_url"
+
+    GNUPGHOME="$gnupg_home" gpg --batch --quiet --import <<<"$pubkey"
+
+    local verify_output
+    verify_output=$(GNUPGHOME="$gnupg_home" gpg --batch --status-fd 1 \
+        --verify "$sig_file" "$tarball" 2>&1)
+
+    if ! grep -q "^\[GNUPG:\] GOODSIG " <<<"$verify_output"; then
+        echo "ERROR: GPG signature verification FAILED for $tarball" >&2
+        echo "$verify_output" >&2
+        return 1
+    fi
+    if ! grep -q "^\[GNUPG:\] VALIDSIG $expected_fpr " <<<"$verify_output"; then
+        echo "ERROR: $tarball was signed by an unexpected key (expected fingerprint $expected_fpr)" >&2
+        echo "$verify_output" >&2
+        return 1
+    fi
+    echo "GPG signature OK: $tarball (verified against $expected_fpr)"
+}
+
+install()
+{
+    # The release publishes only signatures; they sign GitHub's tag archive.
+    WOLFSSL_LINK="https://github.com/wolfSSL/wolfssl/archive/refs/tags/v$WOLFSSL_VER-stable.tar.gz"
+    WOLFSSL_SIG_LINK="https://github.com/wolfSSL/wolfssl/releases/download/v$WOLFSSL_VER-stable/wolfssl-$WOLFSSL_VER-stable.tar.gz.asc"
+    echo "Build & Install wolfSSL version : $WOLFSSL_VER"
+    cd "$PARENT_DIR"
+    rm -f "wolfssl-$WOLFSSL_VER-stable.tar.gz"
+    wget -O "wolfssl-$WOLFSSL_VER-stable.tar.gz" "$WOLFSSL_LINK"
+    verify_signature "wolfssl-$WOLFSSL_VER-stable.tar.gz" "$WOLFSSL_SIG_LINK" \
+        "$WOLFSSL_PUBKEY" "$WOLFSSL_GPG_FPR"
+    tar -xvzf "wolfssl-$WOLFSSL_VER-stable.tar.gz"
+    cd "wolfssl-$WOLFSSL_VER-stable"
+
+    ./autogen.sh
+    # Feature set for FDO SDK.
+    ./configure --prefix="$WOLFSSL_ROOT" \
+        --enable-ecc --enable-keygen --enable-certgen --enable-certreq \
+        --enable-certext --enable-aesgcm --enable-aesccm --enable-aescfb \
+        --enable-sha --enable-sha256 --enable-sha384 --enable-tls13 \
+        --enable-harden --enable-wolftpm --enable-pkcallbacks --enable-curl \
+        C_EXTRA_FLAGS="-DWOLFSSL_PUBLIC_MP -DWC_RNG_SEED_CB -DWOLFSSL_CUSTOM_OID -DHAVE_OID_ENCODING"
+    make -j"$(nproc)"
+    $SUDO make install
+
+    echo "$WOLFSSL_ROOT/lib/" | $SUDO tee /etc/ld.so.conf.d/wolfssl.conf
+    $SUDO ldconfig
+
+    echo "Build & Install Curl version : $CURL_VER, linked against wolfSSL"
+    cd "$PARENT_DIR"
+    rm -f "curl-$CURL_VER.tar.gz"
+    wget "$CURL_LINK"
+    verify_signature "curl-$CURL_VER.tar.gz" "$CURL_LINK.asc" \
+        "$CURL_PUBKEY" "$CURL_GPG_FPR"
+    tar -xvzf "curl-$CURL_VER.tar.gz"
+    cd "curl-$CURL_VER"
+
+    # Configure curl.
+    ./configure --prefix="$CURL_ROOT" --with-wolfssl="$WOLFSSL_ROOT" \
+        --with-nghttp2 --enable-versioned-symbols --without-libpsl \
+        --disable-aws
+    make -j"$(nproc)"
+    $SUDO make install
+
+    # Exclude $CURL_ROOT/lib from ld.so.conf to avoid breaking system tools.
+    LD_LIBRARY_PATH="$CURL_ROOT/lib:$LD_LIBRARY_PATH" $CURL_ROOT/bin/curl -V
+}
