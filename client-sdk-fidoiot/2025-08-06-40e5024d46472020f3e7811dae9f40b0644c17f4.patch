diff --git a/storage/include/fdo_tpm_handles.h b/storage/include/fdo_tpm_handles.h
new file mode 100644
index 0000000..f7cf93a
--- /dev/null
+++ b/storage/include/fdo_tpm_handles.h
@@ -0,0 +1,52 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*
+ * TPM NV index / persistent-object handles and entry points.
+ * Uses plain uint32_t to avoid TPM stack dependencies.
+ */
+
+#ifndef __FDO_TPM_HANDLES_H__
+#define __FDO_TPM_HANDLES_H__
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define FDO_DCActive_NV_IDX 0x01D10000
+#define FDO_CRED_NV_IDX 0x01D10001
+#define TPM_DEVICE_KEY_PERSISTANT_HANDLE 0x81020002
+#define TPM_HMAC_KEY_PERSISTANT_HANDLE 0x81020003
+#define TPM_DEVICE_CSR_NV_IDX 0x01D10005
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int32_t fdo_tpm_get_hmac(const uint8_t *data, size_t data_length, uint8_t *hmac,
+			 size_t hmac_length, uint32_t persistent_handle);
+int32_t fdo_tpm_generate_hmac_key(uint32_t persistent_handle);
+
+int fdo_tpm_nvdefine(uint32_t nv, size_t data_size);
+int fdo_tpm_nvwrite(const uint8_t *data, size_t data_size, uint32_t nv);
+int fdo_tpm_nvwrite_lock(uint32_t nv);
+
+/*
+ * Size in bytes of the data stored at NV index nv.
+ *
+ * Returns 0 if the index is undefined or could not be read. Callers cannot
+ * distinguish those cases and must treat 0 as "no usable data". Every backend
+ * must agree on this: the return type is size_t, so a -1 sentinel becomes
+ * SIZE_MAX and flows into allocation sizes rather than being caught.
+ */
+size_t fdo_tpm_nvread_size(uint32_t nv);
+int fdo_tpm_nvread(uint32_t nv, size_t data_size, uint8_t **data);
+int fdo_tpm_nvread_lock(uint32_t nv);
+int fdo_tpm_nvdel(uint32_t nv);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __FDO_TPM_HANDLES_H__ */
