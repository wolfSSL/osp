+					  FDO_CRYPTO_PUB_KEY_ENCODING_X509,
+					  key_buf_len, key_buf);
+	}
+	if (!pk || !pk->key1) {
+		return NULL;
+	}
+	pk->key2 = NULL;
+	return pk;
+}
