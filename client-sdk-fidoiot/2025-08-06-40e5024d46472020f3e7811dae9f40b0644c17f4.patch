+void set_up(void)
+{
+}
+
+void tear_down(void)
+{
+}
+#endif
+
+/**
+ * Test ECDH round trip by playing owner via wolfCrypt.
+ */
+#ifdef USE_WOLFSSL
+#ifndef TARGET_OS_FREERTOS
+void test_ecdh_key_exchange_round_trip(void)
+#else
+TEST_CASE("ecdh_key_exchange_round_trip", "[ECDH][fdo]")
+#endif
+{
+	void *device_ctx = NULL;
+	uint8_t *device_public = NULL;
+	uint32_t device_public_len = 0;
+	uint8_t *device_secret = NULL;
+	uint32_t device_secret_len = 0;
+	uint8_t *owner_response = NULL;
+	ecc_key owner_key;
+	ecc_key device_pub_key;
+	WC_RNG owner_rng;
+	int owner_key_inited = 0;
+	int device_pub_key_inited = 0;
+	int owner_rng_inited = 0;
+
+	TEST_ASSERT_EQUAL(0, random_init());
+
+	TEST_ASSERT_EQUAL(0, crypto_hal_kex_init(&device_ctx));
+	TEST_ASSERT_NOT_NULL(device_ctx);
+
+	/* Fetch device public random. */
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_device_random(device_ctx, NULL,
+							  &device_public_len));
+	TEST_ASSERT_TRUE(device_public_len > 4);
+	device_public = fdo_alloc(device_public_len);
+	TEST_ASSERT_NOT_NULL(device_public);
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_device_random(
+				  device_ctx, device_public, &device_public_len));
+
+	/* Parse out the device's raw EC public point (X, Y). */
+	uint32_t idx = 0;
+	uint32_t dev_x_len = (device_public[idx] << 8) | device_public[idx + 1];
+	idx += 2;
+	uint8_t *dev_x = &device_public[idx];
+	idx += dev_x_len;
+	uint32_t dev_y_len = (device_public[idx] << 8) | device_public[idx + 1];
+	idx += 2;
+	uint8_t *dev_y = &device_public[idx];
+	idx += dev_y_len;
+	/* Read the device's randlen field directly. */
+	uint32_t dev_rand_len = (device_public[idx] << 8) | device_public[idx + 1];
+
+	/* Owner side: gen keypair and derive ECDH secret. */
+	TEST_ASSERT_EQUAL(0, wc_ecc_init(&owner_key));
+	owner_key_inited = 1;
+	TEST_ASSERT_EQUAL(0, wc_InitRng(&owner_rng));
+	owner_rng_inited = 1;
+	TEST_ASSERT_EQUAL(0, wc_ecc_make_key(&owner_rng, (int)dev_x_len, &owner_key));
+	TEST_ASSERT_EQUAL(0, wc_ecc_set_rng(&owner_key, &owner_rng));
+
+	TEST_ASSERT_EQUAL(0, wc_ecc_init(&device_pub_key));
+	device_pub_key_inited = 1;
+	TEST_ASSERT_EQUAL(0, wc_ecc_import_unsigned(&device_pub_key, dev_x, dev_y,
+						    NULL, owner_key.dp->id));
+
+	uint8_t reference_secret[BUFF_SIZE_512_BYTES] = {0};
+	word32 reference_secret_len = sizeof(reference_secret);
+	TEST_ASSERT_EQUAL(0, wc_ecc_shared_secret(&owner_key, &device_pub_key,
+						  reference_secret,
+						  &reference_secret_len));
+
+	/* Build owner response. */
+	uint8_t owner_x[BUFF_SIZE_64_BYTES] = {0};
+	uint8_t owner_y[BUFF_SIZE_64_BYTES] = {0};
+	word32 owner_x_len = sizeof(owner_x);
+	word32 owner_y_len = sizeof(owner_y);
+	TEST_ASSERT_EQUAL(0, wc_ecc_export_public_raw(&owner_key, owner_x,
+						      &owner_x_len, owner_y,
+						      &owner_y_len));
+
+	uint8_t owner_random[BUFF_SIZE_64_BYTES] = {0};
+	uint32_t owner_random_len = dev_rand_len;
+	TEST_ASSERT_EQUAL(0, crypto_hal_random_bytes(owner_random, owner_random_len));
+
+	uint32_t owner_response_len =
+	    2 + owner_x_len + 2 + owner_y_len + 2 + owner_random_len;
+	owner_response = fdo_alloc(owner_response_len);
+	TEST_ASSERT_NOT_NULL(owner_response);
+	uint32_t off = 0;
+	owner_response[off] = (owner_x_len >> 8) & 0xFF;
+	owner_response[off + 1] = owner_x_len & 0xFF;
+	off += 2;
+	TEST_ASSERT_EQUAL(0, memcpy_s(&owner_response[off], owner_response_len - off,
+				      owner_x, owner_x_len));
+	off += owner_x_len;
+	owner_response[off] = (owner_y_len >> 8) & 0xFF;
+	owner_response[off + 1] = owner_y_len & 0xFF;
+	off += 2;
+	TEST_ASSERT_EQUAL(0, memcpy_s(&owner_response[off], owner_response_len - off,
+				      owner_y, owner_y_len));
+	off += owner_y_len;
+	owner_response[off] = (owner_random_len >> 8) & 0xFF;
+	owner_response[off + 1] = owner_random_len & 0xFF;
+	off += 2;
+	TEST_ASSERT_EQUAL(0, memcpy_s(&owner_response[off], owner_response_len - off,
+				      owner_random, owner_random_len));
+
+	TEST_ASSERT_EQUAL(0, crypto_hal_set_peer_random(device_ctx, owner_response,
+							owner_response_len));
+
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_secret(device_ctx, NULL, &device_secret_len));
+	TEST_ASSERT_TRUE(device_secret_len >= reference_secret_len);
+	device_secret = fdo_alloc(device_secret_len);
+	TEST_ASSERT_NOT_NULL(device_secret);
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_secret(device_ctx, device_secret,
+						   &device_secret_len));
+
+	/* Device secret must start with expected raw ECDH secret. */
+	int result_memcmp = 0;
+	TEST_ASSERT_EQUAL(0, memcmp_s(device_secret, reference_secret_len,
+				     reference_secret, reference_secret_len,
+				     &result_memcmp));
+	TEST_ASSERT_EQUAL_MESSAGE(
+	    0, result_memcmp,
+	    "Device-derived secret does not start with the expected raw "
+	    "ECDH shared secret");
+
+	if (device_public) {
+		fdo_free(device_public);
+	}
+	if (device_secret) {
+		fdo_free(device_secret);
+	}
+	if (owner_response) {
+		fdo_free(owner_response);
+	}
+	if (device_pub_key_inited) {
+		wc_ecc_free(&device_pub_key);
+	}
+	if (owner_key_inited) {
+		wc_ecc_free(&owner_key);
+	}
+	if (owner_rng_inited) {
+		wc_FreeRng(&owner_rng);
+	}
+	crypto_hal_kex_close(&device_ctx);
+	TEST_ASSERT_EQUAL(0, random_close());
+}
+#else
+#ifndef TARGET_OS_FREERTOS
+void test_ecdh_key_exchange_round_trip(void)
+#else
+TEST_CASE("ecdh_key_exchange_round_trip", "[ECDH][fdo]")
+#endif
+{
+	TEST_IGNORE();
+}
+#endif // USE_WOLFSSL
+
+/**
+ * Verify device accepts short coordinate and derives correct secret.
+ */
+#ifdef USE_WOLFSSL
+#ifndef TARGET_OS_FREERTOS
+void test_ecdh_short_peer_coordinate(void)
+#else
+TEST_CASE("ecdh_short_peer_coordinate", "[ECDH][fdo]")
+#endif
+{
+	void *device_ctx = NULL;
+	uint8_t *device_public = NULL;
+	uint32_t device_public_len = 0;
+	uint8_t *device_secret = NULL;
+	uint32_t device_secret_len = 0;
+	uint8_t *owner_response = NULL;
+	ecc_key owner_key;
+	ecc_key device_pub_key;
+	WC_RNG owner_rng;
+	int owner_key_inited = 0;
+	int device_pub_key_inited = 0;
+	int owner_rng_inited = 0;
+	uint8_t owner_x[BUFF_SIZE_64_BYTES] = {0};
+	uint8_t owner_y[BUFF_SIZE_64_BYTES] = {0};
+	word32 owner_x_len = 0;
+	word32 owner_y_len = 0;
+	/* ~2/256 of keys have a stripped coordinate, so this all but always
+	 * succeeds well inside the cap. */
+	const int max_attempts = 4000;
+	int attempt = 0;
+
+	TEST_ASSERT_EQUAL(0, random_init());
+
+	TEST_ASSERT_EQUAL(0, crypto_hal_kex_init(&device_ctx));
+	TEST_ASSERT_NOT_NULL(device_ctx);
+
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_device_random(device_ctx, NULL,
+							  &device_public_len));
+	device_public = fdo_alloc(device_public_len);
+	TEST_ASSERT_NOT_NULL(device_public);
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_device_random(
+				  device_ctx, device_public, &device_public_len));
+
+	uint32_t idx = 0;
+	uint32_t dev_x_len = (device_public[idx] << 8) | device_public[idx + 1];
+	idx += 2;
+	uint8_t *dev_x = &device_public[idx];
+	idx += dev_x_len;
+	uint32_t dev_y_len = (device_public[idx] << 8) | device_public[idx + 1];
+	idx += 2;
+	uint8_t *dev_y = &device_public[idx];
+	idx += dev_y_len;
+	uint32_t dev_rand_len = (device_public[idx] << 8) | device_public[idx + 1];
+
+	TEST_ASSERT_EQUAL(0, wc_InitRng(&owner_rng));
+	owner_rng_inited = 1;
+
+	/* Hunt for keypair with leading zero byte. */
+	for (attempt = 0; attempt < max_attempts; attempt++) {
+		if (owner_key_inited) {
+			wc_ecc_free(&owner_key);
+			owner_key_inited = 0;
+		}
+		TEST_ASSERT_EQUAL(0, wc_ecc_init(&owner_key));
+		owner_key_inited = 1;
+		TEST_ASSERT_EQUAL(0, wc_ecc_make_key(&owner_rng, (int)dev_x_len,
+						     &owner_key));
+		TEST_ASSERT_EQUAL(0, wc_ecc_set_rng(&owner_key, &owner_rng));
+
+		owner_x_len = sizeof(owner_x);
+		owner_y_len = sizeof(owner_y);
+		TEST_ASSERT_EQUAL(0, wc_ecc_export_public_raw(&owner_key, owner_x,
+							      &owner_x_len,
+							      owner_y,
+							      &owner_y_len));
+		if (owner_x[0] == 0x00 || owner_y[0] == 0x00) {
+			break;
+		}
+	}
+	if (attempt == max_attempts) {
+		if (owner_key_inited) {
+			wc_ecc_free(&owner_key);
+		}
+		wc_FreeRng(&owner_rng);
+		fdo_free(device_public);
+		crypto_hal_kex_close(&device_ctx);
+		TEST_ASSERT_EQUAL(0, random_close());
+		TEST_IGNORE_MESSAGE("No keypair with a leading zero coordinate "
+				    "found");
+		return;
+	}
+
+	TEST_ASSERT_EQUAL(0, wc_ecc_init(&device_pub_key));
+	device_pub_key_inited = 1;
+	TEST_ASSERT_EQUAL(0, wc_ecc_import_unsigned(&device_pub_key, dev_x, dev_y,
+						    NULL, owner_key.dp->id));
+
+	uint8_t reference_secret[BUFF_SIZE_512_BYTES] = {0};
+	word32 reference_secret_len = sizeof(reference_secret);
+	TEST_ASSERT_EQUAL(0, wc_ecc_shared_secret(&owner_key, &device_pub_key,
+						  reference_secret,
+						  &reference_secret_len));
+
+	/* Strip the leading zero bytes, the way BN_bn2bin() would. */
+	uint8_t *x_p = owner_x;
+	uint8_t *y_p = owner_y;
+	uint32_t x_len = owner_x_len;
+	uint32_t y_len = owner_y_len;
+	while (x_len > 1 && x_p[0] == 0x00) {
+		x_p++;
+		x_len--;
+	}
+	while (y_len > 1 && y_p[0] == 0x00) {
+		y_p++;
+		y_len--;
+	}
+	TEST_ASSERT_TRUE(x_len < owner_x_len || y_len < owner_y_len);
+
+	uint8_t owner_random[BUFF_SIZE_64_BYTES] = {0};
+	uint32_t owner_random_len = dev_rand_len;
+	TEST_ASSERT_EQUAL(0, crypto_hal_random_bytes(owner_random, owner_random_len));
+
+	uint32_t owner_response_len = 2 + x_len + 2 + y_len + 2 + owner_random_len;
+	owner_response = fdo_alloc(owner_response_len);
+	TEST_ASSERT_NOT_NULL(owner_response);
+	uint32_t off = 0;
+	owner_response[off] = (x_len >> 8) & 0xFF;
+	owner_response[off + 1] = x_len & 0xFF;
+	off += 2;
+	TEST_ASSERT_EQUAL(0, memcpy_s(&owner_response[off], owner_response_len - off,
+				      x_p, x_len));
+	off += x_len;
+	owner_response[off] = (y_len >> 8) & 0xFF;
+	owner_response[off + 1] = y_len & 0xFF;
+	off += 2;
+	TEST_ASSERT_EQUAL(0, memcpy_s(&owner_response[off], owner_response_len - off,
+				      y_p, y_len));
+	off += y_len;
+	owner_response[off] = (owner_random_len >> 8) & 0xFF;
+	owner_response[off + 1] = owner_random_len & 0xFF;
+	off += 2;
+	TEST_ASSERT_EQUAL(0, memcpy_s(&owner_response[off], owner_response_len - off,
+				      owner_random, owner_random_len));
+
+	TEST_ASSERT_EQUAL_MESSAGE(
+	    0,
+	    crypto_hal_set_peer_random(device_ctx, owner_response,
+				       owner_response_len),
+	    "Peer coordinate with stripped leading zero was rejected");
+
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_secret(device_ctx, NULL, &device_secret_len));
+	device_secret = fdo_alloc(device_secret_len);
+	TEST_ASSERT_NOT_NULL(device_secret);
+	TEST_ASSERT_EQUAL(0, crypto_hal_get_secret(device_ctx, device_secret,
+						   &device_secret_len));
+
+	int result_memcmp = 0;
+	TEST_ASSERT_EQUAL(0, memcmp_s(device_secret, reference_secret_len,
+				     reference_secret, reference_secret_len,
+				     &result_memcmp));
+	TEST_ASSERT_EQUAL_MESSAGE(
+	    0, result_memcmp,
+	    "Device-derived secret does not start with the expected raw "
+	    "ECDH shared secret");
+
+	if (device_public) {
+		fdo_free(device_public);
+	}
+	if (device_secret) {
+		fdo_free(device_secret);
+	}
+	if (owner_response) {
+		fdo_free(owner_response);
+	}
+	if (device_pub_key_inited) {
+		wc_ecc_free(&device_pub_key);
+	}
+	if (owner_key_inited) {
+		wc_ecc_free(&owner_key);
+	}
+	if (owner_rng_inited) {
+		wc_FreeRng(&owner_rng);
+	}
+	crypto_hal_kex_close(&device_ctx);
+	TEST_ASSERT_EQUAL(0, random_close());
+}
+#else
+#ifndef TARGET_OS_FREERTOS
+void test_ecdh_short_peer_coordinate(void)
+#else
+TEST_CASE("ecdh_short_peer_coordinate", "[ECDH][fdo]")
+#endif
+{
+	TEST_IGNORE();
+}
+#endif // USE_WOLFSSL
+
+/**
+ * Verify rejection of invalid arguments.
+ */
+#ifndef TARGET_OS_FREERTOS
+void test_ecdh_invalid_args(void)
+#else
+TEST_CASE("ecdh_invalid_args", "[ECDH][fdo]")
+#endif
+{
+	TEST_ASSERT_NOT_EQUAL(0, crypto_hal_kex_init(NULL));
+	TEST_ASSERT_NOT_EQUAL(0, crypto_hal_kex_close(NULL));
+	TEST_ASSERT_NOT_EQUAL(0,
+			      crypto_hal_set_peer_random(NULL, NULL, 0));
+
+	TEST_ASSERT_EQUAL(0, random_init());
+
+	void *ctx = NULL;
+	TEST_ASSERT_EQUAL(0, crypto_hal_kex_init(&ctx));
+	TEST_ASSERT_NOT_NULL(ctx);
+	TEST_ASSERT_NOT_EQUAL(
+	    0, crypto_hal_set_peer_random(ctx, NULL, 0));
+
+	/* Ax length field claims more bytes than are actually present. */
+	uint8_t truncated_ax[] = {0x00, 0x40, 0x01, 0x02};
+	TEST_ASSERT_NOT_EQUAL(0, crypto_hal_set_peer_random(
+				     ctx, truncated_ax, sizeof(truncated_ax)));
+
+	/* Buffer ends right after the Ax length field, before any Ax data
+	 * or the Ay/owner-random fields that must follow it. */
+	uint8_t missing_ay[] = {0x00, 0x00};
+	TEST_ASSERT_NOT_EQUAL(0, crypto_hal_set_peer_random(
+				     ctx, missing_ay, sizeof(missing_ay)));
+
+	/* Ax/Ay lengths are internally consistent and short enough to be
+	 * accepted by the parser, but the padded coordinates are not a point
+	 * on the curve, so the import must still fail. */
+	uint8_t short_ax_ay[] = {0x00, 0x01, 0xAA, 0x00, 0x01, 0xBB,
+				 0x00, 0x00};
+	TEST_ASSERT_NOT_EQUAL(0, crypto_hal_set_peer_random(
+				     ctx, short_ax_ay, sizeof(short_ax_ay)));
+
+	/* Owner-random length field points past the end of the buffer. */
+	uint8_t oversized_owner_random[] = {0x00, 0x00, 0x00, 0x00,
+					     0xFF, 0xFF};
+	TEST_ASSERT_NOT_EQUAL(
+	    0, crypto_hal_set_peer_random(ctx, oversized_owner_random,
+					  sizeof(oversized_owner_random)));
+
+	crypto_hal_kex_close(&ctx);
+
+	TEST_ASSERT_EQUAL(0, random_close());
