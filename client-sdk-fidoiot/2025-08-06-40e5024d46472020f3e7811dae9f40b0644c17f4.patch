+	mock_setauthhandlename_rc = -1;
+
+	TEST_ASSERT_EQUAL(-1, fdo_tpm_nvread_lock(FDO_CRED_NV_IDX));
+	TEST_ASSERT_TRUE(mock_nvopen_called);
+	TEST_ASSERT_TRUE(mock_setauthhandlename_called);
+	TEST_ASSERT_FALSE(mock_readlock_called);
+}
+
+void test_fdo_tpm_nvread_lock_readlock_failure(void)
+{
+	EXPECT_LOCK_NOOP_UNLESS_LOCK_TPM(fdo_tpm_nvread_lock(FDO_CRED_NV_IDX));
+	mock_readlock_rc = TPM_RC_FAILURE;
+
+	TEST_ASSERT_EQUAL(-1, fdo_tpm_nvread_lock(FDO_CRED_NV_IDX));
+	TEST_ASSERT_TRUE(mock_readlock_called);
