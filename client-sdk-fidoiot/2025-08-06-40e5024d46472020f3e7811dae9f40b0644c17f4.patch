+TEST_CASE("crypto_support_inc_rollover_ctr_basic", "[crypto_support][fdo]")
+#endif
+{
+	uint8_t first_iv[16] = {0};
+	uint8_t new_iv[16] = {0};
+	int ret;
+
+	ret = inc_rollover_ctr(first_iv, new_iv, sizeof(new_iv), 1);
+	TEST_ASSERT_EQUAL(0, ret);
+	TEST_ASSERT_EQUAL_UINT8(1, new_iv[15]);
+	for (int i = 0; i < 15; i++) {
