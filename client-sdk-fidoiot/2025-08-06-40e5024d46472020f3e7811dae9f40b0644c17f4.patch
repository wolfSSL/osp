+/* Without LOCK_TPM the lock calls compile to no-ops that return 0, so
+ * check that instead of the TPM interactions. */
+#if defined(LOCK_TPM)
+#define EXPECT_LOCK_NOOP_UNLESS_LOCK_TPM(call) do { } while (0)
+#else
+#define EXPECT_LOCK_NOOP_UNLESS_LOCK_TPM(call)                                  \
+	do {                                                                   \
+		TEST_ASSERT_EQUAL(0, (call));                                  \
+		return;                                                        \
+	} while (0)
+#endif
