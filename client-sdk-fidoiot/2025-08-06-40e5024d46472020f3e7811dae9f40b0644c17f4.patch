@@ -104,7 +106,11 @@ if [ $SKIP_UNIT_TEST -eq 1 ]; then
 fi
 
 echo " ***** Running Unit Tests *****"
-TEST_OUTPUT="build/unit-test-output.txt"
+# Keep this out of build/: run_unit_test starts with "make pristine", which
+# deletes that directory (see cmake/pristine.cmake), so results accumulated
+# there would be discarded by the next configuration and only the last run
+# would ever reach the fail_count below.
+TEST_OUTPUT="unit-test-output.txt"
 rm -f $TEST_OUTPUT
 COMMON_TEST_CONFIG="-Dunit-test=true -DHTTPPROXY=true -DBUILD=release"
 
@@ -122,8 +128,8 @@ run_unit_test -DDA=ecdsa384 -DAES_MODE=gcm
 run_unit_test -DDA=ecdsa384 -DAES_MODE=ccm
 run_unit_test -DDA=ecdsa256 -DAES_MODE=gcm -DDA_FILE=pem
 
-# DO NOT change the AWK search string, the spaces has been kept deliberately.
-fail_count=$(awk '/Tests Failed  :/ {split($0,a,": "); count+=a[2]} END{print count}' $TEST_OUTPUT)
+fail_count=$(awk -F':' '/Tests Failed/ {count+=$2} END{print count+0}' "$TEST_OUTPUT")
 echo "Found $fail_count unit-test failure(s)."
 
-exit $fail_count
+# Raw counts wrap modulo 256 as exit codes.
+exit $(( fail_count > 0 ? 1 : 0 ))
