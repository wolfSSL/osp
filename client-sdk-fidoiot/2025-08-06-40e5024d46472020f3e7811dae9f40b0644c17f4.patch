@@ -0,0 +1,103 @@
+#SDO yocto project
+
+DESCRIPTION="Recipe for SDO (client-sdk) on linux with wolfSSL"
+LICENSE = "Apache-2.0"
+BB_STRICT_CHECKSUM = "0"
+
+LIC_FILES_CHKSUM = "file://LICENSE;md5=fa818a259cbed7ce8bc2a22d35a464fc"
+
+# Upstream is archived, so this builds its final code commit with the
+# wolfSSL OSP patch applied on top. Copy the patch from
+# github.com/wolfSSL/osp (client-sdk-fidoiot/) into files/ next to this recipe:
+#   2025-08-06-40e5024d46472020f3e7811dae9f40b0644c17f4.patch
+SRC_URI = "git://github.com/fido-device-onboard/client-sdk-fidoiot.git;protocol=https;branch=master \
+           file://2025-08-06-40e5024d46472020f3e7811dae9f40b0644c17f4.patch \
+          "
+SRCREV = "40e5024d46472020f3e7811dae9f40b0644c17f4"
+
+S = "${WORKDIR}/git"
+
+TOOLCHAIN = "POKY-GLIBC"
+APP_NAME = "c_code_sdk"
+DEPENDS += "wolfssl curl"
+
+inherit pkgconfig cmake
+
+INSANE_SKIP:${PN} = "dev-elf ldflags"
+INSANE_SKIP:${PN}-dev = "ldflags"
+PACKAGES = "${PN}"
+INHIBIT_PACKAGE_DEBUG_SPLIT = "1"
+INHIBIT_PACKAGE_STRIP = "1"
+INHIBIT_SYSROOT_STRIP = "1"
+FILES:${PN} += "/opt \
+                /opt/sdo \
+                /opt/sdo/linux-client \
+                /opt/sdo/data \
+                /opt/sdo/data/* \
+                /opt/sdo/data_bkp \
+                /opt/sdo/data_bkp/* \
+                /opt/sdo/data_bkp/data/*"
+# make command parameters
+BUILD = "debug"
+HTTPPROXY = "false"
+AES_MODE = "gcm"
+DA = "ecdsa384"
+
+do_configure(){
+}
+
+# do_compile clones safestringlib directly (see below); BitBake sandboxes
+# task network access by default, so this task needs it explicitly.
+do_compile[network] = "1"
+
+do_compile(){
+CUR_DIR=$(pwd)
+cd "${WORKDIR}/git"
+
+if [ ! -d "crypto/wolfssl" ]; then
+	bbfatal "crypto/wolfssl/ is missing: 2025-08-06-40e5024d46472020f3e7811dae9f40b0644c17f4.patch was not applied."
+fi
+
+cd ${CUR_DIR}/../
+
+if [ ! -d "safestringlib" ] ; then
+	git clone -b v1.2.0 https://github.com/intel/safestringlib.git
+fi
+export SAFESTRING_ROOT=${CUR_DIR}/../safestringlib
+cd ${SAFESTRING_ROOT}
+rm -rf makefile
+sed -i '/mmitigate-rop/d' ./CMakeLists.txt
+cmake .
+make
+cp libsafestring_static.a libsafestring.a
+
+cd ${CUR_DIR}/../
+if [ ! -d "tinycbor" ] ; then
+	git clone -b v0.6.0 https://github.com/intel/tinycbor.git
+fi
+export TINYCBOR_ROOT=${CUR_DIR}/../tinycbor
+cd ${TINYCBOR_ROOT}
+make
+
+echo " >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>><<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< "
+echo "${S}":"${DA}":"${BUILD}":"${AES_MODE}"
+echo " >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>><<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< "
+cd ${S}
+export WOLFSSL_ROOT="${STAGING_DIR_HOST}${prefix}"
+export CURL_ROOT="${STAGING_DIR_HOST}${prefix}"
+cmake -DTLS=wolfssl -DHTTPPROXY=${HTTPPROXY} -DBUILD=${BUILD} -DDA=${DA} -DAES_MODE=${AES_MODE} -DOPTIMIZE=1 . ;
+make -j$(nproc)
+}
+
+do_install() {
+    install -d "${D}/opt/sdo"
+    install "${WORKDIR}/git/build/linux-client" "${D}/opt/sdo"
+    install -d "${D}/opt/sdo/data"
+    cp -r "${WORKDIR}/git/data/" "${D}/opt/sdo/"
+    install -d "${D}/opt/sdo/data_bkp"
+    cp -r "${WORKDIR}/git/data/" "${D}/opt/sdo/data_bkp"
+}
+
+do_package_qa[noexec] = "1"
+
+INITSCRIPT_PACKAGES = "${PN}"
