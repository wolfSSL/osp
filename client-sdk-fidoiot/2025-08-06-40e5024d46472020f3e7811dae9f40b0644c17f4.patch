+			       const byte *data, word32 dataSz);
+int __wrap_wolfTPM2_HashFinish(WOLFTPM2_DEV *dev, WOLFTPM2_HASH *hash,
+			       byte *digest, word32 *digestSz);
+int __wrap_wolfTPM2_ReadPublicKey(WOLFTPM2_DEV *dev, WOLFTPM2_KEY *key,
+				  const TPM_HANDLE handle);
+int __wrap_wolfTPM2_SignHashScheme(WOLFTPM2_DEV *dev, WOLFTPM2_KEY *key,
+				   const byte *digest, int digestSz, byte *sig,
+				   int *sigSz, TPMI_ALG_SIG_SCHEME sigAlg,
+				   TPMI_ALG_HASH hashAlg);
+int __wrap_wolfTPM2_UnloadHandle(WOLFTPM2_DEV *dev, WOLFTPM2_HANDLE *handle);
+int __wrap_wolfTPM2_Cleanup(WOLFTPM2_DEV *dev);
+
+/* Mock control state, reset in setUp(). */
+static int mock_init_rc;
+static int mock_hashstart_rc;
+static int mock_hashfinish_rc;
+static int mock_readpublickey_rc;
+static int mock_signhash_rc;
+static int mock_signhash_sz;
+static byte mock_sig_bytes[BUFF_SIZE_64_BYTES];
+static int mock_hashstart_called;
+static int mock_hashfinish_called;
+static int mock_readpublickey_called;
+static int mock_signhash_called;
+
+void setUp(void)
+{
+	mock_init_rc = TPM_RC_SUCCESS;
+	mock_hashstart_rc = TPM_RC_SUCCESS;
+	mock_hashfinish_rc = TPM_RC_SUCCESS;
+	mock_readpublickey_rc = TPM_RC_SUCCESS;
+	mock_signhash_rc = TPM_RC_SUCCESS;
+	mock_signhash_sz = sizeof(mock_sig_bytes);
+	mock_hashstart_called = 0;
+	mock_hashfinish_called = 0;
+	mock_readpublickey_called = 0;
+	mock_signhash_called = 0;
+	memset(mock_sig_bytes, 0xAB, sizeof(mock_sig_bytes));
+}
+
+void tearDown(void)
+{
+}
+
+int __wrap_wolfTPM2_Init(WOLFTPM2_DEV *dev, TPM2HalIoCb ioCb, void *userCtx)
+{
+	(void)dev;
+	(void)ioCb;
+	(void)userCtx;
+	return mock_init_rc;
+}
+
+int __wrap_wolfTPM2_HashStart(WOLFTPM2_DEV *dev, WOLFTPM2_HASH *hash,
+			      TPMI_ALG_HASH hashAlg, const byte *usageAuth,
+			      word32 usageAuthSz)
+{
+	(void)dev;
+	(void)hash;
+	(void)hashAlg;
+	(void)usageAuth;
+	(void)usageAuthSz;
+	mock_hashstart_called = 1;
+	return mock_hashstart_rc;
+}
+
+int __wrap_wolfTPM2_HashUpdate(WOLFTPM2_DEV *dev, WOLFTPM2_HASH *hash,
+			       const byte *data, word32 dataSz)
+{
+	(void)dev;
+	(void)hash;
+	(void)data;
+	(void)dataSz;
+	return TPM_RC_SUCCESS;
+}
+
+int __wrap_wolfTPM2_HashFinish(WOLFTPM2_DEV *dev, WOLFTPM2_HASH *hash,
+			       byte *digest, word32 *digestSz)
+{
+	(void)dev;
+	(void)hash;
+	mock_hashfinish_called = 1;
+	if (mock_hashfinish_rc != TPM_RC_SUCCESS) {
+		return mock_hashfinish_rc;
+	}
+	memset(digest, 0x11, *digestSz);
+	return TPM_RC_SUCCESS;
+}
+
+int __wrap_wolfTPM2_ReadPublicKey(WOLFTPM2_DEV *dev, WOLFTPM2_KEY *key,
+				  const TPM_HANDLE handle)
+{
+	(void)dev;
+	(void)handle;
+	mock_readpublickey_called = 1;
+	if (mock_readpublickey_rc == TPM_RC_SUCCESS) {
+		/* Real wolfTPM2_ReadPublicKey fills in the key's public
+		 * area, including its algorithm type. Mirror that here so
+		 * the type check in crypto_hal_ecdsa_sign() behaves as it
+		 * would against a real ECC key. */
+		key->pub.publicArea.type = TPM_ALG_ECC;
+	}
+	return mock_readpublickey_rc;
+}
+
+int __wrap_wolfTPM2_SignHashScheme(WOLFTPM2_DEV *dev, WOLFTPM2_KEY *key,
+				   const byte *digest, int digestSz, byte *sig,
+				   int *sigSz, TPMI_ALG_SIG_SCHEME sigAlg,
+				   TPMI_ALG_HASH hashAlg)
+{
+	(void)dev;
+	(void)key;
+	(void)digest;
+	(void)digestSz;
+	mock_signhash_called = 1;
+	/* The scheme must be explicit, not taken from the key's details. */
+	TEST_ASSERT_EQUAL(TPM_ALG_ECDSA, sigAlg);
+#if defined(ECDSA384_DA)
+	TEST_ASSERT_EQUAL(TPM_ALG_SHA384, hashAlg);
+#else
+	TEST_ASSERT_EQUAL(TPM_ALG_SHA256, hashAlg);
+#endif
+	if (mock_signhash_rc != TPM_RC_SUCCESS) {
+		return mock_signhash_rc;
+	}
+	TEST_ASSERT_TRUE(mock_signhash_sz <= *sigSz);
+	memcpy(sig, mock_sig_bytes, mock_signhash_sz);
+	*sigSz = mock_signhash_sz;
+	return TPM_RC_SUCCESS;
+}
+
+int __wrap_wolfTPM2_UnloadHandle(WOLFTPM2_DEV *dev, WOLFTPM2_HANDLE *handle)
+{
+	(void)dev;
+	(void)handle;
+	return TPM_RC_SUCCESS;
+}
+
+int __wrap_wolfTPM2_Cleanup(WOLFTPM2_DEV *dev)
+{
+	(void)dev;
+	return TPM_RC_SUCCESS;
+}
