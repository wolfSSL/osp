+{
+    # The release publishes only signatures; they sign GitHub's tag archive.
+    WOLFSSL_LINK="https://github.com/wolfSSL/wolfssl/archive/refs/tags/v$WOLFSSL_VER-stable.tar.gz"
+    WOLFSSL_SIG_LINK="https://github.com/wolfSSL/wolfssl/releases/download/v$WOLFSSL_VER-stable/wolfssl-$WOLFSSL_VER-stable.tar.gz.asc"
+    echo "Uninstall wolfSSL version : $WOLFSSL_VER"
+
+    cd "$PARENT_DIR"
+    rm -f "wolfssl-$WOLFSSL_VER-stable.tar.gz"
+    wget -O "wolfssl-$WOLFSSL_VER-stable.tar.gz" "$WOLFSSL_LINK"
+    verify_signature "wolfssl-$WOLFSSL_VER-stable.tar.gz" "$WOLFSSL_SIG_LINK" \
+        "$WOLFSSL_PUBKEY" "$WOLFSSL_GPG_FPR"
+    tar -xvzf "wolfssl-$WOLFSSL_VER-stable.tar.gz"
+    cd "wolfssl-$WOLFSSL_VER-stable"
+
+    ./autogen.sh
+    # Configure flags must match install() for `make uninstall` to remove all files.
+    ./configure --prefix="$WOLFSSL_ROOT" \
+        --enable-ecc --enable-keygen --enable-certgen --enable-certreq \
+        --enable-certext --enable-aesgcm --enable-aesccm --enable-aescfb \
+        --enable-sha --enable-sha256 --enable-sha384 --enable-tls13 \
+        --enable-harden --enable-wolftpm --enable-pkcallbacks --enable-curl \
+        C_EXTRA_FLAGS="-DWOLFSSL_PUBLIC_MP -DWC_RNG_SEED_CB -DWOLFSSL_CUSTOM_OID -DHAVE_OID_ENCODING"
+    make -j"$(nproc)"
+    $SUDO make uninstall
+    cd "$PARENT_DIR"
+    rm -rf "wolfssl-$WOLFSSL_VER-stable"
+    rm -f "wolfssl-$WOLFSSL_VER-stable.tar.gz"
+
+    $SUDO rm -f /etc/ld.so.conf.d/wolfssl.conf
+    $SUDO ldconfig
+
+    echo "Uninstall Curl version : $CURL_VER"
+    # CURL_ROOT is removed wholesale, so it must be a prefix dedicated to
+    # this curl install, never a shared system prefix.
+    case "${CURL_ROOT%/}" in
+        ""|/|/usr|/usr/local|/opt|/home|"${HOME%/}")
+            echo "ERROR: refusing to remove shared prefix CURL_ROOT='$CURL_ROOT'" >&2
+            exit 1
+            ;;
+    esac
+    if [ ! -x "$CURL_ROOT/bin/curl" ]; then
+        echo "ERROR: no curl install found at CURL_ROOT='$CURL_ROOT'" >&2
+        exit 1
+    fi
+    $SUDO rm -rf "$CURL_ROOT"
+    rm -rf "$PARENT_DIR/curl-$CURL_VER"
+    rm -f "$PARENT_DIR/curl-$CURL_VER.tar.gz"
+}
+
+install_wolftpm()
+{
+    echo "Build & Install wolfTPM version : $WOLFTPM_VER"
+    cd "$PARENT_DIR"
+    rm -rf "wolftpm"
+    git clone --depth 1 -b "$WOLFTPM_VER" https://github.com/wolfSSL/wolfTPM.git wolftpm
+    cd wolftpm
+    ./autogen.sh
+    ./configure --prefix="$WOLFTPM_ROOT" --with-wolfcrypt="$WOLFSSL_ROOT" \
+        --enable-devtpm --disable-fwtpm
+    make -j"$(nproc)"
+    $SUDO make install
+    cd "$PARENT_DIR"
+    rm -rf "wolftpm"
+}
+
+uninstall_wolftpm()
+{
+    echo "Uninstall wolfTPM version : $WOLFTPM_VER"
+    case "${WOLFTPM_ROOT%/}" in
+        ""|/|/usr|/usr/local|/opt|/home|"${HOME%/}")
+            echo "ERROR: refusing to remove shared prefix WOLFTPM_ROOT='$WOLFTPM_ROOT'" >&2
+            exit 1
+            ;;
+    esac
+    if [ ! -d "$WOLFTPM_ROOT" ]; then
+        echo "ERROR: no wolfTPM install found at WOLFTPM_ROOT='$WOLFTPM_ROOT'" >&2
+        exit 1
+    fi
+    $SUDO rm -rf "$WOLFTPM_ROOT"
+}
+
+usage()
+{
+    echo -e "Usage:
+        $0 <OPTION>\n
+        OPTION:
+            -i - Install wolfSSL + wolfSSL-linked curl (default wolfSSL: 5.9.4).
+            -t - Install wolfTPM (pinned to v4.2.0, linked against wolfSSL).
+            -u - Uninstall wolfSSL + the wolfSSL-linked curl (combine with -t to uninstall wolfTPM).
+            -v - wolfSSL Version (e.g. -v 5.9.4, default: 5.9.4).
+            -h - Help."
+}
+
+
+parse_args()
+{
+    # Modes
+    INSTALL=1
+    UNINSTALL=2
+    INSTALL_TPM=4
+    UNINSTALL_TPM=8
+
+    mode=0
+
+    while getopts "iutv:h" opt; do
+        case $opt in
+            (i) mode=$((mode | INSTALL));;
+            (u) mode=$((mode | UNINSTALL));;
+            (t) mode=$((mode | INSTALL_TPM));;
+            (v) WOLFSSL_VER=${OPTARG};;
+            (h) usage;
+                exit 0;;
+            (*) usage >&2;
+                exit 1;;
+        esac
+    done
+
+    # If -u was specified with -t, treat as UNINSTALL_TPM as well
+    if [ $((mode & UNINSTALL)) -ne 0 ] && [ $((mode & INSTALL_TPM)) -ne 0 ]; then
+        mode=$(((mode & ~INSTALL_TPM) | UNINSTALL_TPM))
+    fi
+
+    if [ $((mode & (INSTALL | UNINSTALL))) -ne 0 ]; then
+        # Validate wolfSSL release version format to prevent wget 404s.
+        if ! [[ "$WOLFSSL_VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
+            echo -e "Invalid -v version '$WOLFSSL_VER' (expected e.g. 5.9.4)!\n" >&2
+            usage >&2
+            exit 1
+        fi
+    fi
+
+    if [ "$mode" -eq 0 ]; then
+        echo -e "Invalid argument!\n" >&2
+        usage >&2
+        exit 1
+    fi
+
+    if [ $((mode & INSTALL)) -ne 0 ]; then
+        install
+    fi
+    if [ $((mode & INSTALL_TPM)) -ne 0 ]; then
+        install_wolftpm
+    fi
+    if [ $((mode & UNINSTALL)) -ne 0 ]; then
+        uninstall
+    fi
+    if [ $((mode & UNINSTALL_TPM)) -ne 0 ]; then
+        uninstall_wolftpm
+    fi
+}
+
+parse_args "$@"
