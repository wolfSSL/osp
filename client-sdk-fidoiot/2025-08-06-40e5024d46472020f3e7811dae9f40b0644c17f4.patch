+static int generateECDSA_key(int curve, ecc_key *key, WC_RNG *rng)
+{
+	int curve_id;
+
+	if (curve == 256) {
+		curve_id = ECC_SECP256R1;
+	} else if (curve == 384) {
+		curve_id = ECC_SECP384R1;
+	} else {
+		return -1;
+	}
+	if (wc_InitRng(rng) != 0) {
+		return -1;
+	}
+	if (wc_ecc_init(key) != 0) {
+		return -1;
+	}
+	return wc_ecc_make_key_ex(rng, 0, key, curve_id);
+}
+
+/* Returns 1 on success, 0/-1 on error. Produces a raw r||s signature (not
+ * DER), as crypto_hal_sig_verify() expects for this backend.
+ */
+static int sha_ECCsign(int curve, unsigned char *msg, unsigned int mlen,
+		       unsigned char *out, unsigned int *outlen, ecc_key *key,
+		       WC_RNG *rng)
+{
+	uint8_t hash[WC_SHA512_DIGEST_SIZE] = {0};
+	size_t hash_length = (curve == 256) ? SHA256_DIGEST_SIZE
+					    : SHA384_DIGEST_SIZE;
+	mp_int r, s;
+	int coord = wc_ecc_size(key);
+	int ret;
+
+	if (curve == 256) {
+		ret = wc_Sha256Hash((const byte *)msg, mlen, hash);
+	} else {
+		ret = wc_Sha384Hash((const byte *)msg, mlen, hash);
+	}
+	if (ret != 0) {
+		return 0;
+	}
+
+	mp_init(&r);
+	mp_init(&s);
+	if (wc_ecc_sign_hash_ex(hash, (word32)hash_length, rng, key, &r, &s) !=
+	    0) {
+		mp_clear(&r);
+		mp_clear(&s);
+		return 0;
+	}
+
+	/* Pad r and s to the coordinate size: mp_to_unsigned_bin() strips
+	 * leading zeros, which would misplace s and give an odd length. */
+	if (coord <= 0 || mp_to_unsigned_bin_len(&r, out, coord) != MP_OKAY ||
+	    mp_to_unsigned_bin_len(&s, out + coord, coord) != MP_OKAY) {
+		mp_clear(&r);
+		mp_clear(&s);
+		return 0;
+	}
+	*outlen = (unsigned int)(2 * coord);
+	mp_clear(&r);
+	mp_clear(&s);
+	return 1;
+}
