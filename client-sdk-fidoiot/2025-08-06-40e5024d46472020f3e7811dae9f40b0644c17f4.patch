+					   TPM_HMAC_KEY_PERSISTANT_HANDLE));
+	TEST_ASSERT_EQUAL_UINT8_ARRAY(expected, hmac, sizeof(expected));
+}
+
+void test_fdo_tpm_generate_hmac_key_null_param(void)
