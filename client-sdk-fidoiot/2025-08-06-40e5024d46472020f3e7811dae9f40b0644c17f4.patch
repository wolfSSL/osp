diff --git a/storage/linux/wolftpm_nv_storage.c b/storage/linux/wolftpm_nv_storage.c
new file mode 100644
index 0000000..eba4710
--- /dev/null
+++ b/storage/linux/wolftpm_nv_storage.c
@@ -0,0 +1,358 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/* Backend-agnostic TPM NV storage routines using wolfTPM. */
+
+#include <stddef.h>
+#include <stdint.h>
+#include "safe_lib.h"
+#include "util.h"
+#include "fdo_tpm_handles.h"
+#include "wolftpm_utils.h"
+#include <wolftpm/tpm2_wrap.h>
+
+/* Returns 1 if the NV index is already defined, 0 otherwise. */
+static int nv_exists(WOLFTPM2_DEV *dev, word32 nvIndex, TPMS_NV_PUBLIC *pub)
+{
+	TPMS_NV_PUBLIC local;
+
+	if (!pub) {
+		pub = &local;
+	}
+	XMEMSET(pub, 0, sizeof(*pub));
+	return (wolfTPM2_NVReadPublic(dev, nvIndex, pub) == TPM_RC_SUCCESS);
+}
+
+/* Set NV attributes */
+static int fdo_tpm_get_nv_attributes(word32 *nvAttributes)
+{
+	int rc = wolfTPM2_GetNvAttributesTemplate(TPM_RH_OWNER, nvAttributes);
+
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR,
+		    "wolfTPM2_GetNvAttributesTemplate failed: %d\n", rc);
+		return rc;
+	}
+	*nvAttributes |= TPMA_NV_OWNERWRITE | TPMA_NV_READ_STCLEAR |
+			 TPMA_NV_WRITE_STCLEAR | TPMA_NV_WRITEDEFINE;
+	return TPM_RC_SUCCESS;
+}
+
+int fdo_tpm_nvdefine(uint32_t nv, size_t data_size)
+{
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_HANDLE parent;
+	WOLFTPM2_NV nvObj;
+	word32 nvAttributes;
+
+	if (!nv) {
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	if (nv_exists(&dev, (word32)nv, NULL)) {
+		/* Already provisioned. */
+		wolfTPM2_Cleanup(&dev);
+		return 0;
+	}
+
+	rc = fdo_tpm_get_nv_attributes(&nvAttributes);
+	if (rc != TPM_RC_SUCCESS) {
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	XMEMSET(&parent, 0, sizeof(parent));
+	parent.hndl = TPM_RH_OWNER;
+	XMEMSET(&nvObj, 0, sizeof(nvObj));
+
+	rc = wolfTPM2_NVCreateAuth(&dev, &parent, &nvObj, (word32)nv,
+				   nvAttributes, (word32)data_size, NULL, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_NVCreateAuth failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+}
+
+int fdo_tpm_nvwrite(const uint8_t *data, size_t data_size, uint32_t nv)
+{
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_HANDLE parent;
+	WOLFTPM2_NV nvObj;
+	word32 nvAttributes;
+	TPMS_NV_PUBLIC nvPublic;
+	int exists;
+
+	if (!data || !nv || data_size == 0) {
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	XMEMSET(&parent, 0, sizeof(parent));
+	parent.hndl = TPM_RH_OWNER;
+	XMEMSET(&nvObj, 0, sizeof(nvObj));
+
+	exists = nv_exists(&dev, (word32)nv, &nvPublic);
+
+	/* Avoid delete/recreate to save NV endurance if index matches size and unlocked. */
+	if (exists && (size_t)nvPublic.dataSize == data_size &&
+	    !(nvPublic.attributes & TPMA_NV_WRITELOCKED)) {
+		rc = wolfTPM2_NVOpen(&dev, &nvObj, (word32)nv, NULL, 0);
+		if (rc != TPM_RC_SUCCESS) {
+			LOG(LOG_ERROR, "wolfTPM2_NVOpen failed: %d\n", rc);
+			wolfTPM2_Cleanup(&dev);
+			return -1;
+		}
+	} else {
+		if (exists) {
+			rc = wolfTPM2_NVDeleteAuth(&dev, &parent, (word32)nv);
+			if (rc != TPM_RC_SUCCESS) {
+				LOG(LOG_ERROR,
+				    "wolfTPM2_NVDeleteAuth failed: %d\n", rc);
+				wolfTPM2_Cleanup(&dev);
+				return -1;
+			}
+		}
+
+		rc = fdo_tpm_get_nv_attributes(&nvAttributes);
+		if (rc != TPM_RC_SUCCESS) {
+			wolfTPM2_Cleanup(&dev);
+			return -1;
+		}
+
+		rc = wolfTPM2_NVCreateAuth(&dev, &parent, &nvObj, (word32)nv,
+					   nvAttributes, (word32)data_size,
+					   NULL, 0);
+		if (rc != TPM_RC_SUCCESS) {
+			LOG(LOG_ERROR, "wolfTPM2_NVCreateAuth failed: %d\n",
+			    rc);
+			wolfTPM2_Cleanup(&dev);
+			return -1;
+		}
+	}
+
+	rc = wolfTPM2_NVWriteAuth(&dev, &nvObj, (word32)nv, (byte *)data,
+				  (word32)data_size, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_NVWriteAuth failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+}
+
+int fdo_tpm_nvwrite_lock(uint32_t nv)
+{
+#if defined(LOCK_TPM)
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_NV nvObj;
+
+	if (!nv) {
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	XMEMSET(&nvObj, 0, sizeof(nvObj));
+	rc = wolfTPM2_NVOpen(&dev, &nvObj, (word32)nv, NULL, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_NVOpen failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	rc = wolfTPM2_NVWriteLock(&dev, &nvObj);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_NVWriteLock failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+#else
+	(void)nv;
+	return 0;
+#endif
+}
+
+size_t fdo_tpm_nvread_size(uint32_t nv)
+{
+	int rc;
+	WOLFTPM2_DEV dev;
+	TPMS_NV_PUBLIC nvPublic;
+	size_t ret = 0;
+
+	if (!nv) {
+		return 0;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return 0;
+	}
+
+	if (nv_exists(&dev, (word32)nv, &nvPublic)) {
+		ret = (size_t)nvPublic.dataSize;
+	}
+
+	wolfTPM2_Cleanup(&dev);
+	return ret;
+}
+
+int fdo_tpm_nvread(uint32_t nv, size_t data_size, uint8_t **data)
+{
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_NV nvObj;
+	word32 readSz;
+
+	if (!nv || !data || !*data || data_size == 0) {
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	XMEMSET(&nvObj, 0, sizeof(nvObj));
+	if (data_size > UINT32_MAX) {
+		LOG(LOG_ERROR, "data_size exceeds UINT32_MAX\n");
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+	readSz = (word32)data_size;
+
+	/* nvObj is zeroed (name not loaded), so NVReadAuth opens nv itself. */
+	rc = wolfTPM2_NVReadAuth(&dev, &nvObj, (word32)nv, *data, &readSz, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_NVReadAuth failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	if ((size_t)readSz != data_size) {
+		LOG(LOG_ERROR, "Incorrect NV data length read\n");
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+}
+
+int fdo_tpm_nvread_lock(uint32_t nv)
+{
+#if defined(LOCK_TPM)
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_NV nvObj;
+	NV_ReadLock_In in;
+
+	if (!nv) {
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	XMEMSET(&nvObj, 0, sizeof(nvObj));
+	rc = wolfTPM2_NVOpen(&dev, &nvObj, (word32)nv, NULL, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_NVOpen failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	if (wolfTPM2_SetAuthHandleName(&dev, 0, &nvObj.handle) != 0 ||
+	    wolfTPM2_SetAuthHandleName(&dev, 1, &nvObj.handle) != 0) {
+		LOG(LOG_ERROR, "Setting NV index name failed\n");
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	XMEMSET(&in, 0, sizeof(in));
+	in.authHandle = nvObj.handle.hndl;
+	in.nvIndex = (word32)nv;
+
+	rc = TPM2_NV_ReadLock(&in);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "TPM2_NV_ReadLock failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+#else
+	(void)nv;
+	return 0;
+#endif
+}
+
+int fdo_tpm_nvdel(uint32_t nv)
+{
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_HANDLE parent;
+
+	if (!nv) {
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	if (!nv_exists(&dev, (word32)nv, NULL)) {
+		/* Nothing to delete. */
+		wolfTPM2_Cleanup(&dev);
+		return 0;
+	}
+
+	XMEMSET(&parent, 0, sizeof(parent));
+	parent.hndl = TPM_RH_OWNER;
+
+	rc = wolfTPM2_NVDeleteAuth(&dev, &parent, (word32)nv);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_NVDeleteAuth failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+}
