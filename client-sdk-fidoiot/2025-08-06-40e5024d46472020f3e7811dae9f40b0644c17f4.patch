+# Shared auto-discovery helper. Returns first valid path.
+macro(find_root_dir out_var error_msg)
+  set(_found FALSE)
+  foreach(_entry ${ARGN})
+    if (NOT _found)
+      string(REPLACE "|" ";" _pair "${_entry}")
+      list(GET _pair 0 _check)
+      list(GET _pair 1 _root)
+      if (EXISTS "${_check}")
+        set(ENV{${out_var}} "${_root}")
+        set(_found TRUE)
+      endif()
+    endif()
+  endforeach()
+  if (NOT _found)
+    message(FATAL_ERROR "${error_msg}")
+  endif()
+endmacro()
 
