+
+#ifndef TARGET_OS_FREERTOS
+void test_crypto_support_inc_rollover_ctr_carry(void)
+#else
+TEST_CASE("crypto_support_inc_rollover_ctr_carry", "[crypto_support][fdo]")
+#endif
+{
+	uint8_t first_iv[16] = {0};
+	uint8_t new_iv[16] = {0};
+	int ret;
+
+	/* Least-significant byte is already at its max; incrementing must
+	 * ripple the carry into the next byte instead of wrapping silently.
+	 */
+	new_iv[15] = 0xFF;
+
+	ret = inc_rollover_ctr(first_iv, new_iv, sizeof(new_iv), 1);
+	TEST_ASSERT_EQUAL(0, ret);
+	TEST_ASSERT_EQUAL_UINT8(0, new_iv[15]);
+	TEST_ASSERT_EQUAL_UINT8(1, new_iv[14]);
+}
+
+#ifndef TARGET_OS_FREERTOS
+void test_crypto_support_inc_rollover_ctr_overflow(void)
+#else
+TEST_CASE("crypto_support_inc_rollover_ctr_overflow", "[crypto_support][fdo]")
+#endif
+{
+	uint8_t first_iv[16] = {0};
+	uint8_t new_iv[16];
+	int ret;
+
+	/* IV is already all-0xFF; any increment must overflow past the top
+	 * of the buffer and fail rather than silently wrap to all-zero.
+	 */
+	for (int i = 0; i < 16; i++) {
+		new_iv[i] = 0xFF;
+	}
+
+	ret = inc_rollover_ctr(first_iv, new_iv, sizeof(new_iv), 1);
+	TEST_ASSERT_EQUAL(-1, ret);
+}
+
+#ifndef TARGET_OS_FREERTOS
+void test_crypto_support_inc_rollover_ctr_rollover_rejected(void)
+#else
+TEST_CASE("crypto_support_inc_rollover_ctr_rollover_rejected",
+	  "[crypto_support][fdo]")
+#endif
+{
+	uint8_t first_iv[16] = {0};
+	uint8_t new_iv[16] = {0};
+	int ret;
+
+	/* first_iv's value is 1; new_iv is one below it (0), so incrementing
+	 * by 1 lands exactly back on first_iv - the unsupported roll-over
+	 * case - without overflowing the buffer.
+	 */
+	first_iv[15] = 1;
+
+	ret = inc_rollover_ctr(first_iv, new_iv, sizeof(new_iv), 1);
+	TEST_ASSERT_EQUAL(-1, ret);
+}
+
+#ifndef TARGET_OS_FREERTOS
+void test_crypto_support_inc_rollover_ctr_invalid_params(void)
+#else
+TEST_CASE("crypto_support_inc_rollover_ctr_invalid_params",
+	  "[crypto_support][fdo]")
+#endif
+{
+	uint8_t first_iv[16] = {0};
+	uint8_t new_iv[16] = {0};
+	int ret;
+
+	ret = inc_rollover_ctr(NULL, new_iv, sizeof(new_iv), 1);
+	TEST_ASSERT_EQUAL(-1, ret);
+
+	ret = inc_rollover_ctr(first_iv, NULL, sizeof(new_iv), 1);
+	TEST_ASSERT_EQUAL(-1, ret);
+
+	ret = inc_rollover_ctr(first_iv, new_iv, 0, 1);
+	TEST_ASSERT_EQUAL(-1, ret);
+}
+
+#ifndef TARGET_OS_FREERTOS
+void test_crypto_support_inc_rollover_ctr_rollover_rejected_inc2(void)
+#else
+TEST_CASE("crypto_support_inc_rollover_ctr_rollover_rejected_inc2",
+	  "[crypto_support][fdo]")
+#endif
+{
+	uint8_t first_iv[16] = {0};
+	uint8_t new_iv[16] = {0};
+	int ret;
+
+	if (sizeof(size_t) > 4) {
+		first_iv[15] = 1;
+
+		ret = inc_rollover_ctr(first_iv, new_iv, sizeof(new_iv), (size_t)0x100000000ULL);
+		TEST_ASSERT_EQUAL(-1, ret);
+	}
+}
