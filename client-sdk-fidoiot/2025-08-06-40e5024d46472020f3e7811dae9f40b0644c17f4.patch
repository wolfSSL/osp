+++ b/utils/meta-intel-sdo/dynamic-layers/wolfssl/recipes-support/curl/curl_%.bbappend
@@ -0,0 +1,18 @@
+# Opt-in: set CLIENTSDK_WOLFSSL_CURL = "1" in local.conf to build the target
+# curl against wolfSSL instead of OpenSSL, so clientsdk-wolfssl runs with no
+# OpenSSL dependency. This changes curl for every package in the image, so it
+# is off by default. Native/nativesdk curl (build tools) keep using OpenSSL.
+#
+# wolfSSL must be built with --enable-curl, which this layer's
+# wolfssl_%.bbappend already does.
+
+CLIENTSDK_WOLFSSL_CURL ??= "0"
+
+PACKAGECONFIG[wolfssl] = "--with-wolfssl=${STAGING_DIR_TARGET}${prefix},--without-wolfssl,wolfssl"
+
+PACKAGECONFIG:remove:class-target = "${@'openssl' if d.getVar('CLIENTSDK_WOLFSSL_CURL') == '1' else ''}"
+PACKAGECONFIG:append:class-target = "${@' wolfssl' if d.getVar('CLIENTSDK_WOLFSSL_CURL') == '1' else ''}"
+
+# The base recipe adds --without-ssl when none of gnutls/mbedtls/openssl is
+# selected, which curl rejects alongside --with-wolfssl.
+EXTRA_OECONF:remove:class-target = "${@'--without-ssl' if d.getVar('CLIENTSDK_WOLFSSL_CURL') == '1' else ''}"
