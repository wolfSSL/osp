diff --git a/utils/install_tpm_libs.sh b/utils/install_tpm_libs.sh
index 7f41967..1808173 100755
--- a/utils/install_tpm_libs.sh
+++ b/utils/install_tpm_libs.sh
@@ -1,3 +1,6 @@
+# NOTE: tpm2 tools link against OpenSSL for internal crypto (unrelated to FDO
+# SDK TLS backend). OpenSSL dependency is required for tpm2-tss. Only
+# tpm2-openssl is skippable for wolfSSL users (via -s flag).
 export OPENSSL3_INCLUDE=/opt/openssl/include
 export CURL_INCLUDE=/opt/curl/include
 export OPENSSL3_LIB=/opt/openssl/lib64
@@ -173,7 +176,12 @@ install()
     install_tpm2tss
     install_tpm2abrmd
     install_tpm2tools
-    install_tpm2openssl
+    if [ "$SKIP_TPM2OPENSSL" != "1" ]; then
+        install_tpm2openssl
+    else
+        echo "Skipping tpm2-openssl (-s). NOTE: tpm_make_ready_ecdsa.sh needs it to" \
+             "generate the device CSR; provision on a machine that has it installed."
+    fi
 }
 
 uninstall()
@@ -182,7 +190,9 @@ uninstall()
     uninstall_tpm2tss
     uninstall_tpm2abrmd
     uninstall_tpm2tools
-    uninstall_tpm2openssl
+    if [ "$SKIP_TPM2OPENSSL" != "1" ]; then
+        uninstall_tpm2openssl
+    fi
     cd $PARENT_DIR
     rm -rf tpm2*
 }
@@ -196,6 +206,10 @@ usage()
             -u - Uninstall all tpm2 libraries.
             -t - Install only tpm2-tss library.
             -d - Uninstall only tpm2-tss library.
+            -s - Skip tpm2-openssl (OpenSSL provider plugin). Only safe on
+                 runtime-only devices: tpm_make_ready_ecdsa.sh still needs
+                 the tpm2 provider to generate the device CSR, on every
+                 crypto backend.
             -h - Help."
 }
 
@@ -209,13 +223,15 @@ parse_args()
     UNINSTALL_TPM2_TSS_ONLY=8
 
     mode=0
+    SKIP_TPM2OPENSSL=0
 
-    while getopts "iutdh" opt; do
+    while getopts "iutdsh" opt; do
         case $opt in
             (i) mode=$(($mode | $INSTALL_ALL));;
             (u) mode=$(($mode | $UNINSTALL_ALL));;
             (t) mode=$(($mode | $INSTALL_TPM2_TSS_ONLY));;
-            (d) mode=$(($mode | $UNINSTALL_TPM2_TSS_ONLY_SHIFT));;
+            (d) mode=$(($mode | $UNINSTALL_TPM2_TSS_ONLY));;
+            (s) SKIP_TPM2OPENSSL=1;;
             (h | *) usage;
                     exit;;
         esac
