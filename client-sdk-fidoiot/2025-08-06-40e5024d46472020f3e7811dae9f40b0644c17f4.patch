diff --git a/tests/unit/run_unit_test.cmake b/tests/unit/run_unit_test.cmake
new file mode 100644
index 0000000..4858df9
--- /dev/null
+++ b/tests/unit/run_unit_test.cmake
@@ -0,0 +1,52 @@
+#
+# Copyright 2026 wolfSSL Inc.
+# SPDX-License-Identifier: Apache-2.0
+#
+# Runs a single unit-test binary as a build step.
+#
+# This exists instead of a plain shell redirect in add_custom_command because
+# that command uses VERBATIM, which escapes shell metacharacters -- ">>" and
+# "||" would be handed to the test binary as argv rather than interpreted,
+# leaving report.log empty and the failure count silently zero.
+#
+# A non-zero exit status is Unity's failure count and is deliberately *not*
+# fatal here: every test must still get a chance to run so that report.log is
+# complete. The aggregate is enforced by the caller (build.sh and
+# .github/build_wolfssl_ci.sh) from the parsed report. Abnormal termination is
+# fatal, though, because a crashed binary writes no Unity summary and would
+# otherwise leave nothing for the parser to count. So is a binary that exits
+# (e.g. via exit()) without printing Unity's summary line, for the same reason.
+
+if(NOT DEFINED TEST_EXE OR NOT DEFINED REPORT_LOG)
+  message(FATAL_ERROR "run_unit_test.cmake requires -DTEST_EXE and -DREPORT_LOG")
+endif()
+
+execute_process(
+  COMMAND "${TEST_EXE}"
+  OUTPUT_VARIABLE test_stdout
+  ERROR_VARIABLE test_stderr
+  RESULT_VARIABLE test_result
+  )
+
+file(APPEND "${REPORT_LOG}" "${test_stdout}${test_stderr}")
+
+message("${test_stdout}")
+if(NOT "${test_stderr}" STREQUAL "")
+  message("${test_stderr}")
+endif()
+
+if(NOT "${test_result}" MATCHES "^[0-9]+$")
+  message(FATAL_ERROR
+    "${TEST_EXE} terminated abnormally (${test_result}); no Unity summary was "
+    "written, so its failures cannot be counted.")
+endif()
+
+if(NOT "${test_stdout}" MATCHES "[0-9]+ Tests [0-9]+ Failures [0-9]+ Ignored")
+  message(FATAL_ERROR
+    "${TEST_EXE} exited (status ${test_result}) without a Unity summary, so its "
+    "failures cannot be counted.")
+endif()
+
+if(NOT "${test_result}" STREQUAL "0")
+  message("${TEST_EXE}: ${test_result} failing test(s); see ${REPORT_LOG}")
+endif()
