+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Accessor for the process-lifetime wolfCrypt RNG owned by
+ * wolfssl_cryptoSupport.c, so short-lived operations (e.g. a single ECDSA
+ * sign) don't pay for their own wc_InitRng()/wc_FreeRng() pair - each of
+ * which reseeds from the OS entropy source - on every call.
+ */
+
+#ifndef WOLFSSL_RNG_UTIL_H
+#define WOLFSSL_RNG_UTIL_H
+
+#include <wolfssl/wolfcrypt/random.h>
+
+/**
+ * @return the shared RNG initialized by random_init(), or NULL if
+ *         random_init() hasn't been called (or random_close() already ran).
+ *         Callers must not wc_FreeRng() the returned pointer - it is owned
+ *         by wolfssl_cryptoSupport.c for the life of the process.
+ */
+WC_RNG *wolfssl_shared_rng(void);
+
+#endif /* WOLFSSL_RNG_UTIL_H */
