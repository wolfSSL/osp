+
+/* The HMAC key must be generated by the TPM, never on the host. */
+void test_fdo_tpm_generate_hmac_key_originates_in_tpm(void)
+{
+	TEST_ASSERT_EQUAL(0,
+			  fdo_tpm_generate_hmac_key(TPM_HMAC_KEY_PERSISTANT_HANDLE));
+	TEST_ASSERT_TRUE(mock_createandloadkey_origin_ok);
+}
+
+/* Test delete-before-store of existing key. */
+void test_fdo_tpm_generate_hmac_key_deletes_existing(void)
+{
