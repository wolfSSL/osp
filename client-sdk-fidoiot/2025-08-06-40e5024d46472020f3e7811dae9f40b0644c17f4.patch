diff --git a/.github/build_wolfssl_ci.sh b/.github/build_wolfssl_ci.sh
new file mode 100755
index 0000000..e9fc7dd
--- /dev/null
+++ b/.github/build_wolfssl_ci.sh
@@ -0,0 +1,42 @@
+#!/bin/bash -x
+#
+# Copyright 2026 wolfSSL Inc.
+# SPDX-License-Identifier: Apache-2.0
+#
+#
+# Run wolfSSL backend unit tests in CI docker.
+set -e -x -o pipefail
+
+export CURL_ROOT=/opt/curl
+export WOLFSSL_ROOT=/opt/wolfssl
+export WOLFTPM_ROOT=/opt/wolftpm
+
+# Keep output out of build/ to avoid wipe by pristine.
+TEST_OUTPUT="unit-test-output.txt"
+rm -f "$TEST_OUTPUT"
+COMMON_TEST_CONFIG="-Dunit-test=true -DTLS=wolfssl -DHTTPPROXY=true -DBUILD=release"
+
+# Run unit tests
+function run_unit_test
+{
+	make pristine || true
+	cmake ${COMMON_TEST_CONFIG} "$@" .
+	make -j"$(nproc)" | tee -a "$TEST_OUTPUT"
+}
+
+run_unit_test -DDA=ecdsa256 -DAES_MODE=gcm
+run_unit_test -DDA=ecdsa256 -DAES_MODE=ccm
+run_unit_test -DDA=ecdsa384 -DAES_MODE=gcm
+run_unit_test -DDA=ecdsa384 -DAES_MODE=ccm
+run_unit_test -DDA=ecdsa256 -DAES_MODE=gcm -DDA_FILE=pem
+# No TPM in the container: run only the wolfTPM tests, which mock the TPM.
+# The other tests built for a TPM DA sign and HMAC through a real device.
+run_unit_test -DDA=tpm20_ecdsa256 -DAES_MODE=gcm -DUNIT_TEST_ONLY=^test_wolftpm_
+run_unit_test -DDA=tpm20_ecdsa384 -DAES_MODE=gcm -DUNIT_TEST_ONLY=^test_wolftpm_
+
+# DO NOT change AWK string; spaces are intentional.
+fail_count=$(awk '/Tests Failed  :/ {split($0,a,": "); count+=a[2]} END{print count+0}' "$TEST_OUTPUT")
+echo "Found $fail_count unit-test failure(s)."
+
+# Raw counts wrap modulo 256 as exit codes.
+exit $(( fail_count > 0 ? 1 : 0 ))
