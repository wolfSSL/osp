+ */
+
+/*!
+ * \file
+ * \brief Unit tests for ECDH routines.
+ */
+
+#include "unity.h"
+#include "test_crypto.h"
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "safe_lib.h"
+
+#ifdef TARGET_OS_LINUX
+/*** Unity Declarations ***/
+void set_up(void);
+void tear_down(void);
+void test_ecdh_key_exchange_round_trip(void);
+void test_ecdh_short_peer_coordinate(void);
+void test_ecdh_invalid_args(void);
