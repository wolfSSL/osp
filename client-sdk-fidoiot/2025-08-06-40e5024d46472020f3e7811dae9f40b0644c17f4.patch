+void test_crypto_hal_ecdsa_sign_null_params(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[BUFF_SIZE_64_BYTES] = {0};
+	size_t sig_len = sizeof(sig);
+
+	TEST_ASSERT_EQUAL(-1, crypto_hal_ecdsa_sign(NULL, sizeof(data), sig,
+						    &sig_len));
+	TEST_ASSERT_EQUAL(-1, crypto_hal_ecdsa_sign(data, 0, sig, &sig_len));
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), NULL, &sig_len));
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, NULL));
+	TEST_ASSERT_FALSE(mock_hashstart_called);
+	TEST_ASSERT_FALSE(mock_readpublickey_called);
+	TEST_ASSERT_FALSE(mock_signhash_called);
+}
+
+void test_crypto_hal_ecdsa_sign_init_failure(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[BUFF_SIZE_64_BYTES] = {0};
+	size_t sig_len = sizeof(sig);
+
+	mock_init_rc = TPM_RC_FAILURE;
+
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, &sig_len));
+	TEST_ASSERT_FALSE(mock_hashstart_called);
+	TEST_ASSERT_FALSE(mock_readpublickey_called);
+	TEST_ASSERT_FALSE(mock_signhash_called);
+}
+
+void test_crypto_hal_ecdsa_sign_hashstart_failure(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[BUFF_SIZE_64_BYTES] = {0};
+	size_t sig_len = sizeof(sig);
+
+	mock_hashstart_rc = TPM_RC_FAILURE;
+
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, &sig_len));
+	TEST_ASSERT_TRUE(mock_hashstart_called);
+	/* Key type is validated before hashing, so ReadPublicKey runs first. */
+	TEST_ASSERT_TRUE(mock_readpublickey_called);
+	TEST_ASSERT_FALSE(mock_signhash_called);
+}
+
+void test_crypto_hal_ecdsa_sign_hashfinish_failure(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[BUFF_SIZE_64_BYTES] = {0};
+	size_t sig_len = sizeof(sig);
+
+	mock_hashfinish_rc = TPM_RC_FAILURE;
+
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, &sig_len));
+	TEST_ASSERT_TRUE(mock_hashfinish_called);
+	/* Key type is validated before hashing, so ReadPublicKey runs first. */
+	TEST_ASSERT_TRUE(mock_readpublickey_called);
+	TEST_ASSERT_FALSE(mock_signhash_called);
+}
+
+void test_crypto_hal_ecdsa_sign_readpublickey_failure(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[BUFF_SIZE_64_BYTES] = {0};
+	size_t sig_len = sizeof(sig);
+
+	mock_readpublickey_rc = TPM_RC_FAILURE;
+
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, &sig_len));
+	TEST_ASSERT_TRUE(mock_readpublickey_called);
+	TEST_ASSERT_FALSE(mock_signhash_called);
+}
+
+void test_crypto_hal_ecdsa_sign_signhash_failure(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[BUFF_SIZE_64_BYTES] = {0};
+	size_t sig_len = sizeof(sig);
+
+	mock_signhash_rc = TPM_RC_FAILURE;
+
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, &sig_len));
+	TEST_ASSERT_TRUE(mock_signhash_called);
+}
+
+/* Must reject signature larger than buffer. */
+void test_crypto_hal_ecdsa_sign_buffer_too_small(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[8] = {0};
+	size_t sig_len = sizeof(sig);
+
+	mock_signhash_sz = BUFF_SIZE_64_BYTES;
+
+	TEST_ASSERT_EQUAL(-1,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, &sig_len));
+}
+
+void test_crypto_hal_ecdsa_sign_success(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	unsigned char sig[BUFF_SIZE_64_BYTES] = {0};
+	size_t sig_len = sizeof(sig);
+
+	mock_signhash_sz = BUFF_SIZE_64_BYTES;
+
+	TEST_ASSERT_EQUAL(0,
+			  crypto_hal_ecdsa_sign(data, sizeof(data), sig, &sig_len));
+	TEST_ASSERT_EQUAL(BUFF_SIZE_64_BYTES, sig_len);
+	TEST_ASSERT_EQUAL_UINT8_ARRAY(mock_sig_bytes, sig, BUFF_SIZE_64_BYTES);
+}
