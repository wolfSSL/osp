@@ -0,0 +1,29 @@
+# The upstream wolfssl recipe (meta-networking) only exposes a
+# "reproducible-build" PACKAGECONFIG fragment - none of the feature flags
+# clientsdk-wolfssl needs (cert generation/CSR, ECC, AES-GCM/CCM, etc.) are
+# available to toggle via PACKAGECONFIG, so they're added directly via
+# EXTRA_OECONF instead. Keep this in sync with utils/install_wolfssl_curl.sh,
+# which builds the equivalent wolfSSL for non-Yocto (Docker/local) builds.
+EXTRA_OECONF += " \
+    --enable-ecc \
+    --enable-keygen \
+    --enable-certgen \
+    --enable-certreq \
+    --enable-certext \
+    --enable-aesgcm \
+    --enable-aesccm \
+    --enable-aescfb \
+    --enable-sha \
+    --enable-sha256 \
+    --enable-sha384 \
+    --enable-tls13 \
+    --enable-harden \
+    --enable-wolftpm \
+    --enable-pkcallbacks \
+    --enable-curl \
+"
+
+# Without this full set, linking DA=tpm20_* (TPM_STACK=wolftpm) against this
+# wolfSSL fails with undefined references (wc_SetSeed_Cb, wc_SetCustomExtension,
+# etc.). Keep in sync with utils/install_wolfssl_curl.sh's C_EXTRA_FLAGS.
+CFLAGS += "-DWOLFSSL_PUBLIC_MP -DWC_RNG_SEED_CB -DWOLFSSL_CUSTOM_OID -DHAVE_OID_ENCODING"
