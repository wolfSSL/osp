--- /dev/null
+++ b/crypto/include/wolftpm_utils.h
@@ -0,0 +1,37 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Shared setup helper for the wolfTPM backend routines.
+ */
+
+#ifndef __WOLFTPM_UTILS_H__
+#define __WOLFTPM_UTILS_H__
+
+#include <wolftpm/tpm2_wrap.h>
+
+/* wolfTPM disables transparent resubmit-on-TPM_RC_RETRY by default. */
+#define WOLFTPM_MAX_RETRIES_ON_BUSY 3
+
+/* Finish auth setup if already initialized. */
+static inline int wolftpm_init_dev(WOLFTPM2_DEV *dev)
+{
+	int rc = wolfTPM2_Init(dev, NULL, NULL);
+
+	if (rc == TPM_RC_INITIALIZE) {
+		XMEMSET(dev->session, 0, sizeof(dev->session));
+		wolfTPM2_SetAuthPassword(dev, 0, NULL);
+		rc = TPM_RC_SUCCESS;
+	}
+	if (rc != TPM_RC_SUCCESS) {
+		return rc;
+	}
+
+	TPM2_SetCommandRetries(&dev->ctx, WOLFTPM_MAX_RETRIES_ON_BUSY);
+	return TPM_RC_SUCCESS;
+}
+
+#endif /* #ifndef __WOLFTPM_UTILS_H__ */
