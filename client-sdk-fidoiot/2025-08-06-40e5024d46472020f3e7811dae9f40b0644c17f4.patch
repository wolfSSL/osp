+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/* Unit tests for the wolfSSL raw r||s <-> DER ECDSA conversion routines. */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "unity.h"
+
+#if defined(USE_WOLFSSL)
+
+#include <wolfssl/wolfcrypt/ecc.h>
+#include <wolfssl/wolfcrypt/asn.h>
+#include <wolfssl/wolfcrypt/random.h>
+
+/*** Unity Declarations. ***/
+void set_up(void);
+void tear_down(void);
+void test_der_encode_decode_roundtrip(void);
+void test_der_encode_decode_roundtrip_p384(void);
+void test_der_decode_rejects_bad_lengths(void);
+void test_der_encode_rejects_bad_lengths(void);
+
+void set_up(void)
+{
+}
+
+void tear_down(void)
+{
+}
+
+/* Round trip sign/decode/encode/decode */
+static void der_encode_decode_roundtrip(int curve_size, size_t raw_len)
+{
+	WC_RNG rng;
+	ecc_key key;
+	uint8_t hash[48] = {0x11, 0x22, 0x33, 0x44, 0x55};
+	uint8_t der_pubkey[256] = {0};
+	word32 der_pubkey_len = 0;
+	uint8_t der_sig[128] = {0};
+	word32 der_sig_len = sizeof(der_sig);
+	uint8_t orig_r[48] = {0}, orig_s[48] = {0};
+	word32 orig_r_len = sizeof(orig_r), orig_s_len = sizeof(orig_s);
+	uint8_t raw_key[96] = {0};
+	uint8_t raw_sig[96] = {0};
+	uint8_t reencoded_der_sig[128] = {0};
+	size_t reencoded_der_sig_len = sizeof(reencoded_der_sig);
+	uint8_t decoded_r[48] = {0}, decoded_s[48] = {0};
+	word32 decoded_r_len = sizeof(decoded_r), decoded_s_len = sizeof(decoded_s);
+	int ret;
+
+	TEST_ASSERT_EQUAL(0, wc_InitRng(&rng));
+	TEST_ASSERT_EQUAL(0, wc_ecc_init(&key));
+	TEST_ASSERT_EQUAL(0, wc_ecc_make_key(&rng, curve_size, &key));
+
+	der_pubkey_len = (word32)sizeof(der_pubkey);
+	ret = wc_EccPublicKeyToDer(&key, der_pubkey, der_pubkey_len, 1);
+	TEST_ASSERT_TRUE(ret > 0);
+	der_pubkey_len = (word32)ret;
+
+	TEST_ASSERT_EQUAL(0, wc_ecc_sign_hash(hash, (word32)curve_size, der_sig,
+					      &der_sig_len, &rng, &key));
+
+	/* What wolfCrypt actually signed, for comparison after round trip. */
+	TEST_ASSERT_EQUAL(0, wc_ecc_sig_to_rs(der_sig, der_sig_len, orig_r,
+					      &orig_r_len, orig_s, &orig_s_len));
+
+	ret = crypto_hal_der_decode(raw_key, raw_sig, der_pubkey, der_pubkey_len,
+				    der_sig, der_sig_len, raw_len, raw_len);
+	TEST_ASSERT_EQUAL(0, ret);
+
+	ret = crypto_hal_der_encode(raw_sig, raw_len, reencoded_der_sig,
+				    &reencoded_der_sig_len);
+	TEST_ASSERT_EQUAL(0, ret);
+
+	TEST_ASSERT_EQUAL(0, wc_ecc_sig_to_rs(reencoded_der_sig,
+					      (word32)reencoded_der_sig_len,
+					      decoded_r, &decoded_r_len,
+					      decoded_s, &decoded_s_len));
+
+	TEST_ASSERT_EQUAL(orig_r_len, decoded_r_len);
+	TEST_ASSERT_EQUAL(orig_s_len, decoded_s_len);
+	TEST_ASSERT_EQUAL_UINT8_ARRAY(orig_r, decoded_r, orig_r_len);
+	TEST_ASSERT_EQUAL_UINT8_ARRAY(orig_s, decoded_s, orig_s_len);
+
+	wc_ecc_free(&key);
+	wc_FreeRng(&rng);
+}
+
+void test_der_encode_decode_roundtrip(void)
+{
+	der_encode_decode_roundtrip(32, BUFF_SIZE_64_BYTES);
+}
+
+/* Same round trip, but for P-384. */
+void test_der_encode_decode_roundtrip_p384(void)
+{
+	der_encode_decode_roundtrip(48, BUFF_SIZE_96_BYTES);
+}
+
+void test_der_decode_rejects_bad_lengths(void)
+{
+	uint8_t raw_key[64] = {0};
+	uint8_t raw_sig[64] = {0};
+	uint8_t dummy_pubkey[16] = {0};
+	uint8_t dummy_sig[16] = {0};
+
+	/* Neither BUFF_SIZE_64_BYTES nor BUFF_SIZE_96_BYTES. */
+	TEST_ASSERT_EQUAL(-1, crypto_hal_der_decode(
+		raw_key, raw_sig, dummy_pubkey, sizeof(dummy_pubkey),
+		dummy_sig, sizeof(dummy_sig), 48, BUFF_SIZE_64_BYTES));
+
+	TEST_ASSERT_EQUAL(-1, crypto_hal_der_decode(
+		raw_key, raw_sig, dummy_pubkey, sizeof(dummy_pubkey),
+		dummy_sig, sizeof(dummy_sig), BUFF_SIZE_64_BYTES, 48));
+
+	TEST_ASSERT_EQUAL(-1, crypto_hal_der_decode(
+		NULL, raw_sig, dummy_pubkey, sizeof(dummy_pubkey),
+		dummy_sig, sizeof(dummy_sig), BUFF_SIZE_64_BYTES,
+		BUFF_SIZE_64_BYTES));
+}
+
+void test_der_encode_rejects_bad_lengths(void)
+{
+	uint8_t raw_sig[64] = {0};
+	uint8_t message_signature[128] = {0};
+	size_t signature_length = sizeof(message_signature);
+
+	/* Neither BUFF_SIZE_64_BYTES nor BUFF_SIZE_96_BYTES. */
+	TEST_ASSERT_EQUAL(-1, crypto_hal_der_encode(raw_sig, 48,
+						    message_signature,
+						    &signature_length));
+
+	TEST_ASSERT_EQUAL(-1, crypto_hal_der_encode(NULL, sizeof(raw_sig),
+						    message_signature,
+						    &signature_length));
+}
+
+#endif /* USE_WOLFSSL */
