diff --git a/crypto/tpm/tpm20_ECDSA_sign_routines.c b/crypto/tpm/tpm20_ECDSA_sign_routines.c
new file mode 100644
index 0000000..2de0aa9
--- /dev/null
+++ b/crypto/tpm/tpm20_ECDSA_sign_routines.c
@@ -0,0 +1,162 @@
+/*
+ * Copyright 2020 Intel Corporation
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Backend-agnostic ECDSA signing routine using tpm2.0 (tpm-tss).
+ */
+
+#include "safe_lib.h"
+#include "util.h"
+#include "fdo_crypto_hal.h"
+#include "tpm20_Utils.h"
+#include "tpm2_nv_storage.h"
+
+/**
+ * Sign a message using provided ECDSA Private Keys.
+ * @param data - pointer of type uint8_t, holds the plaintext message.
+ * @param data_len - size of message, type size_t.
+ * @param message_signature - pointer of type unsigned char, which will be
+ * by filled with signature.
+ * @param signature_length - size of signature, pointer of type size_t.
+ * @return 0 if success, else -1.
+ */
+int32_t crypto_hal_ecdsa_sign(const uint8_t *data, size_t data_len,
+			      unsigned char *message_signature,
+			      size_t *signature_length)
+{
+
+	int32_t ret = -1;
+	TSS2_RC ret_val = TPM2_RC_FAILURE;
+	ESYS_CONTEXT *esys_context = NULL;
+	ESYS_TR primary_key_handle = ESYS_TR_NONE;
+	ESYS_TR auth_session_handle = ESYS_TR_NONE;
+	ESYS_TR tpm_ec_key_handle = ESYS_TR_NONE;
+	int sig_r_len = 0;
+	int sig_s_len = 0;
+	TPM2B_DIGEST *digest = NULL;
+	TPMT_TK_HASHCHECK *validation = NULL;
+	TPMT_SIGNATURE *signature = NULL;
+	TPM2B_MAX_BUFFER input_data;
+	size_t out_buf_len = 0;
+	// Set the signature scheme to ECDSA with SHA256
+	TPMT_SIG_SCHEME inScheme = {
+	    .scheme = TPM2_ALG_ECDSA,
+	    .details = {.rsapss = {.hashAlg = FDO_TPM2_ALG_SHA}}};
+
+	if (!data || !data_len || !message_signature || !signature_length ||
+	    data_len > sizeof(input_data.buffer)) {
+		LOG(LOG_ERROR, "Invalid parameters received.\n");
+		goto error;
+	}
+
+	/* Caller's actual output buffer capacity. *signature_length gets
+	 * overwritten below with the TPM-reported signature length, so it
+	 * can no longer be used as memcpy_s's destsz by that point. */
+	out_buf_len = *signature_length;
+
+	input_data.size = data_len;
+	if (memcpy_s(input_data.buffer, sizeof(input_data.buffer), (char *)data,
+		     (size_t)data_len) != 0) {
+		LOG(LOG_ERROR, "Memcpy Failed\n");
+		goto error;
+	}
+
+	if (0 != fdoTPMGenerate_primary_key_context(&esys_context,
+						    &primary_key_handle,
+						    &auth_session_handle)) {
+		LOG(LOG_ERROR,
+		    "Failed to create primary key context from TPM.\n");
+		goto error;
+	}
+
+	ret_val = Esys_TR_FromTPMPublic(
+	    esys_context, TPM_DEVICE_KEY_PERSISTANT_HANDLE, ESYS_TR_NONE,
+	    ESYS_TR_NONE, ESYS_TR_NONE, &tpm_ec_key_handle);
+
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to load EC Key Context.\n");
+		goto error;
+	}
+
+	ret_val = Esys_Hash(esys_context, ESYS_TR_NONE, ESYS_TR_NONE,
+			    ESYS_TR_NONE, &input_data, FDO_TPM2_ALG_SHA,
+			    ESYS_TR_RH_OWNER, &digest, &validation);
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to create hash.\n");
+		goto error;
+	}
+	ret_val = Esys_Sign(esys_context, tpm_ec_key_handle,
+			    auth_session_handle, ESYS_TR_NONE, ESYS_TR_NONE,
+			    digest, &inScheme, validation, &signature);
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to create Sign Key.\n");
+		goto error;
+	}
+
+	sig_r_len = signature->signature.ecdsa.signatureR.size;
+	if (sig_r_len <= 0) {
+		LOG(LOG_ERROR, "Sig r len invalid\n");
+		goto error;
+	}
+
+	sig_s_len = signature->signature.ecdsa.signatureS.size;
+	if (sig_s_len <= 0) {
+		LOG(LOG_ERROR, "Sig s len invalid\n");
+		goto error;
+	}
+
+	*signature_length = sig_r_len + sig_s_len;
+	if (*signature_length > ECDSA_SIGNATURE_MAX_LEN ||
+	    *signature_length > out_buf_len) {
+		LOG(LOG_ERROR, "Invalid signature length\n");
+		goto error;
+	}
+
+	if (memcpy_s(message_signature, out_buf_len,
+		     (char *)signature->signature.ecdsa.signatureR.buffer,
+		     (size_t)sig_r_len) != 0) {
+		LOG(LOG_ERROR, "Memcpy Failed\n");
+		goto error;
+	}
+	if (memcpy_s(message_signature + sig_r_len, out_buf_len - sig_r_len,
+		     (char *)signature->signature.ecdsa.signatureS.buffer,
+		     (size_t)sig_s_len) != 0) {
+		LOG(LOG_ERROR, "Memcpy Failed\n");
+		goto error;
+	}
+	ret = 0;
+
+error:
+	if (esys_context) {
+		if (tpm_ec_key_handle != ESYS_TR_NONE) {
+			if (Esys_TR_Close(esys_context, &tpm_ec_key_handle) !=
+			    TSS2_RC_SUCCESS) {
+				LOG(LOG_ERROR,
+				    "Failed to flush HMAC key handle.\n");
+				ret = -1;
+			} else {
+				LOG(LOG_DEBUG,
+				    "HMAC key handle flushed successfully.\n");
+				tpm_ec_key_handle = ESYS_TR_NONE;
+			}
+		}
+		if (0 != fdoTPMTSSContext_clean_up(&esys_context,
+						   &auth_session_handle,
+						   &primary_key_handle)) {
+			LOG(LOG_ERROR,
+			    "Failed to tear down all the TSS context.\n");
+			ret = -1;
+		} else {
+			LOG(LOG_DEBUG, "TSS context flushed successfully.\n");
+		}
+	}
+
+	TPM2_ZEROISE_FREE(digest);
+	TPM2_ZEROISE_FREE(validation);
+	TPM2_ZEROISE_FREE(signature);
+
+	return ret;
+}
diff --git a/crypto/tpm/tpm20_Utils.c b/crypto/tpm/tpm20_Utils.c
new file mode 100644
index 0000000..91dc105
--- /dev/null
+++ b/crypto/tpm/tpm20_Utils.c
@@ -0,0 +1,662 @@
+/*
+ * Copyright 2020 Intel Corporation
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \ brief Abstraction layer for TPM Operations using
+ * \ tpm2.0(tpm-tools & tpm-tss-engine) and openssl library.
+ */
+#include "util.h"
+#include "safe_lib.h"
+#include "tpm2_nv_storage.h"
+#include "tpm20_Utils.h"
+#include "fdo_crypto_hal.h"
+#include "storage_al.h"
+
+/**
+ * Generates HMAC using TPM
+ *
+ * @param data: pointer to the input data
+ * @param data_length: length of the input data
+ * @param hmac: output buffer to save the HMAC
+ * @param hmac_length: length of the output HMAC buffer
+ *hash length
+ * @param persistent_handle: Persistent handle of the TPM HMAC public key
+ * @return
+ *	0, on success
+ *	-1, on failure
+ */
+int32_t fdo_tpm_get_hmac(const uint8_t *data, size_t data_length, uint8_t *hmac,
+			 size_t hmac_length,
+			 TPMI_DH_PERSISTENT persistent_handle)
+{
+	int32_t ret = -1, ret_val = -1;
+	size_t hashed_length = 0;
+	ESYS_CONTEXT *esys_context = NULL;
+	ESYS_TR primary_key_handle = ESYS_TR_NONE;
+	ESYS_TR auth_session_handle = ESYS_TR_NONE;
+	ESYS_TR hmac_key_handle = ESYS_TR_NONE;
+	ESYS_TR sequence_handle = ESYS_TR_NONE;
+	TPMT_TK_HASHCHECK *validation = NULL;
+	TPM2B_DIGEST *outHMAC = NULL;
+	TPM2B_MAX_BUFFER block = {0};
+	TPM2B_AUTH null_auth = {0};
+
+	LOG(LOG_DEBUG, "HMAC generation from TPM function called.\n");
+
+	/* Validating all input parameters are passed in the function call*/
+
+	if (!data || !data_length || !persistent_handle || !hmac ||
+	    (hmac_length != PLATFORM_HMAC_SIZE)) {
+		LOG(LOG_ERROR,
+		    "Failed to generate HMAC from TPM, invalid parameter"
+		    " received.\n");
+		goto err;
+	}
+
+	LOG(LOG_DEBUG, "All required function parameters available.\n");
+
+	/*Creating TPM Primary Key Context*/
+
+	if (0 != fdoTPMGenerate_primary_key_context(&esys_context,
+						    &primary_key_handle,
+						    &auth_session_handle)) {
+		LOG(LOG_ERROR,
+		    "Failed to create primary key context from TPM.\n");
+		goto err;
+	}
+
+	LOG(LOG_DEBUG, "TPM Primary Key Context created successfully.\n");
+
+	/* Loading the TPM Primary key, HMAC public key and HMAC Private Key to
+	 * generate the HMAC Key Context */
+
+	ret_val =
+	    Esys_TR_FromTPMPublic(esys_context, persistent_handle, ESYS_TR_NONE,
+				  ESYS_TR_NONE, ESYS_TR_NONE, &hmac_key_handle);
+
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to load HMAC Key Context.\n");
+		goto err;
+	}
+
+	LOG(LOG_DEBUG, "TPM HMAC Key Context generated successfully.\n");
+
+	/* Generating HMAC for input data, blockwise*/
+
+	if (data_length <= TPM2_MAX_DIGEST_BUFFER) {
+
+		block.size = data_length;
+		ret_val = memcpy_s(block.buffer, sizeof(block.buffer), data,
+				   data_length);
+
+		if (ret_val != 0) {
+			LOG(LOG_ERROR, "Failed to create HMAC.\n");
+			goto err;
+		}
+
+		LOG(LOG_DEBUG, "Data copied from input buffer to TPM data"
+			       " structure.\n");
+
+		ret_val =
+		    Esys_HMAC(esys_context, hmac_key_handle,
+			      auth_session_handle, ESYS_TR_NONE, ESYS_TR_NONE,
+			      &block, FDO_TPM2_ALG_SHA, &outHMAC);
+
+		if (ret_val != TSS2_RC_SUCCESS) {
+			LOG(LOG_ERROR, "Failed to create HMAC.\n");
+			goto err;
+		}
+
+		LOG(LOG_DEBUG, "HMAC created successfully.\n");
+
+	} else {
+
+		ret_val = Esys_HMAC_Start(esys_context, hmac_key_handle,
+					  auth_session_handle, ESYS_TR_NONE,
+					  ESYS_TR_NONE, &null_auth,
+					  FDO_TPM2_ALG_SHA, &sequence_handle);
+
+		if (ret_val != TSS2_RC_SUCCESS) {
+			LOG(LOG_ERROR, "Failed to create HMAC.\n");
+			goto err;
+		}
+
+		LOG(LOG_DEBUG,
+		    "HMAC generation initiated for data sequence.\n");
+
+		while (hashed_length != data_length) {
+
+			if ((data_length - hashed_length) <=
+			    TPM2_MAX_DIGEST_BUFFER) {
+
+				block.size = (data_length - hashed_length);
+				ret_val =
+				    memcpy_s(block.buffer, sizeof(block.buffer),
+					     data + hashed_length,
+					     (data_length - hashed_length));
+
+				if (ret_val != 0) {
+					LOG(LOG_ERROR,
+					    "Failed to create HMAC.\n");
+					goto err;
+				}
+
+				LOG(LOG_DEBUG, "Data copied from input buffer "
+					       "sequence to TPM"
+					       " data structure.\n");
+
+				ret_val = Esys_SequenceComplete(
+				    esys_context, sequence_handle,
+				    auth_session_handle, ESYS_TR_NONE,
+				    ESYS_TR_NONE, &block, TPM2_RH_NULL,
+				    &outHMAC, &validation);
+
+				if (ret_val != TSS2_RC_SUCCESS) {
+					LOG(LOG_ERROR,
+					    "Failed to create HMAC.\n");
+					goto err;
+				}
+
+				LOG(LOG_DEBUG, "HMAC generation for data "
+					       "sequence completed"
+					       " successfully.\n");
+				/* Prevent err block from flushing consumed sequence. */
+				sequence_handle = ESYS_TR_NONE;
+				hashed_length = data_length;
+
+			} else {
+
+				block.size = TPM2_MAX_DIGEST_BUFFER;
+				ret_val =
+				    memcpy_s(block.buffer, sizeof(block.buffer),
+					     data + hashed_length,
+					     TPM2_MAX_DIGEST_BUFFER);
+
+				if (ret_val != 0) {
+					LOG(LOG_ERROR,
+					    "Failed to create HMAC.\n");
+					goto err;
+				}
+
+				LOG(LOG_DEBUG,
+				    "Data copied from input buffer sequence"
+				    " to TPM data structure.\n");
+
+				ret_val = Esys_SequenceUpdate(
+				    esys_context, sequence_handle,
+				    auth_session_handle, ESYS_TR_NONE,
+				    ESYS_TR_NONE, &block);
+
+				if (ret_val != TSS2_RC_SUCCESS) {
+					LOG(LOG_ERROR,
+					    "Failed to create HMAC.\n");
+					goto err;
+				}
+
+				LOG(LOG_DEBUG,
+				    "Sequence handle updated successfully.\n");
+
+				hashed_length =
+				    hashed_length + TPM2_MAX_DIGEST_BUFFER;
+			}
+		}
+	}
+
+	if (!outHMAC || (hmac_length != outHMAC->size)) {
+		LOG(LOG_ERROR, "Incorrect HMAC Generated\n");
+		goto err;
+	}
+
+	ret_val = memcpy_s(hmac, hmac_length, outHMAC->buffer, outHMAC->size);
+
+	if (ret_val != 0) {
+		LOG(LOG_ERROR, "Failed to copy HMAC.\n");
+		goto err;
+	}
+
+	LOG(LOG_DEBUG,
+	    "HMAC generation for data sequence completed successfully."
+	    "\n");
+
+	ret = 0;
+
+err:
+	if (esys_context) {
+		/* Flush unconsumed TRANSIENT sequence objects on error paths. */
+		if (sequence_handle != ESYS_TR_NONE) {
+			if (Esys_FlushContext(esys_context, sequence_handle) !=
+			    TSS2_RC_SUCCESS) {
+				LOG(LOG_ERROR,
+				    "Failed to flush sequence handle.\n");
+				ret = -1;
+			} else {
+				LOG(LOG_DEBUG,
+				    "Sequence handle flushed successfully.\n");
+				sequence_handle = ESYS_TR_NONE;
+			}
+		}
+		if (hmac_key_handle != ESYS_TR_NONE) {
+			if (Esys_TR_Close(esys_context, &hmac_key_handle) !=
+			    TSS2_RC_SUCCESS) {
+				LOG(LOG_ERROR,
+				    "Failed to flush HMAC key handle.\n");
+				ret = -1;
+			} else {
+				LOG(LOG_DEBUG,
+				    "HMAC key handle flushed successfully.\n");
+				hmac_key_handle = ESYS_TR_NONE;
+			}
+		}
+		if (0 != fdoTPMTSSContext_clean_up(&esys_context,
+						   &auth_session_handle,
+						   &primary_key_handle)) {
+			LOG(LOG_ERROR,
+			    "Failed to tear down all the TSS context.\n");
+			ret = -1;
+		} else {
+			LOG(LOG_DEBUG, "TSS context flushed successfully.\n");
+		}
+	}
+	TPM2_ZEROISE_FREE(validation);
+	TPM2_ZEROISE_FREE(outHMAC);
+
+	return ret;
+}
+
+/**
+ * Generates HMAC Key inside TPM
+ *
+ * @param persistent_handle: Persistent handle of the TPM HMAC key
+ * @return
+ *		0, on success
+ *		-1, on failure
+ */
+int32_t fdo_tpm_generate_hmac_key(TPMI_DH_PERSISTENT persistent_handle)
+{
+	int32_t ret = -1;
+	TSS2_RC ret_val = TPM2_RC_FAILURE;
+	ESYS_CONTEXT *esys_context = NULL;
+	ESYS_TR primary_key_handle = ESYS_TR_NONE;
+	ESYS_TR auth_session_handle = ESYS_TR_NONE;
+	ESYS_TR object_handle = ESYS_TR_NONE;
+	ESYS_TR pub_object_handle = ESYS_TR_NONE;
+	ESYS_TR persistentHandle = ESYS_TR_NONE;
+	TPM2B_PUBLIC *out_public = NULL;
+	TPM2B_PRIVATE *out_private = NULL;
+	TPM2B_CREATION_DATA *creation_data = NULL;
+	TPM2B_DIGEST *creation_hash = NULL;
+	TPMT_TK_CREATION *creation_ticket = NULL;
+	TPMS_CAPABILITY_DATA *capability_data = NULL;
+	TPM2B_PUBLIC in_public = in_publicHMACKey_template;
+	TPM2B_SENSITIVE_CREATE in_sensitive_primary = {0};
+	TPM2B_DATA outside_info = {0};
+	TPML_PCR_SELECTION creationPCR = {0};
+	/* Using same buffer for both public and private context,
+	   private context size > public context size */
+
+	if (!persistent_handle) {
+		LOG(LOG_ERROR, "Failed to generate HMAC Key,"
+			       "invalid parameters received.\n");
+		goto err;
+	}
+
+	if (0 != fdoTPMGenerate_primary_key_context(&esys_context,
+						    &primary_key_handle,
+						    &auth_session_handle)) {
+		LOG(LOG_ERROR,
+		    "Failed to create primary key context from TPM.\n");
+		goto err;
+	}
+
+	ret_val = Esys_Create(esys_context, primary_key_handle,
+			      auth_session_handle, ESYS_TR_NONE, ESYS_TR_NONE,
+			      &in_sensitive_primary, &in_public, &outside_info,
+			      &creationPCR, &out_private, &out_public,
+			      &creation_data, &creation_hash, &creation_ticket);
+
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to create HMAC Key.\n");
+		goto err;
+	}
+
+	ret_val = Esys_Load(esys_context, primary_key_handle,
+			    auth_session_handle, ESYS_TR_NONE, ESYS_TR_NONE,
+			    out_private, out_public, &object_handle);
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Esys_Load failed: 0x%x\n", ret_val);
+		goto err;
+	}
+
+	// Search the persistent Handle
+	ret_val = Esys_GetCapability(
+	    esys_context, ESYS_TR_NONE, ESYS_TR_NONE, ESYS_TR_NONE,
+	    TPM2_CAP_HANDLES, persistent_handle, 1, NULL, &capability_data);
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Esys_GetCapability failed!\n");
+		goto err;
+	}
+
+	int exists =
+	    (capability_data->data.handles.count > 0 &&
+	     capability_data->data.handles.handle[0] == persistent_handle);
+	if (exists == 1) {
+		ret_val = Esys_TR_FromTPMPublic(
+		    esys_context, persistent_handle, ESYS_TR_NONE, ESYS_TR_NONE,
+		    ESYS_TR_NONE, &persistentHandle);
+
+		if (ret_val != TSS2_RC_SUCCESS) {
+			LOG(LOG_ERROR, "Failed to load HMAC Key Context.\n");
+			goto err;
+		}
+
+		ret_val = Esys_EvictControl(
+		    esys_context, ESYS_TR_RH_OWNER, persistentHandle,
+		    auth_session_handle, ESYS_TR_NONE, ESYS_TR_NONE, 0,
+		    &pub_object_handle);
+		if (ret_val != TSS2_RC_SUCCESS) {
+			LOG(LOG_ERROR, "Esys_EvictControl failed: 0x%x\n",
+			    ret_val);
+			goto err;
+		}
+	}
+
+	ret_val = Esys_EvictControl(
+	    esys_context, ESYS_TR_RH_OWNER, object_handle, auth_session_handle,
+	    ESYS_TR_NONE, ESYS_TR_NONE, persistent_handle, &pub_object_handle);
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Esys_EvictControl failed: 0x%x\n", ret_val);
+		goto err;
+	}
+
+	LOG(LOG_DEBUG,
+	    "Saved HMAC private key context inside persistance memory at  "
+	    "%d.\n",
+	    persistent_handle);
+	LOG(LOG_DEBUG, "HMAC Key generated successfully!.\n");
+
+	ret = 0;
+
+err:
+	TPM2_ZEROISE_FREE(out_public);
+	TPM2_ZEROISE_FREE(out_private);
+	TPM2_ZEROISE_FREE(creation_data);
+	TPM2_ZEROISE_FREE(creation_hash);
+	TPM2_ZEROISE_FREE(creation_ticket);
+	TPM2_ZEROISE_FREE(capability_data);
+
+	if (esys_context) {
+		if (object_handle != ESYS_TR_NONE) {
+			/* Flush transient object from Esys_Load to release TPM slot. */
+			if (Esys_FlushContext(esys_context, object_handle) !=
+			    TSS2_RC_SUCCESS) {
+				LOG(LOG_ERROR,
+				    "Failed to flush object_handle.\n");
+				ret = -1;
+			} else {
+				LOG(LOG_DEBUG,
+				    "object_handle flushed successfully.\n");
+				object_handle = ESYS_TR_NONE;
+			}
+		}
+
+		if (pub_object_handle != ESYS_TR_NONE) {
+			if (Esys_TR_Close(esys_context, &pub_object_handle) !=
+			    TSS2_RC_SUCCESS) {
+				LOG(LOG_ERROR,
+				    "Failed to flush pub_object_handle.\n");
+				ret = -1;
+			} else {
+				LOG(LOG_DEBUG, "pub_object_handle flushed "
+					       "successfully.\n");
+				pub_object_handle = ESYS_TR_NONE;
+			}
+		}
+
+		if (persistentHandle != ESYS_TR_NONE) {
+			if (Esys_TR_Close(esys_context, &persistentHandle) !=
+			    TSS2_RC_SUCCESS) {
+				LOG(LOG_ERROR,
+				    "Failed to flush persistent handle.\n");
+				ret = -1;
+			} else {
+				LOG(LOG_DEBUG, "persistent handle flushed "
+					       "successfully.\n");
+				persistentHandle = ESYS_TR_NONE;
+			}
+		}
+		if (0 != fdoTPMTSSContext_clean_up(&esys_context,
+						   &auth_session_handle,
+						   &primary_key_handle)) {
+			LOG(LOG_ERROR,
+			    "Failed to tear down all the TSS context.\n");
+			ret = -1;
+		} else {
+			LOG(LOG_DEBUG, "TSS context flushed successfully.\n");
+		}
+	}
+
+	return ret;
+}
+
+/**
+ * Generate TPM Primary key Context from endorsement Hierarchy
+ *
+ * @param esys_context : output Esys Context
+ * @param primary_key_handle : output primary key handle
+ * @param auth_session_handle : output auth sesson handle for Esys API
+ * @return
+ *		0, on success
+ *		-1, on failure
+ */
+int32_t fdoTPMGenerate_primary_key_context(ESYS_CONTEXT **esys_context,
+					   ESYS_TR *primary_key_handle,
+					   ESYS_TR *auth_session_handle)
+{
+	int ret = -1;
+	TSS2_RC ret_val = TPM2_RC_FAILURE;
+	TPM2B_SENSITIVE_CREATE in_sensitive_primary = {0};
+	TPM2B_DATA outside_info = {0};
+	TPML_PCR_SELECTION creationPCR = {0};
+	TPM2B_PUBLIC *out_public = NULL;
+	TPM2B_CREATION_DATA *creation_data = NULL;
+	TPM2B_DIGEST *creation_hash = NULL;
+	TPMT_TK_CREATION *creation_ticket = NULL;
+	TPM2B_PUBLIC in_public = in_public_primary_key_template;
+
+	if (!esys_context || !primary_key_handle || !auth_session_handle) {
+		LOG(LOG_ERROR, "Invalid parameter received.\n");
+		goto err;
+	}
+
+	LOG(LOG_DEBUG, "Generate Primary key context.\n");
+
+	if (0 != fdoTPMEsys_context_init(esys_context) || (!*esys_context)) {
+		LOG(LOG_ERROR, "Failed to Create Esys Context.\n");
+		goto err;
+	}
+
+	LOG(LOG_DEBUG, "Esys Context created succesfully!!\n");
+
+	if (0 !=
+	    fdoTPMEsys_auth_session_init(*esys_context, auth_session_handle)) {
+		LOG(LOG_ERROR, "Failed to create Auth Session for Esys API.\n");
+		goto err;
+	}
+
+	ret_val = Esys_CreatePrimary(
+	    *esys_context, ESYS_TR_RH_ENDORSEMENT, *auth_session_handle,
+	    ESYS_TR_NONE, ESYS_TR_NONE, &in_sensitive_primary, &in_public,
+	    &outside_info, &creationPCR, primary_key_handle, &out_public,
+	    &creation_data, &creation_hash, &creation_ticket);
+
+	if (ret_val != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to create primary key.\n");
+		goto err;
+	}
+
+	ret = 0;
+	goto out;
+
+err:
+	if (esys_context && *esys_context) {
+		fdoTPMTSSContext_clean_up(esys_context, auth_session_handle,
+					  primary_key_handle);
+	}
+
+out:
+	TPM2_ZEROISE_FREE(out_public);
+	TPM2_ZEROISE_FREE(creation_data);
+	TPM2_ZEROISE_FREE(creation_hash);
+	TPM2_ZEROISE_FREE(creation_ticket);
+
+	return ret;
+}
+
+/**
+ * Initialize Esys context.
+ *
+ * @param esys_context : output Esys Context
+ *
+ * @return
+ *		0, on success
+ *		-1, on failure
+ */
+int32_t fdoTPMEsys_context_init(ESYS_CONTEXT **esys_context)
+{
+	int ret = -1;
+	TSS2_TCTI_CONTEXT *tcti_context = NULL;
+
+	if (!esys_context) {
+		LOG(LOG_ERROR, "Invalid parameter received.\n");
+		goto err;
+	}
+
+	/* Define out-param on failure paths. */
+	*esys_context = NULL;
+
+	if ((TSS2_RC_SUCCESS !=
+	     Tss2_TctiLdr_Initialize(TPM2_TCTI_TYPE, &tcti_context)) ||
+	    (!tcti_context)) {
+		LOG(LOG_ERROR, "TCTI Context initialization failed.\n");
+		goto err;
+	}
+
+	LOG(LOG_DEBUG, "TCTI Initialized succesfully!!\n");
+
+	if (Esys_Initialize(esys_context, tcti_context, NULL) !=
+	    TPM2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to intitialize Esys context.\n");
+		goto err;
+	}
+
+	return 0;
+
+err:
+	if (tcti_context) {
+		Tss2_TctiLdr_Finalize(&tcti_context);
+	}
+	return ret;
+}
+
+/**
+ * Create HMAC based auth session for Esys Context
+ *
+ * @param esys_context : input Esys Context
+ * @param session_handle : output authentication session Handle
+ *
+ * @return
+ *	0, on success
+ *	-1, on failure
+ */
+int32_t fdoTPMEsys_auth_session_init(ESYS_CONTEXT *esys_context,
+				     ESYS_TR *session_handle)
+{
+	int ret = -1;
+	TPMT_SYM_DEF symmetric = {0};
+	symmetric.algorithm = TPM2_ALG_NULL;
+
+	TSS2_RC rval = Esys_StartAuthSession(
+	    esys_context, ESYS_TR_NONE, ESYS_TR_NONE, ESYS_TR_NONE,
+	    ESYS_TR_NONE, ESYS_TR_NONE, NULL, TPM2_SE_HMAC, &symmetric,
+	    FDO_TPM2_ALG_SHA, session_handle);
+
+	if (rval != TSS2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to start the auth session.\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * Clear Esys, TCTI, contexts and Auth Session, Primary Key handles.
+ *
+ * @param esys_context : Esys Context to be cleared
+ * @param auth_session_handle : Auth session Handle to be flushed
+ * @param primary_handle : Primary key handle to be cleared
+ * @return
+ *	0, on success
+ *	-1, on failure
+ */
+int32_t fdoTPMTSSContext_clean_up(ESYS_CONTEXT **esys_context,
+				  ESYS_TR *auth_session_handle,
+				  ESYS_TR *primary_handle)
+{
+	int ret = -1, is_failed = 0;
+	TSS2_TCTI_CONTEXT *tcti_context = NULL;
+	TSS2_RC rc = TPM2_RC_FAILURE;
+
+	if (!esys_context || !*esys_context) {
+		LOG(LOG_ERROR, "Invalid parameter received.\n");
+		return ret;
+	}
+
+	if (auth_session_handle && (*auth_session_handle != ESYS_TR_NONE)) {
+		if (Esys_FlushContext(*esys_context, *auth_session_handle) !=
+		    TSS2_RC_SUCCESS) {
+			LOG(LOG_ERROR,
+			    "Failed to flush auth session handle.\n");
+			is_failed = 1;
+		} else {
+			LOG(LOG_DEBUG,
+			    "Auth session handle flushed successfully.\n");
+			*auth_session_handle = ESYS_TR_NONE;
+		}
+	}
+
+	if (primary_handle && (*primary_handle != ESYS_TR_NONE)) {
+		if (Esys_FlushContext(*esys_context, *primary_handle) !=
+		    TSS2_RC_SUCCESS) {
+			LOG(LOG_ERROR, "Failed to flush primary key handle.\n");
+			is_failed = 1;
+		} else {
+			LOG(LOG_DEBUG,
+			    "Primary key handle flushed successfully.\n");
+			*primary_handle = ESYS_TR_NONE;
+		}
+	}
+
+	rc = Esys_GetTcti(*esys_context, &tcti_context);
+	if (rc != TPM2_RC_SUCCESS) {
+		LOG(LOG_ERROR, "Failed to cleanup TCTI.\n");
+		is_failed = 1;
+	}
+	Esys_Finalize(esys_context);
+
+	if (tcti_context) {
+		Tss2_TctiLdr_Finalize(&tcti_context);
+		if (tcti_context) {
+			LOG(LOG_ERROR, "Failed to finalize context.\n");
+			is_failed = 1;
+		}
+	}
+
+	if (is_failed) {
+		return ret;
+	}
+
+	return 0;
+}
diff --git a/crypto/tpm/wolftpm_ECDSA_sign_routines.c b/crypto/tpm/wolftpm_ECDSA_sign_routines.c
new file mode 100644
index 0000000..7753970
--- /dev/null
+++ b/crypto/tpm/wolftpm_ECDSA_sign_routines.c
@@ -0,0 +1,147 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Backend-agnostic ECDSA signing routine using wolfTPM.
+ */
+
+#include "safe_lib.h"
+#include "util.h"
+#include "fdo_tpm_handles.h"
+#include "wolftpm_utils.h"
+
+#include <wolftpm/tpm2_wrap.h>
+
+/* No fdo_crypto_hal.h: under USE_OPENSSL it pulls in <openssl/ssl.h>, which
+ * collides with wolfTPM's OpenSSL-compat shims. Hash on the TPM instead. */
+#if defined(ECDSA256_DA)
+#define FDO_WOLFTPM_ECDSA_HASH_ALG TPM_ALG_SHA256
+#define FDO_WOLFTPM_ECDSA_HASH_SIZE 32
+#elif defined(ECDSA384_DA)
+#define FDO_WOLFTPM_ECDSA_HASH_ALG TPM_ALG_SHA384
+#define FDO_WOLFTPM_ECDSA_HASH_SIZE 48
+#else
+#error "No supported ECDSA curve defined (ECDSA256_DA or ECDSA384_DA)"
+#endif
+
+/* Prototype matches fdo_crypto_hal.h (not included, see above). */
+int32_t crypto_hal_ecdsa_sign(const uint8_t *data, size_t data_len,
+			      unsigned char *message_signature,
+			      size_t *signature_length);
+
+/* Max raw R||S size across supported curves (P-521: 2 * 66 bytes = 132),
+ * rounded up. fdo_crypto_hal.h can't be included here (see above), but its
+ * ECDSA_SIGNATURE_MAX_LEN resolves to this same BUFF_SIZE_256_BYTES from
+ * util.h, so derive from that instead of a second hardcoded literal. */
+#define FDO_WOLFTPM_ECDSA_SIG_MAX_LEN BUFF_SIZE_256_BYTES
+
+/**
+ * Sign a message using the device's ECDSA private key via wolfTPM.
+ */
+int32_t crypto_hal_ecdsa_sign(const uint8_t *data, size_t data_len,
+			      unsigned char *message_signature,
+			      size_t *signature_length)
+{
+	int32_t ret_val = -1;
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_KEY eccKey;
+	WOLFTPM2_HASH hashCtx;
+	byte hash[FDO_WOLFTPM_ECDSA_HASH_SIZE];
+	word32 hashSz = sizeof(hash);
+	byte sig_buffer[FDO_WOLFTPM_ECDSA_SIG_MAX_LEN]; /* Sized for up to ECDSA521 */
+	int sigSz = sizeof(sig_buffer);
+	int dev_inited = 0;
+	int eccKey_loaded = 0;
+	int hashCtx_started = 0;
+
+	if (!data || !data_len || !message_signature || !signature_length) {
+		LOG(LOG_ERROR, "Invalid Parameters received.\n");
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+	dev_inited = 1;
+
+	/* Load the persistent key's public info and validate its type first,
+	 * before paying for a TPM hash round trip on a key we'd reject anyway. */
+	XMEMSET(&eccKey, 0, sizeof(eccKey));
+	rc = wolfTPM2_ReadPublicKey(&dev, &eccKey, TPM_DEVICE_KEY_PERSISTANT_HANDLE);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_ReadPublicKey failed: %d\n", rc);
+		goto done;
+	}
+	eccKey_loaded = 1;
+
+	if (eccKey.pub.publicArea.type != TPM_ALG_ECC) {
+		LOG(LOG_ERROR, "Persistent key handle does not hold an ECC key\n");
+		goto done;
+	}
+
+	/* wolfTPM2_SignHash signs a digest, not the raw message. */
+	XMEMSET(&hashCtx, 0, sizeof(hashCtx));
+	rc = wolfTPM2_HashStart(&dev, &hashCtx, FDO_WOLFTPM_ECDSA_HASH_ALG,
+				NULL, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_HashStart failed: %d\n", rc);
+		goto done;
+	}
+	hashCtx_started = 1;
+
+	rc = wolfTPM2_HashUpdate(&dev, &hashCtx, data, (word32)data_len);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_HashUpdate failed: %d\n", rc);
+		goto done;
+	}
+	rc = wolfTPM2_HashFinish(&dev, &hashCtx, hash, &hashSz);
+	hashCtx_started = 0; /* HashFinish unloads the sequence object either way */
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_HashFinish failed: %d\n", rc);
+		goto done;
+	}
+
+	/* FDO expects raw R||S, which wolfTPM produces for ECC keys. Pass the
+	 * scheme explicitly: for a key with a NULL scheme (as provisioned by
+	 * tpm_make_ready_ecdsa.sh), wolfTPM2_SignHash() reads the hash from the
+	 * unmarshalled-but-unset scheme details, which can hold stack garbage. */
+	rc = wolfTPM2_SignHashScheme(&dev, &eccKey, hash, sizeof(hash),
+				     sig_buffer, &sigSz, TPM_ALG_ECDSA,
+				     FDO_WOLFTPM_ECDSA_HASH_ALG);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_SignHashScheme failed: %d\n", rc);
+		goto done;
+	}
+
+	if ((size_t)sigSz > *signature_length) {
+		LOG(LOG_ERROR, "Signature buffer too small\n");
+		goto done;
+	}
+
+	/* Copy signature to output buffer */
+	if (memcpy_s(message_signature, *signature_length, sig_buffer, sigSz) != 0) {
+		LOG(LOG_ERROR, "memcpy_s failed\n");
+		goto done;
+	}
+	*signature_length = (size_t)sigSz;
+
+	ret_val = 0; /* Success */
+
+done:
+	if (hashCtx_started) {
+		wolfTPM2_UnloadHandle(&dev, &hashCtx.handle);
+	}
+	if (eccKey_loaded) {
+		wolfTPM2_UnloadHandle(&dev, &eccKey.handle);
+	}
+	if (dev_inited) {
+		wolfTPM2_Cleanup(&dev);
+	}
+	return ret_val;
+}
diff --git a/crypto/tpm/wolftpm_hmac.c b/crypto/tpm/wolftpm_hmac.c
new file mode 100644
index 0000000..786c948
--- /dev/null
+++ b/crypto/tpm/wolftpm_hmac.c
@@ -0,0 +1,196 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Backend-agnostic TPM HMAC routines using wolfTPM.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+#include "safe_lib.h"
+#include "util.h"
+#include "fdo_tpm_handles.h"
+#include "wolftpm_utils.h"
+#include <wolftpm/tpm2_wrap.h>
+
+#if defined(ECDSA256_DA)
+#define FDO_WOLFTPM_HMAC_ALG TPM_ALG_SHA256
+#elif defined(ECDSA384_DA)
+#define FDO_WOLFTPM_HMAC_ALG TPM_ALG_SHA384
+#else
+#error "No supported ECDSA curve defined (ECDSA256_DA or ECDSA384_DA)"
+#endif
+
+int32_t fdo_tpm_get_hmac(const uint8_t *data, size_t data_length, uint8_t *hmac,
+			 size_t hmac_length, uint32_t persistent_handle)
+{
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_HMAC hmacCtx;
+	word32 outSz = (word32)hmac_length;
+
+	if (!data || !data_length || !hmac || !hmac_length || !persistent_handle) {
+		LOG(LOG_ERROR, "Invalid Parameters received.\n");
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	XMEMSET(&hmacCtx, 0, sizeof(hmacCtx));
+
+	/* Load persistent HMAC key public info. */
+	rc = wolfTPM2_ReadPublicKey(&dev, &hmacCtx.key, persistent_handle);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_ReadPublicKey failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+	hmacCtx.hmacKeyLoaded = 1;
+	hmacCtx.hmacKeyKeep = 1;
+
+	rc = wolfTPM2_HmacStart(&dev, &hmacCtx, NULL, FDO_WOLFTPM_HMAC_ALG,
+				NULL, 0, NULL, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_HmacStart failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	rc = wolfTPM2_HmacUpdate(&dev, &hmacCtx, data, (word32)data_length);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_HmacUpdate failed: %d\n", rc);
+		/* Unload transient sequence object hmacCtx.hash. */
+		wolfTPM2_UnloadHandle(&dev, &hmacCtx.hash.handle);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	rc = wolfTPM2_HmacFinish(&dev, &hmacCtx, hmac, &outSz);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_HmacFinish failed: %d\n", rc);
+		wolfTPM2_UnloadHandle(&dev, &hmacCtx.hash.handle);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	if ((size_t)outSz != hmac_length) {
+		LOG(LOG_ERROR, "Incorrect HMAC length generated\n");
+		wolfTPM2_UnloadHandle(&dev, &hmacCtx.key.handle);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_UnloadHandle(&dev, &hmacCtx.key.handle);
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+}
+
+int32_t fdo_tpm_generate_hmac_key(uint32_t persistent_handle)
+{
+	int rc;
+	WOLFTPM2_DEV dev;
+	WOLFTPM2_KEY srk;
+	WOLFTPM2_KEY existingKey;
+	WOLFTPM2_KEY hmacKey;
+	TPMT_PUBLIC publicTemplate;
+
+	if (!persistent_handle) {
+		LOG(LOG_ERROR, "Invalid parameters received.\n");
+		return -1;
+	}
+
+	rc = wolftpm_init_dev(&dev);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_Init failed: %d\n", rc);
+		return -1;
+	}
+
+	XMEMSET(&srk, 0, sizeof(srk));
+	rc = wolfTPM2_CreateSRK(&dev, &srk, TPM_ALG_ECC, NULL, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_CreateSRK failed: %d\n", rc);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	/* Build the KeyedHash template ourselves (rather than
+	 * wolfTPM2_GetKeyTemplate_KeyedHash(), which is meant for importing
+	 * externally-supplied key material) so we can set
+	 * TPMA_OBJECT_sensitiveDataOrigin. That tells the TPM to generate the
+	 * HMAC key's sensitive data with its own internal RNG, so the secret
+	 * never exists in host process memory. */
+	XMEMSET(&publicTemplate, 0, sizeof(publicTemplate));
+	publicTemplate.type = TPM_ALG_KEYEDHASH;
+	/* Attributes and nameAlg match the tpm2 backend's
+	 * in_publicHMACKey_template, binding the key to this TPM and SRK. */
+	publicTemplate.nameAlg = FDO_WOLFTPM_HMAC_ALG;
+	publicTemplate.objectAttributes = (TPMA_OBJECT_fixedTPM |
+					    TPMA_OBJECT_fixedParent |
+					    TPMA_OBJECT_sensitiveDataOrigin |
+					    TPMA_OBJECT_userWithAuth |
+					    TPMA_OBJECT_noDA |
+					    TPMA_OBJECT_sign);
+	publicTemplate.parameters.keyedHashDetail.scheme.scheme =
+		TPM_ALG_HMAC;
+	publicTemplate.parameters.keyedHashDetail.scheme.details.hmac.hashAlg
+		= FDO_WOLFTPM_HMAC_ALG;
+	/* TPM2_Create ignores unique when generating; a nonzero size larger
+	 * than the TPM's largest digest is rejected with TPM_RC_SIZE. */
+	publicTemplate.unique.keyedHash.size = 0;
+
+	XMEMSET(&hmacKey, 0, sizeof(hmacKey));
+	rc = wolfTPM2_CreateAndLoadKey(&dev, &hmacKey, &srk.handle,
+					&publicTemplate, NULL, 0);
+	if (rc != TPM_RC_SUCCESS) {
+		LOG(LOG_ERROR, "wolfTPM2_CreateAndLoadKey failed: %d\n", rc);
+		wolfTPM2_UnloadHandle(&dev, &srk.handle);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	/* Free handle before storing new key, retrying to minimize empty window. */
+	XMEMSET(&existingKey, 0, sizeof(existingKey));
+	if (wolfTPM2_ReadPublicKey(&dev, &existingKey, persistent_handle) ==
+	    TPM_RC_SUCCESS) {
+		rc = wolfTPM2_NVDeleteKey(&dev, TPM_RH_OWNER, &existingKey);
+		if (rc != TPM_RC_SUCCESS) {
+			LOG(LOG_ERROR, "wolfTPM2_NVDeleteKey failed: %d\n",
+			    rc);
+			/* Old key remains on delete failure. */
+			wolfTPM2_UnloadHandle(&dev, &hmacKey.handle);
+			wolfTPM2_UnloadHandle(&dev, &srk.handle);
+			wolfTPM2_Cleanup(&dev);
+			return -1;
+		}
+	}
+
+	/* wolftpm_init_dev() already configures the transport to retry
+	 * TPM_RC_RETRY (TPM momentarily busy) up to WOLFTPM_MAX_RETRIES_ON_BUSY
+	 * times internally, so a single call here gets that retry behavior
+	 * without stacking a redundant outer retry loop on top of it. */
+	rc = wolfTPM2_NVStoreKey(&dev, TPM_RH_OWNER, &hmacKey,
+				 persistent_handle);
+	if (rc != TPM_RC_SUCCESS) {
+		/* Handle empty; manual reset required. */
+		LOG(LOG_ERROR,
+		    "wolfTPM2_NVStoreKey failed: %d; "
+		    "persistent_handle 0x%x now holds no HMAC key\n",
+		    rc, persistent_handle);
+		wolfTPM2_UnloadHandle(&dev, &hmacKey.handle);
+		wolfTPM2_UnloadHandle(&dev, &srk.handle);
+		wolfTPM2_Cleanup(&dev);
+		return -1;
+	}
+
+	wolfTPM2_UnloadHandle(&dev, &hmacKey.handle);
+	wolfTPM2_UnloadHandle(&dev, &srk.handle);
+	wolfTPM2_Cleanup(&dev);
+	return 0;
+}
diff --git a/crypto/wolfssl/BN_support.c b/crypto/wolfssl/BN_support.c
new file mode 100644
index 0000000..56249a7
--- /dev/null
+++ b/crypto/wolfssl/BN_support.c
@@ -0,0 +1,94 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+#include "BN_support.h"
+#include "fdo_crypto_hal.h"
+#include <stdlib.h>
+#include "safe_lib.h"
+#include "util.h"
+#include <wolfssl/wolfcrypt/random.h>
+#include <wolfssl/wolfcrypt/integer.h>
+#include <wolfssl/wolfcrypt/memory.h>
+
+/* Convert FDOBits to bignum_t */
+int byte_array_to_bn(bignum_t *bn, fdo_byte_array_t *in)
+{
+
+	if (in == NULL || bn == NULL) {
+		return -1;
+	}
+	if (in->byte_sz == 0 || in->bytes == NULL) {
+		return -1;
+	}
+
+	return bn_bin2bn(in->bytes, in->byte_sz, bn);
+}
+
+/* Convert FDOBits to bignum_t (Java compat). */
+fdo_byte_array_t *bn_to_byte_array(bignum_t *in)
+{
+	int len;
+	fdo_byte_array_t *ba;
+
+	if (in == NULL) {
+		return NULL;
+	}
+
+	len = bn_num_bytes(in);
+	ba = fdo_byte_array_alloc(len + 1);
+	if (ba == NULL) {
+		return NULL;
+	}
+
+	if (bn_bn2bin(in, ba->bytes) == 0) {
+		fdo_byte_array_free(ba);
+		return NULL;
+	}
+
+	/* Add zero byte if upper bit is set. */
+	if (ba->bytes[0] & 0x80) {
+		if (memmove_s(&ba->bytes[1], ba->byte_sz, ba->bytes, len) !=
+		    0) {
+			LOG(LOG_ERROR, "Memmove Failed\n");
+			fdo_byte_array_free(ba);
+			return NULL;
+		}
+		ba->bytes[0] = 0;
+	} else {
+		ba->byte_sz--;
+	}
+
+	return ba;
+}
+
+int bn_rand(bignum_t *rnd, int size)
+{
+	int bytes;
+	unsigned char *buf;
+	int ret = -1;
+
+	if (NULL == rnd) {
+		return -1;
+	}
+
+	bytes = size;
+	buf = fdo_alloc(bytes);
+	if (buf == NULL) {
+		return -1;
+	}
+
+	if (0 == crypto_hal_random_bytes(buf, bytes)) {
+		/* Force MSB so result is `size` bytes wide. */
+		if (bytes > 0) {
+			buf[0] |= 0x80;
+		}
+		if (mp_read_unsigned_bin(rnd, buf, bytes) == 0) {
+			ret = 0;
+		}
+	}
+	wc_ForceZero(buf, bytes);
+	fdo_free(buf);
+	return ret;
+}
diff --git a/crypto/wolfssl/wolfssl_AESRoutines.c b/crypto/wolfssl/wolfssl_AESRoutines.c
new file mode 100644
index 0000000..363ab00
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_AESRoutines.c
@@ -0,0 +1,159 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief AES encrypt/decrypt abstraction over wolfCrypt.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "safe_lib.h"
+#include <wolfssl/options.h>
+#include <wolfssl/wolfcrypt/aes.h>
+
+/* Validate AES-GCM/CCM params. */
+static int aes_params_valid(size_t block_size, const uint8_t *iv,
+			    const uint8_t *key, uint32_t key_length,
+			    uint8_t *tag, size_t tag_length,
+			    const uint8_t *aad, size_t aad_length)
+{
+	if (FDO_AES_BLOCK_SIZE == block_size && iv != NULL && key != NULL &&
+	    FDO_AES_KEY_LENGTH == key_length && tag != NULL &&
+	    AES_TAG_LEN == tag_length &&
+	    ((aad == NULL && aad_length == 0) || (aad != NULL && aad_length != 0))) {
+		return 0;
+	}
+	return -1;
+}
+
+/* Run AES-GCM/CCM cipher. */
+static int32_t aes_gcm_ccm_crypt(int do_encrypt, const uint8_t *in,
+				 uint32_t in_len, uint8_t *out,
+				 uint32_t *out_len, const uint8_t *iv,
+				 const uint8_t *key, uint32_t key_length,
+				 uint8_t *tag, size_t tag_length,
+				 const uint8_t *aad, size_t aad_length)
+{
+	Aes aes;
+	int ret;
+
+	if (wc_AesInit(&aes, NULL, INVALID_DEVID) != 0) {
+		LOG(LOG_ERROR, "wc_AesInit failed\n");
+		return -1;
+	}
+
+#if defined(AES_MODE_CCM_ENABLED)
+	ret = wc_AesCcmSetKey(&aes, key, key_length);
+	if (ret != 0) {
+		LOG(LOG_ERROR, "wc_AesCcmSetKey failed: %d\n", ret);
+		ret = -1;
+	} else {
+		ret = do_encrypt
+			  ? wc_AesCcmEncrypt(&aes, out, in, in_len, iv,
+					     AES_IV_LEN, tag, tag_length, aad,
+					     aad_length)
+			  : wc_AesCcmDecrypt(&aes, out, in, in_len, iv,
+					     AES_IV_LEN, tag, tag_length, aad,
+					     aad_length);
+		if (ret != 0) {
+			LOG(LOG_ERROR, "wc_AesCcm%s failed: %d\n",
+			    do_encrypt ? "Encrypt" : "Decrypt", ret);
+		}
+	}
+#else
+	ret = wc_AesGcmSetKey(&aes, key, key_length);
+	if (ret != 0) {
+		LOG(LOG_ERROR, "wc_AesGcmSetKey failed: %d\n", ret);
+		ret = -1;
+	} else {
+		ret = do_encrypt
+			  ? wc_AesGcmEncrypt(&aes, out, in, in_len, iv,
+					     AES_IV_LEN, tag, tag_length, aad,
+					     aad_length)
+			  : wc_AesGcmDecrypt(&aes, out, in, in_len, iv,
+					     AES_IV_LEN, tag, tag_length, aad,
+					     aad_length);
+		if (ret != 0) {
+			LOG(LOG_ERROR, "wc_AesGcm%s failed: %d\n",
+			    do_encrypt ? "Encrypt" : "Decrypt", ret);
+		}
+	}
+#endif
+
+	wc_AesFree(&aes);
+	memset_s(&aes, sizeof(aes), 0);
+
+	if (ret != 0) {
+		return -1;
+	}
+	*out_len = in_len;
+	return 0;
+}
+
+/* Encrypt clear_text using key. */
+int32_t crypto_hal_aes_encrypt(const uint8_t *clear_text,
+			       uint32_t clear_text_length, uint8_t *cypher_text,
+			       uint32_t *cypher_length, size_t block_size,
+			       const uint8_t *iv, const uint8_t *key,
+			       uint32_t key_length, uint8_t *tag,
+			       size_t tag_length, const uint8_t *aad,
+			       size_t aad_length)
+{
+	if (clear_text == NULL || clear_text_length == 0 ||
+	    cypher_text == NULL || cypher_length == NULL ||
+	    aes_params_valid(block_size, iv, key, key_length, tag,
+			     tag_length, aad, aad_length) != 0) {
+		LOG(LOG_ERROR, "Invalid parameters received\n");
+		return -1;
+	}
+
+	if (*cypher_length < clear_text_length) {
+		LOG(LOG_ERROR, "Output buffer is not sufficient\n");
+		return -1;
+	}
+
+	if (aes_gcm_ccm_crypt(1, clear_text, clear_text_length, cypher_text,
+			      cypher_length, iv, key, key_length, tag,
+			      tag_length, aad, aad_length) != 0) {
+		memset_s(cypher_text, *cypher_length, 0);
+		return -1;
+	}
+
+	return 0;
+}
+
+/* Decrypt cypher_text using key. */
+int32_t crypto_hal_aes_decrypt(uint8_t *clear_text, uint32_t *clear_text_length,
+			       const uint8_t *cypher_text,
+			       uint32_t cypher_length, size_t block_size,
+			       const uint8_t *iv, const uint8_t *key,
+			       uint32_t key_length, uint8_t *tag,
+			       size_t tag_length, const uint8_t *aad,
+			       size_t aad_length)
+{
+	if (clear_text == NULL || clear_text_length == NULL ||
+	    cypher_text == NULL || cypher_length == 0 ||
+	    aes_params_valid(block_size, iv, key, key_length, tag,
+			     tag_length, aad, aad_length) != 0) {
+		LOG(LOG_ERROR, "Invalid parameters received\n");
+		return -1;
+	}
+
+	if (*clear_text_length < cypher_length) {
+		LOG(LOG_ERROR, "Output buffer is not sufficient\n");
+		return -1;
+	}
+
+	if (aes_gcm_ccm_crypt(0, cypher_text, cypher_length, clear_text,
+			      clear_text_length, iv, key, key_length, tag,
+			      tag_length, aad, aad_length) != 0) {
+		memset_s(clear_text, *clear_text_length, 0);
+		*clear_text_length = 0;
+		return -1;
+	}
+
+	return 0;
+}
diff --git a/crypto/wolfssl/wolfssl_DERRoutines.c b/crypto/wolfssl/wolfssl_DERRoutines.c
new file mode 100644
index 0000000..8fceafd
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_DERRoutines.c
@@ -0,0 +1,121 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Abstraction layer for raw r||s <-> DER ECDSA signature conversion,
+ * used by the Secure Element (CRYPTO_HW=true) hardware path.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "storage_al.h"
+#include "safe_lib.h"
+#include <wolfssl/wolfcrypt/ecc.h>
+#include <wolfssl/wolfcrypt/asn.h>
+#include "wolfssl_ecdsa_util.h"
+
+/* Convert raw r||s ECDSA signature to DER. */
+int32_t crypto_hal_der_encode(uint8_t *raw_sig, size_t raw_sig_length,
+			      uint8_t *message_signature,
+			      size_t *signature_length)
+{
+	word32 sigLen;
+
+	if (raw_sig == NULL || (BUFF_SIZE_64_BYTES != raw_sig_length && BUFF_SIZE_96_BYTES != raw_sig_length) ||
+	    message_signature == NULL || signature_length == NULL) {
+		return -1;
+	}
+
+	sigLen = (word32)*signature_length;
+	if (wc_ecc_rs_raw_to_sig(raw_sig, raw_sig_length / 2,
+				 raw_sig + (raw_sig_length / 2), raw_sig_length / 2,
+				 message_signature, &sigLen) != 0) {
+		return -1;
+	}
+	*signature_length = sigLen;
+
+	return 0;
+}
+
+/* Convert DER-encoded EC pubkey and signature to raw r||s. */
+int32_t crypto_hal_der_decode(uint8_t *raw_key, uint8_t *raw_sig,
+			      const unsigned char *pub_key, size_t key_length,
+			      const uint8_t *message_signature,
+			      size_t signature_length, size_t raw_key_length,
+			      size_t raw_sig_length)
+{
+	ecc_key key;
+	int ret = -1;
+	word32 pubKeyIdx = 0;
+	word32 xLen;
+	word32 yLen;
+	word32 rLen;
+	word32 sLen;
+	/* +1 for 0x00 sign-padding byte */
+	unsigned char r[(BUFF_SIZE_96_BYTES / 2) + 1] = {0};
+	unsigned char s[(BUFF_SIZE_96_BYTES / 2) + 1] = {0};
+
+	if (raw_key == NULL || raw_sig == NULL || pub_key == NULL || key_length == 0 ||
+	    message_signature == NULL || signature_length == 0 ||
+	    (BUFF_SIZE_64_BYTES != raw_sig_length && BUFF_SIZE_96_BYTES != raw_sig_length) ||
+	    (BUFF_SIZE_64_BYTES != raw_key_length && BUFF_SIZE_96_BYTES != raw_key_length)) {
+		return -1;
+	}
+
+	xLen = (word32)(raw_key_length / 2);
+	yLen = (word32)(raw_key_length / 2);
+
+	/* Zero caller-supplied output buffers up front so every failure path
+	 * below (including ones that break before either buffer is ever
+	 * written) leaves them zeroed rather than holding stale content. */
+	memset_s(raw_key, raw_key_length, 0);
+	memset_s(raw_sig, raw_sig_length, 0);
+
+	if (wc_ecc_init(&key) != 0) {
+		return -1;
+	}
+
+	do {
+		if (wc_EccPublicKeyDecode(pub_key, &pubKeyIdx, &key,
+					  (word32)key_length) != 0) {
+			break;
+		}
+
+		if (wc_ecc_export_public_raw(&key, raw_key, &xLen,
+					     raw_key + (raw_key_length / 2), &yLen) != 0) {
+			break;
+		}
+		if (xLen != raw_key_length / 2 || yLen != raw_key_length / 2) {
+			break;
+		}
+
+		rLen = sizeof(r);
+		sLen = sizeof(s);
+		if (wc_ecc_sig_to_rs(message_signature,
+				     (word32)signature_length, r, &rLen,
+				     s, &sLen) != 0) {
+			break;
+		}
+
+		size_t half_sig = raw_sig_length / 2;
+
+		if (wolfssl_ecdsa_place_coord(raw_sig, half_sig, r, rLen) != 0) {
+			LOG(LOG_ERROR, "Invalid r length\n");
+			break;
+		}
+		if (wolfssl_ecdsa_place_coord(raw_sig + half_sig, half_sig, s, sLen) != 0) {
+			LOG(LOG_ERROR, "Invalid s length\n");
+			break;
+		}
+
+		ret = 0;
+	} while (0);
+
+	wc_ecc_free(&key);
+	memset_s(r, sizeof(r), 0);
+	memset_s(s, sizeof(s), 0);
+	return ret;
+}
diff --git a/crypto/wolfssl/wolfssl_ECDSASignRoutines.c b/crypto/wolfssl/wolfssl_ECDSASignRoutines.c
new file mode 100644
index 0000000..2653ecb
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_ECDSASignRoutines.c
@@ -0,0 +1,124 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief ECDSA signing abstraction over wolfCrypt, for the software
+ * (non-TPM, non-CSE) device-attestation path.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "safe_lib.h"
+#include <wolfssl/wolfcrypt/ecc.h>
+#include <wolfssl/wolfcrypt/random.h>
+#include <wolfssl/wolfcrypt/memory.h>
+#include "wolfssl_ecdsa_util.h"
+#include "wolfssl_rng_util.h"
+
+#if defined(ECDSA256_DA)
+#define FDO_ECDSA_SIGN_COORD_SIZE FDO_ECDSA_P256_COORD_SIZE
+#elif defined(ECDSA384_DA)
+#define FDO_ECDSA_SIGN_COORD_SIZE FDO_ECDSA_P384_COORD_SIZE
+#endif
+
+/* Sign a message using ECDSA private key. */
+int32_t crypto_hal_ecdsa_sign(const uint8_t *message, size_t message_len,
+			      unsigned char *signature, size_t *signature_len)
+{
+	unsigned char hash[FDO_SHA_DIGEST_SIZE_USED] = {0};
+	ecc_key key;
+	int ret = -1;
+	word32 sig_len;
+	unsigned char der_sig[ECDSA_SIGNATURE_MAX_LEN] = {0};
+	word32 r_len = 0, s_len = 0;
+	unsigned char r[BUFF_SIZE_64_BYTES] = {0};
+	unsigned char s[BUFF_SIZE_64_BYTES] = {0};
+	WC_RNG *rng = NULL;
+	int key_inited = 0;
+	/* Coordinate half-size for the compiled-in curve, not derived from
+	 * the hash size (see wolfssl_ecdsa_coord_size() for the verify-side
+	 * counterpart, which is the same value keyed off key_algorithm). */
+	uint32_t expected_half = FDO_ECDSA_SIGN_COORD_SIZE;
+
+	if (!message || 0 == message_len || !signature || !signature_len ||
+	    0 == *signature_len) {
+		return -1;
+	}
+
+#if !defined(ECDSA256_DA) && !defined(ECDSA384_DA)
+	LOG(LOG_ERROR, "No supported ECDSA curve defined\n");
+	return -1;
+#endif
+
+	if (wc_ecc_init(&key) != 0) {
+		LOG(LOG_ERROR, "wc_ecc_init failed\n");
+		return -1;
+	}
+	key_inited = 1;
+
+	do {
+		rng = wolfssl_shared_rng();
+		if (!rng) {
+			LOG(LOG_ERROR, "Shared RNG not initialized\n");
+			break;
+		}
+
+		if (0 != crypto_hal_hash(FDO_CRYPTO_HASH_TYPE_USED, message, message_len,
+					 hash, FDO_SHA_DIGEST_SIZE_USED)) {
+			LOG(LOG_ERROR, "crypto_hal_hash failed\n");
+			break;
+		}
+
+		if (wolfssl_ecdsa_load_privkey(&key) != 0) {
+			LOG(LOG_ERROR, "wolfssl_ecdsa_load_privkey failed\n");
+			break;
+		}
+
+		sig_len = sizeof(der_sig);
+		if (wc_ecc_sign_hash(hash, FDO_SHA_DIGEST_SIZE_USED, der_sig,
+				     &sig_len, rng, &key) != 0) {
+			LOG(LOG_ERROR, "wc_ecc_sign_hash failed\n");
+			break;
+		}
+
+		r_len = sizeof(r);
+		s_len = sizeof(s);
+		if (wc_ecc_sig_to_rs(der_sig, sig_len, r, &r_len, s, &s_len) != 0) {
+			LOG(LOG_ERROR, "wc_ecc_sig_to_rs failed\n");
+			break;
+		}
+
+		if ((expected_half * 2) > *signature_len) {
+			LOG(LOG_ERROR, "Signature buffer too small\n");
+			break;
+		}
+
+		*signature_len = expected_half * 2;
+
+		memset_s(signature, *signature_len, 0);
+
+		if (wolfssl_ecdsa_place_coord(signature, expected_half, r, r_len) != 0) {
+			LOG(LOG_ERROR, "Invalid r length\n");
+			break;
+		}
+		if (wolfssl_ecdsa_place_coord(signature + expected_half, expected_half,
+					      s, s_len) != 0) {
+			LOG(LOG_ERROR, "Invalid s length\n");
+			break;
+		}
+
+		ret = 0;
+	} while (0);
+
+	if (key_inited) {
+		wc_ecc_free(&key);
+	}
+	memset_s(hash, sizeof(hash), 0);
+	memset_s(der_sig, sizeof(der_sig), 0);
+	memset_s(r, sizeof(r), 0);
+	memset_s(s, sizeof(s), 0);
+	return ret;
+}
diff --git a/crypto/wolfssl/wolfssl_ECDSAVerifyRoutines.c b/crypto/wolfssl/wolfssl_ECDSAVerifyRoutines.c
new file mode 100644
index 0000000..d1e218e
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_ECDSAVerifyRoutines.c
@@ -0,0 +1,148 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief ECDSA signature verification abstraction over wolfCrypt, used
+ * to verify the Ownership Voucher signature chain.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "safe_lib.h"
+#include "wolfssl_ecdsa_util.h"
+#include <wolfssl/options.h>
+#include <wolfssl/wolfcrypt/asn_public.h>
+#include <wolfssl/wolfcrypt/ecc.h>
+
+/* Verify ECDSA signature using public key. */
+int32_t crypto_hal_sig_verify(uint8_t key_encoding, int key_algorithm,
+			      const uint8_t *message, uint32_t message_length,
+			      const uint8_t *message_signature,
+			      uint32_t signature_length,
+			      const uint8_t *key_param1,
+			      uint32_t key_param1Length,
+			      const uint8_t *key_param2,
+			      uint32_t key_param2Length)
+{
+	/* Validate encoding and algo. */
+	if ((key_encoding != FDO_CRYPTO_PUB_KEY_ENCODING_X509 &&
+	     key_encoding != FDO_CRYPTO_PUB_KEY_ENCODING_COSEKEY) ||
+	    (key_algorithm != FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp256 &&
+	     key_algorithm != FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp384)) {
+		LOG(LOG_ERROR, "Incorrect key type\n");
+		return -1;
+	}
+
+	if (!message_signature || 0 == signature_length ||
+	    0 != (signature_length % 2) || !message || 0 == message_length) {
+		LOG(LOG_ERROR, "Invalid arguments!\n");
+		return -1;
+	}
+
+	if (key_encoding == FDO_CRYPTO_PUB_KEY_ENCODING_X509) {
+		if (!key_param1 || 0 == key_param1Length) {
+			LOG(LOG_ERROR, "Invalid params!\n");
+			return -1;
+		}
+	} else {
+		if (!key_param1 || 0 == key_param1Length || !key_param2 ||
+		    0 == key_param2Length) {
+			LOG(LOG_ERROR, "Invalid params!\n");
+			return -1;
+		}
+	}
+
+	ecc_key key;
+	int ret = -1;
+	unsigned char hash[SHA512_DIGEST_SIZE] = {0};
+	int curve_id = 0;
+	int hash_type = 0;
+	size_t hash_len = 0;
+	int stat = 0;
+	unsigned char der_sig[ECDSA_SIGNATURE_MAX_LEN] = {0};
+	word32 der_sig_len = sizeof(der_sig);
+	int key_inited = 0;
+
+	switch (key_algorithm) {
+	case FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp256:
+		curve_id = ECC_SECP256R1;
+		hash_type = FDO_CRYPTO_HASH_TYPE_SHA_256;
+		hash_len = SHA256_DIGEST_SIZE;
+		break;
+	case FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp384:
+		curve_id = ECC_SECP384R1;
+		hash_type = FDO_CRYPTO_HASH_TYPE_SHA_384;
+		hash_len = SHA384_DIGEST_SIZE;
+		break;
+	default:
+		LOG(LOG_ERROR, "Unsupported curve\n");
+		return -1;
+	}
+
+	if (wc_ecc_init(&key) != 0) {
+		LOG(LOG_ERROR, "wc_ecc_init failed\n");
+		return -1;
+	}
+	key_inited = 1;
+
+	do {
+		if (key_encoding == FDO_CRYPTO_PUB_KEY_ENCODING_X509) {
+			word32 idx = 0;
+			if (wc_EccPublicKeyDecode(key_param1, &idx, &key, key_param1Length) != 0) {
+				LOG(LOG_ERROR, "wc_EccPublicKeyDecode failed\n");
+				break;
+			}
+			/* Enforce the declared algorithm's curve on the decoded key. */
+			if (key.dp == NULL || key.dp->id != curve_id) {
+				LOG(LOG_ERROR, "Public key curve does not match key algorithm\n");
+				break;
+			}
+		} else {
+			/* Right-align COSEKEY coordinates into fixed-width slot. */
+			size_t coord_size = wolfssl_ecdsa_coord_size(key_algorithm);
+			uint8_t qx[FDO_ECDSA_P384_COORD_SIZE] = {0};
+			uint8_t qy[FDO_ECDSA_P384_COORD_SIZE] = {0};
+
+			if (wolfssl_ecdsa_place_coord(qx, coord_size, key_param1,
+						      key_param1Length) != 0 ||
+			    wolfssl_ecdsa_place_coord(qy, coord_size, key_param2,
+						      key_param2Length) != 0) {
+				LOG(LOG_ERROR, "Failed to pad COSEKEY coordinates\n");
+				break;
+			}
+			if (wc_ecc_import_unsigned(&key, qx, qy, NULL, curve_id) != 0) {
+				LOG(LOG_ERROR, "wc_ecc_import_unsigned failed\n");
+				break;
+			}
+		}
+
+		if (0 != crypto_hal_hash(hash_type, message, message_length, hash, hash_len)) {
+			LOG(LOG_ERROR, "crypto_hal_hash failed\n");
+			break;
+		}
+
+		if (wc_ecc_rs_raw_to_sig(message_signature, signature_length / 2,
+					 message_signature + signature_length / 2, signature_length / 2,
+					 der_sig, &der_sig_len) != 0) {
+			LOG(LOG_ERROR, "wc_ecc_rs_to_sig failed\n");
+			break;
+		}
+
+		if (wc_ecc_verify_hash(der_sig, der_sig_len, hash, hash_len, &stat, &key) != 0 || stat != 1) {
+			LOG(LOG_ERROR, "wc_ecc_verify_hash failed\n");
+			break;
+		}
+
+		ret = 0;
+	} while (0);
+
+	if (key_inited) {
+		wc_ecc_free(&key);
+	}
+	memset_s(hash, sizeof(hash), 0);
+	memset_s(der_sig, sizeof(der_sig), 0);
+	return ret;
+}
diff --git a/crypto/wolfssl/wolfssl_SSLRoutines.c b/crypto/wolfssl/wolfssl_SSLRoutines.c
new file mode 100644
index 0000000..7c65492
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_SSLRoutines.c
@@ -0,0 +1,216 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief TLS connection abstraction over wolfSSL, used for the HTTPS
+ * transport to the rendezvous/owner servers.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "fdo.h"
+#include "util.h"
+#include "safe_lib.h"
+#include <wolfssl/options.h>
+#include <wolfssl/ssl.h>
+#include <wolfssl/error-ssl.h>
+
+/* Trust store for server cert validation. */
+#ifndef CA_CERT_FILE
+#define CA_CERT_FILE NULL
+#endif
+#ifndef CA_CERT_DIR
+#define CA_CERT_DIR "/etc/ssl/certs"
+#endif
+
+/* Session owns WOLFSSL_CTX. */
+typedef struct {
+	WOLFSSL_CTX *ctx;
+	WOLFSSL *ssl;
+} fdo_ssl_session_t;
+
+/* Set up wolfSSL session on connected socket. */
+void *fdo_ssl_setup(int sock)
+{
+	fdo_ssl_session_t *session = NULL;
+	WOLFSSL_METHOD *method = NULL;
+	const long flags =
+	    WOLFSSL_OP_NO_SSLv2 | WOLFSSL_OP_NO_SSLv3 | WOLFSSL_OP_NO_COMPRESSION;
+	const char *const PREFERRED_CIPHERS =
+	    "HIGH:!aNULL:!NULL:!EXT:!DSS:!kRSA:!PSK:!SRP:!MD5:!RC4";
+
+	if (sock < 0) {
+		return NULL;
+	}
+
+	session = fdo_alloc(sizeof(*session));
+	if (!session) {
+		return NULL;
+	}
+	session->ctx = NULL;
+	session->ssl = NULL;
+
+	if (wolfSSL_Init() != WOLFSSL_SUCCESS) {
+		LOG(LOG_ERROR, "wolfSSL_Init failed\n");
+		fdo_free(session);
+		return NULL;
+	}
+
+	method = wolfSSLv23_client_method();
+	if (method == NULL) {
+		goto err;
+	}
+
+	session->ctx = wolfSSL_CTX_new(method);
+	if (session->ctx == NULL) {
+		goto err;
+	}
+
+	wolfSSL_CTX_set_options(session->ctx, flags);
+	if (WOLFSSL_SUCCESS !=
+	    wolfSSL_CTX_set_cipher_list(session->ctx, PREFERRED_CIPHERS)) {
+		LOG(LOG_ERROR, "SSL cipher suite set failed\n");
+		goto err;
+	}
+
+	/* Load CA store or relax verification if self-signed. */
+#if defined(SELF_SIGNED_CERTS_SUPPORTED)
+	if (useSelfSignedCerts) {
+		wolfSSL_CTX_set_verify(session->ctx, WOLFSSL_VERIFY_NONE, NULL);
+	} else
+#endif
+	{
+		wolfSSL_CTX_set_verify(session->ctx, WOLFSSL_VERIFY_PEER, NULL);
+		if (WOLFSSL_SUCCESS !=
+		    wolfSSL_CTX_load_verify_locations(session->ctx, CA_CERT_FILE,
+						      CA_CERT_DIR)) {
+			LOG(LOG_ERROR, "Failed to load CA certificates\n");
+			goto err;
+		}
+	}
+
+	session->ssl = wolfSSL_new(session->ctx);
+	if (!session->ssl) {
+		goto err;
+	}
+
+	if (WOLFSSL_SUCCESS != wolfSSL_set_fd(session->ssl, sock)) {
+		goto err;
+	}
+
+	return (void *)session;
+err:
+	if (session->ssl) {
+		wolfSSL_free(session->ssl);
+	}
+	if (session->ctx) {
+		wolfSSL_CTX_free(session->ctx);
+	}
+	fdo_free(session);
+	wolfSSL_Cleanup();
+	return NULL;
+}
+
+/* Perform TLS handshake. */
+int fdo_ssl_connect(void *ssl)
+{
+	int ret = 0;
+	WOLFSSL *wssl = NULL;
+
+	if (!ssl) {
+		return -1;
+	}
+	wssl = ((fdo_ssl_session_t *)ssl)->ssl;
+
+	ret = wolfSSL_connect(wssl);
+	if (ret != WOLFSSL_SUCCESS) {
+		LOG(LOG_ERROR, "SSL Connection error: %d\n",
+		    wolfSSL_get_error(wssl, ret));
+		return -1;
+	}
+
+	LOG(LOG_DEBUG, "ssl connection successful\n");
+	return 0;
+}
+
+/* Tear down wolfSSL session. */
+int fdo_ssl_close(void *ssl)
+{
+	int ret = 0;
+	int result = 0;
+	fdo_ssl_session_t *session = NULL;
+
+	if (!ssl) {
+		return -1;
+	}
+	session = (fdo_ssl_session_t *)ssl;
+
+	ret = wolfSSL_shutdown(session->ssl);
+	if (ret != WOLFSSL_SUCCESS) {
+		if (ret == WOLFSSL_SHUTDOWN_NOT_DONE) {
+			/* close_notify sent but peer's not yet received; retry
+			 * once for bidirectional shutdown. */
+			ret = wolfSSL_shutdown(session->ssl);
+		}
+		/* Peer not answering close_notify is not an error here. */
+		if (ret != WOLFSSL_SUCCESS && ret != WOLFSSL_SHUTDOWN_NOT_DONE) {
+			LOG(LOG_ERROR, "SSL Connection shutdown error: %d, ret = %d\n",
+			    wolfSSL_get_error(session->ssl, ret), ret);
+			result = -1;
+		}
+	}
+
+	wolfSSL_free(session->ssl);
+	if (session->ctx) {
+		wolfSSL_CTX_free(session->ctx);
+	}
+	fdo_free(session);
+
+	wolfSSL_Cleanup();
+
+	return result;
+}
+
+/* Read up to num bytes from TLS session. */
+int fdo_ssl_read(void *ssl, void *buf, int num)
+{
+	int ret = 0;
+	WOLFSSL *wssl = NULL;
+
+	if (!ssl || !buf || num <= 0) {
+		return -1;
+	}
+	wssl = ((fdo_ssl_session_t *)ssl)->ssl;
+
+	ret = wolfSSL_read(wssl, buf, num);
+	if (ret <= 0) {
+		LOG(LOG_ERROR, "SSL Connection read error: %d\n",
+		    wolfSSL_get_error(wssl, ret));
+		return -1;
+	}
+
+	return ret;
+}
+
+/* Write num bytes to TLS session. */
+int fdo_ssl_write(void *ssl, const void *buf, int num)
+{
+	int ret = 0;
+	WOLFSSL *wssl = NULL;
+
+	if (!ssl || !buf || num <= 0) {
+		return -1;
+	}
+	wssl = ((fdo_ssl_session_t *)ssl)->ssl;
+
+	ret = wolfSSL_write(wssl, buf, num);
+	if (ret <= 0) {
+		LOG(LOG_ERROR, "SSL Connection write error: %d\n",
+		    wolfSSL_get_error(wssl, ret));
+		return -1;
+	}
+
+	return ret;
+}
diff --git a/crypto/wolfssl/wolfssl_cryptoSupport.c b/crypto/wolfssl/wolfssl_cryptoSupport.c
new file mode 100644
index 0000000..16d85ad
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_cryptoSupport.c
@@ -0,0 +1,353 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Abstraction of wolfSSL library for crypto services required by FDO
+ * library.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "safe_lib.h"
+#include "wolfssl_rng_util.h"
+
+#include <wolfssl/options.h>
+#include <wolfssl/wolfcrypt/settings.h>
+#include <wolfssl/wolfcrypt/random.h>
+#include <wolfssl/wolfcrypt/error-crypt.h>
+#include <wolfssl/wolfcrypt/hash.h>
+#include <wolfssl/wolfcrypt/hmac.h>
+
+static bool g_crypto_initialized = false;
+
+/* Initialize wolfCrypt library state. */
+int32_t crypto_init(void)
+{
+	if (g_crypto_initialized) {
+		return 0;
+	}
+
+	if (wolfCrypt_Init() != 0) {
+		LOG(LOG_ERROR, "wolfCrypt_Init failed\n");
+		return -1;
+	}
+
+	/* With SECURE_ELEMENT, random_init() comes from se_crypto_support.c. */
+	if (0 != random_init()) {
+		LOG(LOG_ERROR, "random_init failed\n");
+		wolfCrypt_Cleanup();
+		return -1;
+	}
+
+#ifdef SECURE_ELEMENT
+	if (0 != crypto_hal_se_init()) {
+		LOG(LOG_ERROR, "crypto_hal_se_init failed\n");
+		wolfCrypt_Cleanup();
+		return -1;
+	}
+#endif /* SECURE_ELEMENT */
+
+	g_crypto_initialized = true;
+
+	return 0;
+}
+
+/* Tear down wolfCrypt library state. */
+int32_t crypto_close(void)
+{
+	int32_t ret = 0;
+
+	if (!g_crypto_initialized) {
+		return -1;
+	}
+
+	/* With SECURE_ELEMENT, this also releases the SE (atcab_release). */
+	if (0 != random_close()) {
+		LOG(LOG_ERROR, "random_close failed\n");
+		ret = -1;
+	}
+
+	if (wolfCrypt_Cleanup() != 0) {
+		LOG(LOG_ERROR, "wolfCrypt_Cleanup failed\n");
+		ret = -1;
+	}
+
+	g_crypto_initialized = false;
+
+	return ret;
+}
+
+#ifndef SECURE_ELEMENT
+static bool g_random_initialized = false;
+static WC_RNG g_rng;
+
+/* Initialize randomization library. */
+int random_init(void)
+{
+	if (g_random_initialized) {
+		return 0;
+	}
+
+	if (wolfCrypt_Init() != 0) {
+		LOG(LOG_ERROR, "wolfCrypt_Init failed\n");
+		return -1;
+	}
+
+	if (memset_s(&g_rng, sizeof(g_rng), 0) != 0) {
+		LOG(LOG_ERROR, "memset_s failed\n");
+		wolfCrypt_Cleanup();
+		return -1;
+	}
+
+	if (wc_InitRng(&g_rng) != 0) {
+		LOG(LOG_ERROR, "wc_InitRng failed\n");
+		wolfCrypt_Cleanup();
+		return -1;
+	}
+
+	g_random_initialized = true;
+	return 0;
+}
+
+/* Uninitialize randomization library. */
+int random_close(void)
+{
+	int ret = 0;
+
+	if (!g_random_initialized) {
+		return -1;
+	}
+
+	if (wc_FreeRng(&g_rng) != 0) {
+		LOG(LOG_ERROR, "wc_FreeRng failed\n");
+		ret = -1;
+	}
+
+	if (wolfCrypt_Cleanup() != 0) {
+		LOG(LOG_ERROR, "wolfCrypt_Cleanup failed\n");
+		ret = -1;
+	}
+
+	g_random_initialized = false;
+
+	return ret;
+}
+
+/* Return shared RNG. */
+WC_RNG *wolfssl_shared_rng(void)
+{
+	return g_random_initialized ? &g_rng : NULL;
+}
+#endif /* SECURE_ELEMENT */
+
+#if !defined(SECURE_ELEMENT) && !defined(DEVICE_CSE_ENABLED)
+/* Generate random data. */
+int32_t crypto_hal_random_bytes(uint8_t *random_buffer, size_t num_bytes)
+{
+	if (!random_buffer || 0 == num_bytes) {
+		return -1;
+	}
+
+	if (num_bytes > (size_t)0xFFFFFFFFu) {
+		LOG(LOG_ERROR, "num_bytes exceeds word32 range\n");
+		return -1;
+	}
+
+	if (!g_random_initialized) {
+		LOG(LOG_ERROR, "RNG not initialized\n");
+		return -1;
+	}
+
+	if (wc_RNG_GenerateBlock(&g_rng, random_buffer, num_bytes) != 0) {
+		LOG(LOG_ERROR, "wc_RNG_GenerateBlock failed\n");
+		return -1;
+	}
+
+	return 0;
+}
+#endif /* DEVICE_CSE_ENABLED */
+
+#ifndef SECURE_ELEMENT
+/* Calculate hash. */
+int32_t crypto_hal_hash(int hash_type, const uint8_t *buffer,
+			size_t buffer_length, uint8_t *output,
+			size_t output_length)
+{
+	if (!output || 0 == output_length || !buffer || 0 == buffer_length) {
+		return -1;
+	}
+
+	int ret;
+
+	if (buffer_length > (size_t)0xFFFFFFFFu) {
+		LOG(LOG_ERROR, "buffer_length exceeds word32 range\n");
+		return -1;
+	}
+
+	switch (hash_type) {
+	case FDO_CRYPTO_HASH_TYPE_SHA_256:
+		if (output_length < BUFF_SIZE_32_BYTES) {
+			return -1;
+		}
+		ret = wc_Sha256Hash(buffer, buffer_length, output);
+		break;
+	case FDO_CRYPTO_HASH_TYPE_SHA_384:
+		if (output_length < BUFF_SIZE_48_BYTES) {
+			return -1;
+		}
+		ret = wc_Sha384Hash(buffer, buffer_length, output);
+		break;
+	default:
+		LOG(LOG_ERROR, "Unsupported hash type %d\n", hash_type);
+		return -1;
+	}
+
+	if (ret != 0) {
+		LOG(LOG_ERROR, "wolfCrypt hash computation failed\n");
+		return -1;
+	}
+
+	return 0;
+}
+
+/* Calculate HMAC. */
+int32_t crypto_hal_hmac(uint8_t hmac_type, const uint8_t *buffer,
+			size_t buffer_length, uint8_t *output,
+			size_t output_length, const uint8_t *key,
+			size_t key_length)
+{
+	if (!output || 0 == output_length || !buffer || 0 == buffer_length ||
+	    !key || 0 == key_length) {
+		return -1;
+	}
+
+#ifdef WOLFSSL_SMALL_STACK
+	Hmac *hmac = NULL;
+#else
+	Hmac hmac_obj;
+	Hmac *hmac = &hmac_obj;
+#endif
+	int wc_type = 0;
+	int ret;
+
+	if (buffer_length > (size_t)0xFFFFFFFFu ||
+	    key_length > (size_t)0xFFFFFFFFu) {
+		LOG(LOG_ERROR, "buffer_length/key_length exceeds word32 range\n");
+		return -1;
+	}
+
+#ifdef WOLFSSL_SMALL_STACK
+	hmac = (Hmac *)XMALLOC(sizeof(Hmac), NULL, DYNAMIC_TYPE_TMP_BUFFER);
+	if (hmac == NULL) {
+		LOG(LOG_ERROR, "XMALLOC failed\n");
+		return -1;
+	}
+#endif
+
+	switch (hmac_type) {
+	case FDO_CRYPTO_HMAC_TYPE_SHA_256:
+		if (output_length < BUFF_SIZE_32_BYTES) {
+			ret = -1;
+		} else {
+			wc_type = WC_SHA256;
+			ret = 0;
+		}
+		break;
+	case FDO_CRYPTO_HMAC_TYPE_SHA_384:
+		if (output_length < BUFF_SIZE_48_BYTES) {
+			ret = -1;
+		} else {
+			wc_type = WC_SHA384;
+			ret = 0;
+		}
+		break;
+	default:
+		LOG(LOG_ERROR, "Unsupported hmac type %d\n", hmac_type);
+		ret = -1;
+		break;
+	}
+
+	if (ret == 0) {
+		int hmac_inited = 0;
+
+		do {
+			if (wc_HmacInit(hmac, NULL, INVALID_DEVID) != 0) {
+				LOG(LOG_ERROR, "wc_HmacInit failed\n");
+				ret = -1;
+				break;
+			}
+			hmac_inited = 1;
+
+			if (wc_HmacSetKey(hmac, wc_type, key, key_length) != 0) {
+				LOG(LOG_ERROR, "wc_HmacSetKey failed\n");
+				ret = -1;
+				break;
+			}
+			if (wc_HmacUpdate(hmac, buffer, buffer_length) != 0) {
+				LOG(LOG_ERROR, "wc_HmacUpdate failed\n");
+				ret = -1;
+				break;
+			}
+			if (wc_HmacFinal(hmac, output) != 0) {
+				LOG(LOG_ERROR, "wc_HmacFinal failed\n");
+				ret = -1;
+				break;
+			}
+			ret = 0;
+		} while (0);
+
+		if (hmac_inited) {
+			wc_HmacFree(hmac);
+		}
+	}
+
+	if (hmac != NULL) {
+		/* Zero HMAC structure. */
+		memset_s(hmac, sizeof(Hmac), 0);
+#ifdef WOLFSSL_SMALL_STACK
+		XFREE(hmac, NULL, DYNAMIC_TYPE_TMP_BUFFER);
+#endif
+	}
+	return ret;
+}
+#endif /* SECURE_ELEMENT */
+
+/* Increment IV counter. */
+int32_t inc_rollover_ctr(uint8_t *first_iv, uint8_t *new_iv, uint8_t iv_len,
+			 size_t aesblocks)
+{
+	uint16_t inc = (aesblocks <= 0xFFFFFFFF) ? 1 : 2;
+	int carry;
+	int i;
+	int diff;
+	uint16_t j;
+
+	if (first_iv == NULL || new_iv == NULL || iv_len == 0) {
+		return -1;
+	}
+
+	for (j = 0; j < inc; j++) {
+		carry = 1;
+		for (i = iv_len - 1; i >= 0 && carry; i--) {
+			carry += new_iv[i];
+			new_iv[i] = (uint8_t)carry;
+			carry >>= 8;
+		}
+
+		if (carry) {
+			LOG(LOG_ERROR, "IV counter overflow\n");
+			return -1;
+		}
+
+		/* Check for unsupported IV wrap-around. */
+		if (0 == memcmp_s(first_iv, iv_len, new_iv, iv_len, &diff) && 0 == diff) {
+			LOG(LOG_ERROR, "Roll over iv not supported\n");
+			return -1;
+		}
+	}
+
+	return 0;
+}
diff --git a/crypto/wolfssl/wolfssl_ec_csr.c b/crypto/wolfssl/wolfssl_ec_csr.c
new file mode 100644
index 0000000..a715f04
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_ec_csr.c
@@ -0,0 +1,128 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Device CSR generation over wolfCrypt, software-ECDSA only.
+ * For DA=tpm the CSR is read from TPM NV instead; only provisioning
+ * (utils/tpm_make_ready_ecdsa.sh) still generates it with OpenSSL.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include <wolfssl/options.h>
+#include "safe_lib.h"
+#include "fdocred.h"
+#include "ecdsa_privkey.h"
+#include <wolfssl/wolfcrypt/ecc.h>
+#include <wolfssl/wolfcrypt/asn.h>
+#include <wolfssl/wolfcrypt/asn_public.h>
+#include <wolfssl/wolfcrypt/random.h>
+#include <wolfssl/wolfcrypt/memory.h>
+#include "wolfssl_ecdsa_util.h"
+
+/* Build and sign device CSR. */
+int32_t crypto_hal_get_device_csr(fdo_byte_array_t **csr)
+{
+	int32_t ret = -1;
+	ecc_key key;
+	WC_RNG rng;
+	Cert cert;
+	uint8_t *csr_der = NULL;
+	fdo_byte_array_t *result = NULL;
+	int derSz = 0;
+	int sigSz = 0;
+
+	if (csr == NULL) {
+		return -1;
+	}
+	*csr = NULL;
+
+#if !defined(ECDSA256_DA) && !defined(ECDSA384_DA)
+	LOG(LOG_ERROR, "No supported ECDSA curve defined\n");
+	return -1;
+#endif
+
+	if (wc_ecc_init(&key) != 0) {
+		return -1;
+	}
+
+	if (wc_InitRng(&rng) != 0) {
+		wc_ecc_free(&key);
+		return -1;
+	}
+
+	do {
+		if (wolfssl_ecdsa_load_privkey(&key) != 0) {
+			break;
+		}
+
+		if (wc_ecc_make_pub(&key, NULL) != 0) {
+			break;
+		}
+
+		wc_InitCert(&cert);
+
+		if (strncpy_s(cert.subject.country, CTC_NAME_SIZE, "IN", 2) != 0) {
+			break;
+		}
+		if (strncpy_s(cert.subject.commonName, CTC_NAME_SIZE, "fdo", 3) != 0) {
+			break;
+		}
+		if (strncpy_s(cert.subject.locality, CTC_NAME_SIZE, "Blr", 3) != 0) {
+			break;
+		}
+		if (strncpy_s(cert.subject.org, CTC_NAME_SIZE, "Intel", 5) != 0) {
+			break;
+		}
+
+#if defined(ECDSA384_DA)
+		cert.sigType = CTC_SHA384wECDSA;
+#else
+		cert.sigType = CTC_SHA256wECDSA;
+#endif
+
+		csr_der = fdo_alloc(4096);
+		if (!csr_der) {
+			break;
+		}
+
+		derSz = wc_MakeCertReq(&cert, csr_der, 4096, NULL, &key);
+		if (derSz <= 0) {
+			break;
+		}
+
+		sigSz = wc_SignCert(cert.bodySz, cert.sigType, csr_der, 4096, NULL, &key, &rng);
+		if (sigSz <= 0) {
+			break;
+		}
+
+		result = fdo_byte_array_alloc(sigSz);
+		if (result == NULL) {
+			break;
+		}
+
+		if (memcpy_s(result->bytes, result->byte_sz, csr_der, sigSz) != 0) {
+			break;
+		}
+
+		*csr = result;
+		result = NULL;
+		ret = 0;
+
+	} while (0);
+
+	if (result) {
+		fdo_byte_array_free(result);
+	}
+	if (csr_der) {
+		fdo_free(csr_der);
+	}
+
+	wc_FreeRng(&rng);
+	wc_ecc_free(&key);
+
+	return ret;
+}
diff --git a/crypto/wolfssl/wolfssl_ecdsa_util.h b/crypto/wolfssl/wolfssl_ecdsa_util.h
new file mode 100644
index 0000000..92fbe10
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_ecdsa_util.h
@@ -0,0 +1,125 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief Shared helpers for wolfCrypt ECDSA operations.
+ */
+
+#ifndef WOLFSSL_ECDSA_UTIL_H
+#define WOLFSSL_ECDSA_UTIL_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include "safe_lib.h"
+#include "util.h"
+#include "ecdsa_privkey.h"
+#include <wolfssl/wolfcrypt/ecc.h>
+#include <wolfssl/wolfcrypt/asn.h>
+#include <wolfssl/wolfcrypt/asn_public.h>
+
+/* Single source of truth for ECDSA coordinate (R/S, Qx/Qy) half-sizes, so
+ * the sign path (curve fixed at compile time) and the verify path (curve
+ * chosen at runtime from key_algorithm) can't derive different values for
+ * the same curve. */
+#define FDO_ECDSA_P256_COORD_SIZE 32
+#define FDO_ECDSA_P384_COORD_SIZE 48
+
+/* Runtime lookup for the verify path, which handles both curves in one
+ * binary regardless of the device's own compiled-in curve. */
+static inline size_t wolfssl_ecdsa_coord_size(int key_algorithm)
+{
+	return (key_algorithm == FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp384)
+		       ? FDO_ECDSA_P384_COORD_SIZE
+		       : FDO_ECDSA_P256_COORD_SIZE;
+}
+
+/* Strip 0x00 padding and copy right-aligned coordinate. */
+static inline int32_t wolfssl_ecdsa_place_coord(uint8_t *dst, size_t half,
+						 const uint8_t *src,
+						 uint32_t src_len)
+{
+	const uint8_t *p = src;
+
+	if (src_len > half) {
+		if (src_len == half + 1 && src[0] == 0x00) {
+			p++;
+			src_len--;
+		} else {
+			return -1;
+		}
+	}
+
+	if (src_len == 0) {
+		/* Slot is already zeroed. */
+		return 0;
+	}
+
+	if (memcpy_s(dst + (half - src_len), src_len, p, src_len) != 0) {
+		return -1;
+	}
+
+	return 0;
+}
+
+/*
+ * Load device ECDSA private key from storage into initialized ecc_key.
+ * Return 0 on success, -1 on failure.
+ */
+static inline int32_t wolfssl_ecdsa_load_privkey(ecc_key *key)
+{
+	uint8_t *privkey = NULL;
+	size_t privkeysize = 0;
+	int32_t ret = -1;
+
+	if (load_ecdsa_privkey(&privkey, &privkeysize) != 0 || privkey == NULL) {
+		return -1;
+	}
+
+	do {
+#if defined(ECDSA_PEM)
+		{
+			DerBuffer *der = NULL;
+			word32 idx = 0;
+			if (wc_PemToDer(privkey, privkeysize, ECC_PRIVATEKEY_TYPE,
+					&der, NULL, NULL, NULL) != 0 || !der) {
+				LOG(LOG_ERROR, "wc_PemToDer failed\n");
+				if (der) {
+					wc_FreeDer(&der);
+				}
+				break;
+			}
+			if (wc_EccPrivateKeyDecode(der->buffer, &idx, key,
+						   der->length) != 0) {
+				LOG(LOG_ERROR, "wc_EccPrivateKeyDecode failed\n");
+				wc_FreeDer(&der);
+				break;
+			}
+			wc_FreeDer(&der);
+		}
+#else
+		{
+			int curve_id = 0;
+#if defined(ECDSA256_DA)
+			curve_id = ECC_SECP256R1;
+#elif defined(ECDSA384_DA)
+			curve_id = ECC_SECP384R1;
+#endif
+			if (wc_ecc_import_private_key_ex(privkey, privkeysize, NULL,
+							 0, key, curve_id) != 0) {
+				LOG(LOG_ERROR, "wc_ecc_import_private_key_ex failed\n");
+				break;
+			}
+		}
+#endif
+		ret = 0;
+	} while (0);
+
+	wc_ForceZero(privkey, privkeysize);
+	fdo_free(privkey);
+	return ret;
+}
+
+#endif /* WOLFSSL_ECDSA_UTIL_H */
diff --git a/crypto/wolfssl/wolfssl_key_exchange_ecdh.c b/crypto/wolfssl/wolfssl_key_exchange_ecdh.c
new file mode 100644
index 0000000..0207d2e
--- /dev/null
+++ b/crypto/wolfssl/wolfssl_key_exchange_ecdh.c
@@ -0,0 +1,483 @@
+/*
+ * Copyright 2026 wolfSSL Inc.
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \brief ECDH key exchange abstraction over wolfCrypt.
+ */
+
+#include "fdo_crypto_hal.h"
+#include "util.h"
+#include "safe_lib.h"
+#include "wolfssl_ecdsa_util.h"
+#include <wolfssl/options.h>
+#include <wolfssl/wolfcrypt/ecc.h>
+#include <wolfssl/wolfcrypt/random.h>
+#include <wolfssl/wolfcrypt/error-crypt.h>
+
+#if defined(KEX_ECDH_ENABLED) || defined(KEX_ECDH384_ENABLED)
+
+#if defined(KEX_ECDH_ENABLED)
+#define AX_AY_SIZE_DEF BUFF_SIZE_32_BYTES
+#define OWNERRAND_SIZE_DEF BUFF_SIZE_16_BYTES
+#define CURVE_ID ECC_SECP256R1
+#define DEVICE_RANDOM_SIZE FDO_ECDH256_DEV_RANDOM
+#elif defined(KEX_ECDH384_ENABLED)
+#define AX_AY_SIZE_DEF BUFF_SIZE_48_BYTES
+#define OWNERRAND_SIZE_DEF BUFF_SIZE_48_BYTES
+#define CURVE_ID ECC_SECP384R1
+#define DEVICE_RANDOM_SIZE FDO_ECDH384_DEV_RANDOM
+#endif
+
+/* Device public random blob wire format: Ax, Ay, DevRand with 2-byte lengths. */
+#define LEN_PREFIX_SIZE 2
+#define NUM_LEN_PREFIXED_FIELDS 3 /* Ax, Ay, DevRand */
+
+static void write_be16_len(uint8_t *dst, uint32_t value)
+{
+	dst[0] = (value >> 8) & 0xFF;
+	dst[1] = value & 0xFF;
+}
+
+typedef struct {
+	uint8_t *_Device_random;
+	uint16_t _Dev_rand_size;
+	uint8_t *_publicA;
+	uint8_t *_shared_secret;
+	uint32_t _shared_secret_length;
+	ecc_key key;
+	/* Keep alive for wc_ecc_shared_secret */
+	WC_RNG rng;
+	int rng_inited;
+	uint8_t *_publicB;
+	uint32_t _publicB_length;
+} ecdh_context_t;
+
+int32_t crypto_hal_kex_close(void **context)
+{
+	if (!context) {
+		return -1;
+	}
+	ecdh_context_t *key_ex_data = *(ecdh_context_t **)context;
+	if (!key_ex_data) {
+		return -1;
+	}
+
+	wc_ecc_free(&(key_ex_data->key));
+	if (key_ex_data->rng_inited) {
+		wc_FreeRng(&(key_ex_data->rng));
+	}
+
+	if (key_ex_data->_shared_secret) {
+		memset_s(key_ex_data->_shared_secret,
+			 key_ex_data->_shared_secret_length, 0);
+		fdo_free(key_ex_data->_shared_secret);
+	}
+	if (key_ex_data->_publicA) {
+		fdo_free(key_ex_data->_publicA);
+	}
+	if (key_ex_data->_publicB) {
+		fdo_free(key_ex_data->_publicB);
+	}
+	if (key_ex_data->_Device_random) {
+		memset_s(key_ex_data->_Device_random,
+			 key_ex_data->_Dev_rand_size, 0);
+		fdo_free(key_ex_data->_Device_random);
+	}
+	fdo_free(key_ex_data);
+	*context = NULL;
+	return 0;
+}
+
+int32_t crypto_hal_kex_init(void **context)
+{
+	ecdh_context_t *key_ex_data = NULL;
+	uint32_t size = 0;
+	uint32_t allocbytes = 0;
+	uint8_t *temp = NULL;
+	uint32_t pub_x_len = AX_AY_SIZE_DEF;
+	uint32_t pub_y_len = AX_AY_SIZE_DEF;
+
+	if (!context) {
+		LOG(LOG_ERROR, "Invalid parameters\n");
+		return -1;
+	}
+
+	key_ex_data = fdo_alloc(sizeof(ecdh_context_t));
+	if (!key_ex_data) {
+		return -1;
+	}
+
+	if (wc_ecc_init(&(key_ex_data->key)) != 0) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		goto error;
+	}
+
+	key_ex_data->_Dev_rand_size = DEVICE_RANDOM_SIZE;
+	key_ex_data->_Device_random = fdo_alloc(key_ex_data->_Dev_rand_size);
+	if (!key_ex_data->_Device_random) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		goto error;
+	}
+
+	if (crypto_hal_random_bytes(key_ex_data->_Device_random, key_ex_data->_Dev_rand_size) != 0) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		goto error;
+	}
+
+	if (wc_InitRng(&(key_ex_data->rng)) != 0) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		goto error;
+	}
+	key_ex_data->rng_inited = 1;
+
+	/* Select the curve explicitly; the peer key is imported with
+	 * CURVE_ID, and a size alone may match another enabled curve. */
+	if (wc_ecc_make_key_ex(&(key_ex_data->rng), AX_AY_SIZE_DEF, &(key_ex_data->key), CURVE_ID) != 0) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		goto error;
+	}
+
+	/* Kept for wc_ecc_shared_secret blinding */
+	if (wc_ecc_set_rng(&(key_ex_data->key), &(key_ex_data->rng)) != 0) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		goto error;
+	}
+
+	allocbytes = pub_x_len + pub_y_len + key_ex_data->_Dev_rand_size +
+		     (LEN_PREFIX_SIZE * NUM_LEN_PREFIXED_FIELDS);
+	temp = fdo_alloc(allocbytes);
+	if (!temp) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		goto error;
+	}
+
+	word32 xLen = pub_x_len;
+	word32 yLen = pub_y_len;
+	if (wc_ecc_export_public_raw(&(key_ex_data->key),
+				     &temp[LEN_PREFIX_SIZE], &xLen,
+				     &temp[LEN_PREFIX_SIZE + xLen + LEN_PREFIX_SIZE],
+				     &yLen) != 0) {
+		LOG(LOG_ERROR, "failed at %d\n", __LINE__);
+		fdo_free(temp);
+		goto error;
+	}
+	if (xLen != pub_x_len || yLen != pub_y_len) {
+		LOG(LOG_ERROR, "wc_ecc_export_public_raw returned unexpected coordinate length at %d\n", __LINE__);
+		fdo_free(temp);
+		goto error;
+	}
+
+	/* X */
+	write_be16_len(&temp[0], xLen);
+	size = LEN_PREFIX_SIZE + xLen;
+
+	/* Y */
+	write_be16_len(&temp[size], yLen);
+	size += LEN_PREFIX_SIZE;
+
+	size += yLen;
+
+	/* DevRand */
+	write_be16_len(&temp[size], key_ex_data->_Dev_rand_size);
+	size += LEN_PREFIX_SIZE;
+	if (memcpy_s(&temp[size], allocbytes - size, key_ex_data->_Device_random, key_ex_data->_Dev_rand_size) != 0) {
+		fdo_free(temp);
+		goto error;
+	}
+	size += key_ex_data->_Dev_rand_size;
+
+	key_ex_data->_publicB = temp;
+	key_ex_data->_publicB_length = size;
+
+	*context = (void *)key_ex_data;
+	return 0;
+
+error:
+	crypto_hal_kex_close((void **)&key_ex_data);
+	return -1;
+}
+
+int32_t crypto_hal_get_device_random(void *context, uint8_t *dev_rand_value,
+				     uint32_t *dev_rand_length)
+{
+	ecdh_context_t *key_ex_data = (ecdh_context_t *)context;
+	if (!key_ex_data || !dev_rand_length) {
+		return -1;
+	}
+	if (!dev_rand_value) {
+		*dev_rand_length = key_ex_data->_publicB_length;
+		return 0;
+	}
+	if (*dev_rand_length < key_ex_data->_publicB_length) {
+		return -1;
+	}
+	if (memcpy_s(dev_rand_value, *dev_rand_length, key_ex_data->_publicB, key_ex_data->_publicB_length) != 0) {
+		return -1;
+	}
+	*dev_rand_length = key_ex_data->_publicB_length;
+	return 0;
+}
+
+/**
+ * Parse the wire-format peer-random blob (2-byte-length-prefixed Ax, Ay,
+ * owner-random) out of `temp`/`temp_length`. Returns 0 and sets the out
+ * parameters to point inside `temp` on success, -1 on any malformed/
+ * out-of-bounds field.
+ */
+static int32_t parse_peer_random_fields(uint8_t *temp, uint32_t temp_length,
+					 uint32_t *size_Ax, uint8_t **Ax,
+					 uint32_t *size_Ay, uint8_t **Ay,
+					 uint32_t *size_owner_random,
+					 uint8_t **owner_random)
+{
+	uint32_t size = 0;
+
+	if (size + 2 > temp_length) {
+		return -1;
+	}
+	*size_Ax = (temp[size] << 8) | temp[size + 1];
+	size += 2;
+	*Ax = &temp[size];
+	if (*size_Ax > temp_length - size) {
+		return -1;
+	}
+	size += *size_Ax;
+
+	if (size + 2 > temp_length) {
+		return -1;
+	}
+	*size_Ay = (temp[size] << 8) | temp[size + 1];
+	size += 2;
+	*Ay = &temp[size];
+	if (*size_Ay > temp_length - size) {
+		return -1;
+	}
+	size += *size_Ay;
+
+	if (size + 2 > temp_length) {
+		return -1;
+	}
+	*size_owner_random = (temp[size] << 8) | temp[size + 1];
+	size += 2;
+	*owner_random = &temp[size];
+	if (*size_owner_random > temp_length - size) {
+		return -1;
+	}
+	size += *size_owner_random;
+
+	/*
+	 * A peer may serialise Ax/Ay with leading zero bytes stripped (the
+	 * OpenSSL back end does exactly that via BN_bn2bin), so a short
+	 * coordinate is legal and must be left-padded by the caller before
+	 * being handed to wc_ecc_import_unsigned(), which takes no length
+	 * argument and always reads a fixed curve-size number of bytes.
+	 */
+	if (size > temp_length || *size_Ax > AX_AY_SIZE_DEF ||
+	    *size_Ay > AX_AY_SIZE_DEF ||
+	    *size_owner_random > OWNERRAND_SIZE_DEF) {
+		return -1;
+	}
+
+	return 0;
+}
+
+int32_t crypto_hal_set_peer_random(void *context,
+				   const uint8_t *peer_rand_value,
+				   uint32_t peer_rand_length)
+{
+	ecdh_context_t *key_ex_data = (ecdh_context_t *)context;
+	uint32_t size_Ax = 0, size_Ay = 0, size_owner_random = 0;
+	uint8_t *Ax = NULL, *Ay = NULL, *owner_random = NULL;
+
+	if (context == NULL || peer_rand_value == NULL || peer_rand_length == 0) {
+		return -1;
+	}
+
+	/* A prior call on this context would otherwise be leaked here. */
+	if (key_ex_data->_publicA) {
+		fdo_free(key_ex_data->_publicA);
+		key_ex_data->_publicA = NULL;
+	}
+
+	key_ex_data->_publicA = fdo_alloc(peer_rand_length);
+	if (key_ex_data->_publicA == NULL) {
+		return -1;
+	}
+	if (memcpy_s(key_ex_data->_publicA, peer_rand_length, peer_rand_value, peer_rand_length) != 0 ||
+	    parse_peer_random_fields(key_ex_data->_publicA, peer_rand_length,
+				     &size_Ax, &Ax, &size_Ay, &Ay,
+				     &size_owner_random, &owner_random) != 0) {
+		fdo_free(key_ex_data->_publicA);
+		key_ex_data->_publicA = NULL;
+		return -1;
+	}
+
+	ecc_key peer_key;
+	if (wc_ecc_init(&peer_key) != 0) {
+		fdo_free(key_ex_data->_publicA);
+		key_ex_data->_publicA = NULL;
+		return -1;
+	}
+
+	/*
+	 * wc_ecc_import_unsigned() reads exactly AX_AY_SIZE_DEF bytes per
+	 * coordinate, so right-align whatever the peer sent into fixed-width
+	 * slots first.
+	 */
+	uint8_t Ax_padded[AX_AY_SIZE_DEF] = {0};
+	uint8_t Ay_padded[AX_AY_SIZE_DEF] = {0};
+
+	if (wolfssl_ecdsa_place_coord(Ax_padded, AX_AY_SIZE_DEF, Ax, size_Ax) != 0 ||
+	    wolfssl_ecdsa_place_coord(Ay_padded, AX_AY_SIZE_DEF, Ay, size_Ay) != 0) {
+		wc_ecc_free(&peer_key);
+		fdo_free(key_ex_data->_publicA);
+		key_ex_data->_publicA = NULL;
+		return -1;
+	}
+
+	if (wc_ecc_import_unsigned(&peer_key, Ax_padded, Ay_padded, NULL,
+				   CURVE_ID) != 0) {
+		wc_ecc_free(&peer_key);
+		fdo_free(key_ex_data->_publicA);
+		key_ex_data->_publicA = NULL;
+		return -1;
+	}
+
+	uint8_t secret[BUFF_SIZE_512_BYTES] = {0};
+	word32 secret_size = sizeof(secret);
+
+	if (wc_ecc_shared_secret(&(key_ex_data->key), &peer_key, secret, &secret_size) != 0) {
+		memset_s(secret, sizeof(secret), 0);
+		wc_ecc_free(&peer_key);
+		fdo_free(key_ex_data->_publicA);
+		key_ex_data->_publicA = NULL;
+		return -1;
+	}
+	wc_ecc_free(&peer_key);
+
+	/*
+	 * wc_ecc_shared_secret() always zero-pads its output to the full
+	 * curve width (e.g. 32/48 bytes), unlike OpenSSL's BN_bn2bin used by
+	 * the openssl back end, which strips leading zero bytes. Strip the
+	 * same leading zeros here so ShSe (and the session keys derived from
+	 * it) match byte-for-byte with an OpenSSL-based peer whenever the
+	 * shared secret's high-order byte(s) happen to be zero.
+	 */
+	uint8_t *secret_trimmed = secret;
+	word32 secret_trimmed_size = secret_size;
+	while (secret_trimmed_size > 1 && secret_trimmed[0] == 0) {
+		secret_trimmed++;
+		secret_trimmed_size--;
+	}
+
+	uint32_t custom_shse_size = key_ex_data->_Dev_rand_size + size_owner_random + secret_trimmed_size;
+	uint8_t *shse = fdo_alloc(custom_shse_size);
+	if (!shse) {
+		memset_s(secret, sizeof(secret), 0);
+		return -1;
+	}
+
+	uint32_t offset = 0;
+	if (memcpy_s(&shse[offset], custom_shse_size - offset, secret_trimmed, secret_trimmed_size) != 0) {
+		memset_s(secret, sizeof(secret), 0);
+		memset_s(shse, custom_shse_size, 0);
+		fdo_free(shse);
+		return -1;
+	}
+	offset += secret_trimmed_size;
+	if (memcpy_s(&shse[offset], custom_shse_size - offset, key_ex_data->_Device_random, key_ex_data->_Dev_rand_size) != 0) {
+		memset_s(secret, sizeof(secret), 0);
+		memset_s(shse, custom_shse_size, 0);
+		fdo_free(shse);
+		return -1;
+	}
+	offset += key_ex_data->_Dev_rand_size;
+	if (memcpy_s(&shse[offset], custom_shse_size - offset, owner_random, size_owner_random) != 0) {
+		memset_s(secret, sizeof(secret), 0);
+		memset_s(shse, custom_shse_size, 0);
+		fdo_free(shse);
+		return -1;
+	}
+
+	memset_s(secret, sizeof(secret), 0);
+
+	if (key_ex_data->_shared_secret) {
+		memset_s(key_ex_data->_shared_secret,
+			 key_ex_data->_shared_secret_length, 0);
+		fdo_free(key_ex_data->_shared_secret);
+		key_ex_data->_shared_secret = NULL;
+	}
+
+	key_ex_data->_shared_secret = shse;
+	key_ex_data->_shared_secret_length = custom_shse_size;
+
+	return 0;
+}
+
+int32_t crypto_hal_get_secret(void *context, uint8_t *secret,
+			      uint32_t *secret_length)
+{
+	ecdh_context_t *key_ex_data = (ecdh_context_t *)context;
+	if (!key_ex_data || !secret_length) {
+		return -1;
+	}
+	if (!secret) {
+		*secret_length = key_ex_data->_shared_secret_length;
+		return 0;
+	}
+	if (*secret_length < key_ex_data->_shared_secret_length) {
+		return -1;
+	}
+	if (memcpy_s(secret, *secret_length, key_ex_data->_shared_secret, key_ex_data->_shared_secret_length) != 0) {
+		return -1;
+	}
+	*secret_length = key_ex_data->_shared_secret_length;
+	return 0;
+}
+
+#else /* !(KEX_ECDH_ENABLED || KEX_ECDH384_ENABLED) */
+
+int32_t crypto_hal_kex_close(void **context)
+{
+	(void)context;
+	return -1;
+}
+
+int32_t crypto_hal_kex_init(void **context)
+{
+	(void)context;
+	return -1;
+}
+
+int32_t crypto_hal_get_device_random(void *context, uint8_t *dev_rand_value,
+				     uint32_t *dev_rand_length)
+{
+	(void)context;
+	(void)dev_rand_value;
+	(void)dev_rand_length;
+	return -1;
+}
+
+int32_t crypto_hal_set_peer_random(void *context,
+				   const uint8_t *peer_rand_value,
+				   uint32_t peer_rand_length)
+{
+	(void)context;
+	(void)peer_rand_value;
+	(void)peer_rand_length;
+	return -1;
+}
+
+int32_t crypto_hal_get_secret(void *context, uint8_t *secret,
+			      uint32_t *secret_length)
+{
+	(void)context;
+	(void)secret;
+	(void)secret_length;
+	return -1;
+}
+
+#endif /* KEX_ECDH_ENABLED || KEX_ECDH384_ENABLED */
