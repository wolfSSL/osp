+void test_fdo_tpm_get_hmac_success(void)
+{
+	uint8_t data[4] = {1, 2, 3, 4};
+	uint8_t hmac[32] = {0};
+	uint8_t expected[32];
+
+	mock_existing_key = 1;
+	mock_hmac_out_sz = sizeof(hmac);
+	memset(expected, 0x33, sizeof(expected));
