diff --git a/utils/setup_local_dependencies.sh b/utils/setup_local_dependencies.sh
new file mode 100755
index 0000000..65fad8a
--- /dev/null
+++ b/utils/setup_local_dependencies.sh
@@ -0,0 +1,47 @@
+#!/bin/bash
+#
+# Copyright 2026 wolfSSL Inc.
+# SPDX-License-Identifier: Apache-2.0
+#
+# Setup local dependencies (safestringlib and tinycbor) for local native builds
+
+set -e -o pipefail
+
+BASE_DIR="$(pwd)"
+
+echo "Checking for safestringlib..."
+if [ ! -d "safestringlib" ]; then
+    echo "Cloning safestringlib v1.2.0..."
+    git clone -b v1.2.0 https://github.com/intel/safestringlib.git
+    cd safestringlib
+
+    # Build with GCC compat flags
+    echo "Building safestringlib..."
+    mkdir -p obj
+    make CFLAGS="-Iinclude -fstack-protector-strong -fPIE -fPIC -O2 -D_FORTIFY_SOURCE=2 -Wformat -Wformat-security -Wno-error=implicit-function-declaration"
+    cd "$BASE_DIR"
+else
+    echo "safestringlib already exists. Skipping."
+fi
+
+echo ""
+echo "Checking for tinycbor..."
+if [ ! -d "tinycbor" ]; then
+    echo "Cloning tinycbor v0.6.0..."
+    git clone https://github.com/intel/tinycbor.git
+    cd tinycbor
+    git checkout v0.6.0
+    make
+    cd "$BASE_DIR"
+else
+    echo "tinycbor already exists. Skipping."
+fi
+
+echo ""
+echo "========================================================"
+echo "Dependencies successfully built!"
+echo "Run the following commands to export their paths into your environment:"
+echo ""
+echo "export SAFESTRING_ROOT=$BASE_DIR/safestringlib"
+echo "export TINYCBOR_ROOT=$BASE_DIR/tinycbor"
+echo "========================================================"
diff --git a/utils/setup_yocto_wolfssl.sh b/utils/setup_yocto_wolfssl.sh
new file mode 100755
index 0000000..bddf349
--- /dev/null
+++ b/utils/setup_yocto_wolfssl.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+#
+# Copyright 2026
+# SPDX-License-Identifier: Apache-2.0
+#
+# Setup Yocto dependencies for clientsdk-wolfssl builds
+# Clones meta-wolfssl and provides setup instructions
+
+set -e
+
+YOCTO_DIR="${1:-$HOME/yocto}"
+
+echo "=========================================================="
+echo " Setting up Yocto dependencies for clientsdk-wolfssl"
+echo "=========================================================="
+
+if [ ! -d "$YOCTO_DIR" ]; then
+    echo "Error: Yocto directory '$YOCTO_DIR' does not exist."
+    echo "Usage: $0 [path-to-yocto-dir]"
+    exit 1
+fi
+
+META_WOLFSSL_DIR="$YOCTO_DIR/meta-wolfssl"
+
+# Pin meta-wolfssl commit.
+META_WOLFSSL_REV="e029e80b743fb3096ccb494161144ae3888e1a48" # wolfSSL 5.9.4, wolfTPM 4.2.0
+
+if [ -d "$META_WOLFSSL_DIR" ]; then
+    echo "[INFO] meta-wolfssl is already cloned at $META_WOLFSSL_DIR."
+else
+    echo "[INFO] Cloning meta-wolfssl into $YOCTO_DIR..."
+    git clone https://github.com/wolfSSL/meta-wolfssl.git "$META_WOLFSSL_DIR"
+    git -C "$META_WOLFSSL_DIR" checkout "$META_WOLFSSL_REV"
+fi
+
+echo ""
+echo "=========================================================="
+echo " Setup Complete!"
+echo "=========================================================="
+echo "To build clientsdk-wolfssl, ensure you add the layer to your build environment:"
+echo ""
+echo "  1. Source your Yocto build environment:"
+echo "     source poky/oe-init-build-env build"
+echo ""
+echo "  2. Add the newly cloned meta-wolfssl layer:"
+echo "     bitbake-layers add-layer $META_WOLFSSL_DIR"
+echo ""
+echo "  3. Add this meta-intel-sdo layer as well:"
+echo "     bitbake-layers add-layer <path-to-client-sdk>/utils/meta-intel-sdo"
+echo ""
+echo "  4. Run the build:"
+echo "     bitbake clientsdk-wolfssl"
+echo "=========================================================="
