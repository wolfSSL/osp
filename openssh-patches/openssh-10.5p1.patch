+/* OpenSSH's sandbox blocks /dev/urandom. Make sure wolfSSL can seed its DRBG
+ * without it. */
+#if !defined(HAVE_INTEL_RDSEED) && !defined(HAVE_AMD_RDSEED) && \
+    !defined(WOLFSSL_GETRANDOM) && !defined(HAVE_GETRANDOM) && \
+    !defined(WOLFSSL_SEED_SOURCE_IS_SANDBOX_SAFE)
+#error "No sandbox-safe RNG seed source. Build wolfSSL with rdseed or getrandom(2) support, or define WOLFSSL_SEED_SOURCE_IS_SANDBOX_SAFE if your seed source works inside OpenSSH's sandbox."
