+	zassert_equal(unpin_send_errno, 0, "send() failed (%d)", unpin_send_errno);
+
+	(void)tls_credential_delete(wrong_tag, TLS_CREDENTIAL_PSK);
+	(void)tls_credential_delete(wrong_tag, TLS_CREDENTIAL_PSK_ID);
+	test_sockets_close();
+#endif
+}
+
+/* wolfSSL-only: a DTLS server whose read side is shut down reads EOF. */
+ZTEST(net_socket_tls, test_dtls_server_shut_rd_reads_eof)
+{
+#if !defined(CONFIG_NET_SOCKETS_ENABLE_DTLS) || !defined(CONFIG_WOLFSSL)
+	ztest_test_skip();
+#else
+	struct sockaddr s_saddr;
+	struct timeval timeo_optval = { .tv_sec = 1 };
+	int role = TLS_DTLS_ROLE_SERVER;
+	uint8_t rx_buf;
+	int ret;
+
+	prepare_sock_dtls_v4(MY_IPV4_ADDR, SERVER_PORT, &s_sock,
+			     (struct sockaddr_in *)&s_saddr, IPPROTO_DTLS_1_2);
+	test_config_psk(s_sock, -1);
+	zassert_ok(zsock_setsockopt(s_sock, SOL_TLS, TLS_DTLS_ROLE, &role, sizeof(role)));
+	zassert_ok(zsock_setsockopt(s_sock, SOL_SOCKET, SO_RCVTIMEO, &timeo_optval,
+				    sizeof(timeo_optval)));
+	test_bind(s_sock, &s_saddr, sizeof(struct sockaddr_in));
+
+	zassert_ok(zsock_shutdown(s_sock, ZSOCK_SHUT_RD), "shutdown() failed (%d)", errno);
+
+	ret = zsock_recv(s_sock, &rx_buf, sizeof(rx_buf), 0);
+	zassert_equal(ret, 0, "recv() after SHUT_RD returned %d (%d)", ret, errno);
+
+	test_sockets_close();
+#endif
+}
+
+/* wolfSSL-only: datagrams that bring no handshake progress do not hold off a retransmission. */
+ZTEST(net_socket_tls, test_dtls_client_retransmit_under_traffic)
+{
+#if !defined(CONFIG_NET_SOCKETS_ENABLE_DTLS) || !defined(CONFIG_WOLFSSL)
+	ztest_test_skip();
+#else
+	struct sockaddr c_saddr, s_saddr;
+	struct connect_data test_data;
+	uint8_t junk = 0, rx_buf[512];
+	int flights = 0;
+
+	prepare_sock_dtls_v4(MY_IPV4_ADDR, CLIENT_1_PORT, &c_sock,
+			     (struct sockaddr_in *)&c_saddr, IPPROTO_DTLS_1_2);
+	test_config_psk(-1, c_sock);
+	test_bind(c_sock, &c_saddr, sizeof(struct sockaddr_in));
+
+	/* A plain UDP peer that never answers the handshake */
+	prepare_sock_udp_v4(MY_IPV4_ADDR, SERVER_PORT, &s_sock, (struct sockaddr_in *)&s_saddr);
+	test_bind(s_sock, &s_saddr, sizeof(struct sockaddr_in));
+
+	test_data.sock = c_sock;
+	test_data.addr = &s_saddr;
+	k_work_init_delayable(&test_data.work, dtls_client_connect_send_no_assert_work_handler);
+	test_work_reschedule(&test_data.work, K_NO_WAIT);
+
+	/* Junk every 200 ms, past the 1 s DTLS timer and within the connect timeout */
+	for (int i = 0; i < 9; i++) {
+		k_msleep(200);
+		while (zsock_recv(s_sock, rx_buf, sizeof(rx_buf), ZSOCK_MSG_DONTWAIT) > 0) {
+			flights++;
+		}
+		(void)zsock_sendto(s_sock, &junk, sizeof(junk), 0, &c_saddr,
+				   sizeof(struct sockaddr_in));
+	}
+
+	test_work_wait(&test_data.work);
+	zassert_true(flights >= 2, "client sent %d ClientHello flight(s), no retransmission",
+		     flights);
+#endif
+}
+
+/* wolfSSL-only: a TCP FIN without a close_notify is a recv error, as on mbedTLS. */
+ZTEST(net_socket_tls, test_tls_peer_fin_is_error)
+{
+#if !defined(CONFIG_WOLFSSL)
+	ztest_test_skip();
+#else
+	struct timeval rcv_timeo = { .tv_sec = 2 };
+	uint8_t rx_buf[sizeof(TEST_STR_SMALL)];
+	int ret;
+
+	test_prepare_tls_connection(AF_INET);
+
+	/* Closing the server then sends a FIN but no close_notify */
+	test_wolfssl_mark_close_notify_sent(ztls_get_wolfssl_context(new_sock));
+	test_close(new_sock);
+	new_sock = -1;
+
+	ret = zsock_setsockopt(c_sock, SOL_SOCKET, SO_RCVTIMEO, &rcv_timeo,
+			       sizeof(rcv_timeo));
+	zassert_ok(ret, "failed to set SO_RCVTIMEO (%d)", errno);
+
+	ret = zsock_recv(c_sock, rx_buf, sizeof(rx_buf), 0);
+	zassert_equal(ret, -1, "a FIN without close_notify read as %d", ret);
+	zassert_equal(errno, EIO, "unexpected errno %d", errno);
+
+	test_sockets_close();
+
+	k_sleep(TCP_TEARDOWN_TIMEOUT);
+#endif
+}
+
+/* wolfSSL-only: a TCP reset is a recv error, not a clean EOF. */
+ZTEST(net_socket_tls, test_tls_peer_rst_is_error)
+{
+#if !defined(CONFIG_WOLFSSL)
+	ztest_test_skip();
+#else
+	struct timeval rcv_timeo = { .tv_sec = 2 };
+	struct net_context *srv_ctx;
+	uint8_t rx_buf[sizeof(TEST_STR_SMALL)];
+	int ret;
+
+	test_prepare_tls_connection(AF_INET);
+
+	/* Drop the server connection with neither close_notify nor FIN, so the next
+	 * client segment draws a RST from the listener.
+	 */
+	srv_ctx = zsock_get_context_object(wolfSSL_get_fd(ztls_get_wolfssl_context(new_sock)));
+	zassert_not_null(srv_ctx, "no server TCP context");
+	test_wolfssl_mark_close_notify_sent(ztls_get_wolfssl_context(new_sock));
+	zassert_ok(net_tcp_put(srv_ctx, true), "failed to drop the server connection");
+	test_close(new_sock);
+	new_sock = -1;
+
+	test_send(c_sock, TEST_STR_SMALL, sizeof(TEST_STR_SMALL) - 1, 0);
+	/* Let the RST land first, so wolfSSL reads it rather than poll() */
+	k_sleep(K_MSEC(100));
+
+	ret = zsock_setsockopt(c_sock, SOL_SOCKET, SO_RCVTIMEO, &rcv_timeo, sizeof(rcv_timeo));
+	zassert_ok(ret, "failed to set SO_RCVTIMEO (%d)", errno);
+
+	ret = zsock_recv(c_sock, rx_buf, sizeof(rx_buf), 0);
+	zassert_equal(ret, -1, "a TCP reset read as %d", ret);
+	zassert_true(errno == EIO || errno == ECONNRESET, "unexpected errno %d", errno);
+
+	test_sockets_close();
+
+	k_sleep(TCP_TEARDOWN_TIMEOUT);
+#endif
+}
+
+/* A datagram bigger than one DTLS record fails, as mbedTLS refuses it */
+ZTEST(net_socket_tls, test_dtls_send_oversized_datagram)
+{
+	static uint8_t big[4000];
+	ssize_t ret;
+
+	test_prepare_dtls_connection(AF_INET);
+
+	ret = zsock_send(c_sock, big, sizeof(big), 0);
+	zassert_equal(ret, -1, "an oversized datagram sent %d bytes", (int)ret);
+	zassert_equal(errno, ECONNABORTED, "unexpected errno %d", errno);
+
+	test_sockets_close();
+}
+
+/* wolfSSL's PSK callback buffer holds MAX_PSK_ID_LEN bytes plus the terminator */
+ZTEST(net_socket_tls, test_tls_psk_identity_max_len)
+{
+	static char long_id[2048];
+	uint8_t rx_buf[sizeof(TEST_STR_SMALL) - 1];
+	int id_len = 128;
+	int ret;
+
+#if defined(CONFIG_WOLFSSL)
+	id_len = test_wolfssl_max_psk_id_len();
+#endif
+	zassert_true(id_len < sizeof(long_id), "identity of %d bytes does not fit", id_len);
+	memset(long_id, 'i', id_len);
+	test_psk_id = long_id;
+	test_prepare_tls_connection(AF_INET);
+
+	test_send(c_sock, TEST_STR_SMALL, sizeof(rx_buf), 0);
+	ret = zsock_recv(new_sock, rx_buf, sizeof(rx_buf), ZSOCK_MSG_WAITALL);
+	zassert_equal(ret, sizeof(rx_buf), "recv() returned %d (%d)", ret, errno);
+	zassert_mem_equal(rx_buf, TEST_STR_SMALL, sizeof(rx_buf));
+
+	test_sockets_close();
+	k_sleep(TCP_TEARDOWN_TIMEOUT);
+}
+
+#if defined(CONFIG_WOLFSSL) && defined(WOLFSSL_DTLS_CID)
+#define TEST_DTLS_CID true
+#else
+#define TEST_DTLS_CID IS_ENABLED(CONFIG_MBEDTLS_SSL_DTLS_CONNECTION_ID)
+#endif
+
+static void test_dtls_cid_connect(int c_cid, int s_cid, const uint8_t *c_val, size_t c_val_len,
+				  const uint8_t *s_val, size_t s_val_len)
+{
+	struct sockaddr c_saddr, s_saddr;
+	struct connect_data test_data;
+	int role = TLS_DTLS_ROLE_SERVER;
+	uint8_t rx_buf;
+
+	prepare_sock_dtls_v4(MY_IPV4_ADDR, ANY_PORT, &c_sock, (struct sockaddr_in *)&c_saddr,
+			     IPPROTO_DTLS_1_2);
+	prepare_sock_dtls_v4(MY_IPV4_ADDR, ANY_PORT, &s_sock, (struct sockaddr_in *)&s_saddr,
+			     IPPROTO_DTLS_1_2);
+	test_config_psk(s_sock, c_sock);
+	zassert_ok(zsock_setsockopt(s_sock, SOL_TLS, TLS_DTLS_ROLE, &role, sizeof(role)));
+	if (c_val_len != 0) {
+		zassert_ok(zsock_setsockopt(c_sock, SOL_TLS, TLS_DTLS_CID_VALUE, c_val, c_val_len));
+	}
+	if (s_val_len != 0) {
+		zassert_ok(zsock_setsockopt(s_sock, SOL_TLS, TLS_DTLS_CID_VALUE, s_val, s_val_len));
+	}
+	zassert_ok(zsock_setsockopt(c_sock, SOL_TLS, TLS_DTLS_CID, &c_cid, sizeof(c_cid)));
+	zassert_ok(zsock_setsockopt(s_sock, SOL_TLS, TLS_DTLS_CID, &s_cid, sizeof(s_cid)));
+	test_bind(s_sock, &s_saddr, sizeof(struct sockaddr_in));
+
+	test_data.sock = c_sock;
+	test_data.addr = &s_saddr;
+	k_work_init_delayable(&test_data.work, dtls_client_connect_send_work_handler);
+	test_work_reschedule(&test_data.work, K_NO_WAIT);
+	zassert_equal(zsock_recv(s_sock, &rx_buf, sizeof(rx_buf), 0), sizeof(rx_buf),
+		      "recv() failed (%d)", errno);
+	test_work_wait(&test_data.work);
+}
+
+static void test_dtls_cid_status(int c_cid, int s_cid, int c_status, int s_status)
+{
+	uint8_t own[32], peer[32];
+	socklen_t own_len = sizeof(own);
+	socklen_t peer_len = sizeof(peer);
+	socklen_t len = sizeof(int);
+	int val;
+
+	if (!TEST_DTLS_CID) {
+		ztest_test_skip();
+	}
+
+	test_dtls_cid_connect(c_cid, s_cid, NULL, 0, NULL, 0);
+
+	zassert_ok(zsock_getsockopt(c_sock, SOL_TLS, TLS_DTLS_CID_STATUS, &val, &len));
+	zassert_equal(val, c_status, "client CID status %d", val);
+	if (s_status >= 0) {
+		zassert_ok(zsock_getsockopt(s_sock, SOL_TLS, TLS_DTLS_CID_STATUS, &val, &len));
+		zassert_equal(val, s_status, "server CID status %d", val);
+	}
+
+	/* The server sends the client's own CID, if the client negotiated one */
+	zassert_ok(zsock_getsockopt(c_sock, SOL_TLS, TLS_DTLS_CID_VALUE, own, &own_len));
+	zassert_ok(zsock_getsockopt(s_sock, SOL_TLS, TLS_DTLS_PEER_CID_VALUE, peer, &peer_len));
+	if (c_cid == TLS_DTLS_CID_DISABLED) {
+		own_len = 0;
+	}
+	zassert_equal(peer_len, own_len, "peer CID length %d", peer_len);
+	zassert_mem_equal(peer, own, own_len);
+}
+
+/* CIDs set through TLS_DTLS_CID_VALUE are the ones each side sends */
+ZTEST(net_socket_tls, test_dtls_cid_explicit_values)
+{
+	static const uint8_t c_cid[] = { 1, 2, 3, 4 };
+	static const uint8_t s_cid[] = { 5, 6, 7, 8, 9 };
+	uint8_t buf[32];
+	socklen_t len;
+
+	if (!TEST_DTLS_CID) {
+		ztest_test_skip();
+	}
+
+	test_dtls_cid_connect(TLS_DTLS_CID_ENABLED, TLS_DTLS_CID_ENABLED, c_cid, sizeof(c_cid),
+			      s_cid, sizeof(s_cid));
+
+	len = sizeof(buf);
+	zassert_ok(zsock_getsockopt(c_sock, SOL_TLS, TLS_DTLS_PEER_CID_VALUE, buf, &len));
+	zassert_equal(len, sizeof(s_cid), "client sees peer CID length %d", len);
+	zassert_mem_equal(buf, s_cid, sizeof(s_cid));
+
+	len = sizeof(buf);
+	zassert_ok(zsock_getsockopt(s_sock, SOL_TLS, TLS_DTLS_PEER_CID_VALUE, buf, &len));
+	zassert_equal(len, sizeof(c_cid), "server sees peer CID length %d", len);
+	zassert_mem_equal(buf, c_cid, sizeof(c_cid));
+}
+
+ZTEST(net_socket_tls, test_dtls_cid_status_bidirectional)
+{
+	test_dtls_cid_status(TLS_DTLS_CID_ENABLED, TLS_DTLS_CID_ENABLED,
+			     TLS_DTLS_CID_STATUS_BIDIRECTIONAL, TLS_DTLS_CID_STATUS_BIDIRECTIONAL);
+}
+
+ZTEST(net_socket_tls, test_dtls_cid_status_client_only)
+{
+	test_dtls_cid_status(TLS_DTLS_CID_ENABLED, TLS_DTLS_CID_SUPPORTED,
+			     TLS_DTLS_CID_STATUS_DOWNLINK, TLS_DTLS_CID_STATUS_UPLINK);
+}
+
+ZTEST(net_socket_tls, test_dtls_cid_status_server_only)
+{
+	test_dtls_cid_status(TLS_DTLS_CID_SUPPORTED, TLS_DTLS_CID_ENABLED,
+			     TLS_DTLS_CID_STATUS_UPLINK, TLS_DTLS_CID_STATUS_DOWNLINK);
+}
+
+/* mbedTLS reports the server's own CID even when the client did not negotiate one */
+ZTEST(net_socket_tls, test_dtls_cid_client_disabled)
+{
+	test_dtls_cid_status(TLS_DTLS_CID_DISABLED, TLS_DTLS_CID_ENABLED,
+			     TLS_DTLS_CID_STATUS_DISABLED,
+			     IS_ENABLED(CONFIG_WOLFSSL) ? TLS_DTLS_CID_STATUS_DISABLED : -1);
+}
+
 ZTEST_SUITE(net_socket_tls, NULL, tls_tests_setup, NULL, tls_tests_after, NULL);
