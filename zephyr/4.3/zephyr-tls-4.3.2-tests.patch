+
+		zassert_true(dummy >= 0, "purge socket open failed");
+		ret = zsock_setsockopt(dummy, SOL_TLS, TLS_SESSION_CACHE_PURGE,
+				       NULL, 0);
+		zassert_equal(ret, 0, "purge setsockopt failed");
+		zsock_close(dummy);
