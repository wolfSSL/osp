+/* wolfSSL-only: connect() after recv() as a DTLS server makes the socket a client */
+ZTEST(net_socket_tls, test_dtls_connect_after_server_recv)
+{
+#if defined(CONFIG_WOLFSSL) && defined(CONFIG_NET_SOCKETS_ENABLE_DTLS)
+	struct sockaddr_in c_saddr;
+	struct sockaddr_in s_saddr;
+	struct connect_data test_data;
+	int role = TLS_DTLS_ROLE_SERVER;
+	socklen_t cs_len = sizeof(int);
+	struct zsock_pollfd fds[1];
+	uint8_t rx_buf;
+	int cs;
+	int ret;
+
+	prepare_sock_dtls_v4(MY_IPV4_ADDR, ANY_PORT, &c_sock, &c_saddr, IPPROTO_DTLS_1_2);
+	prepare_sock_dtls_v4(MY_IPV4_ADDR, ANY_PORT, &s_sock, &s_saddr, IPPROTO_DTLS_1_2);
+	test_config_psk(s_sock, c_sock);
+
+	zassert_ok(zsock_setsockopt(s_sock, SOL_TLS, TLS_DTLS_ROLE, &role, sizeof(role)));
+	test_bind(s_sock, (struct sockaddr *)&s_saddr, sizeof(s_saddr));
+
+	zassert_ok(zsock_setsockopt(c_sock, SOL_TLS, TLS_DTLS_ROLE, &role, sizeof(role)));
+	test_bind(c_sock, (struct sockaddr *)&c_saddr, sizeof(c_saddr));
+	ret = zsock_recv(c_sock, &rx_buf, sizeof(rx_buf), ZSOCK_MSG_DONTWAIT);
+	zassert_equal(ret, -1, "recv() should've failed");
+
+	test_data.sock = c_sock;
+	test_data.addr = (struct sockaddr *)&s_saddr;
+	k_work_init_delayable(&test_data.work, client_connect_work_handler);
+	test_work_reschedule(&test_data.work, K_NO_WAIT);
+
+	/* The server's handshake runs inside poll() */
+	fds[0].fd = s_sock;
+	fds[0].events = ZSOCK_POLLIN;
+	(void)zsock_poll(fds, 1, 1000);
+	test_work_wait(&test_data.work);
+
+	ret = zsock_getsockopt(c_sock, SOL_TLS, TLS_CIPHERSUITE_USED, &cs, &cs_len);
+	zassert_ok(ret, "No session after connect() (%d)", errno);
+
+	/* The connected session refuses another destination */
+	ret = zsock_sendto(c_sock, "x", 1, 0, (struct sockaddr *)&c_saddr, sizeof(c_saddr));
+	zassert_equal(ret, -1, "sendto() to another peer succeeded");
+	zassert_equal(errno, EISCONN, "unexpected errno %d", errno);
+
+	test_sockets_close();
+
+	/* Small delay for the final alert exchange */
+	k_msleep(10);
+#else
+	ztest_test_skip();
+#endif
+}
 
