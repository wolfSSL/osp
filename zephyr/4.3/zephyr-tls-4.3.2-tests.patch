+	static const sec_tag_t server_tags[] = { CA_CERTIFICATE_TAG, SERVER_CERTIFICATE_TAG };
+	const int peer_verify = TLS_PEER_VERIFY_OPTIONAL;
+	const int role = TLS_DTLS_ROLE_SERVER;
+	const struct timeval timeo = { .tv_sec = 5 };
