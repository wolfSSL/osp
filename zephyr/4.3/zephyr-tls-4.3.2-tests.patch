+	memset(rx_buf, 0, sizeof(rx_buf));
+	test_data.sock = c_sock;
+	k_work_init_delayable(&test_data.tx_work, send_work_handler);
+	test_work_reschedule(&test_data.tx_work, K_MSEC(10));
