+		zassert_not_equal(client_fd, -1, "failed to create client socket (%d)", errno);
+		zassert_ok(zsock_setsockopt(client_fd, SOL_TLS, TLS_SEC_TAG_LIST,
+					    chain_ca_client_tags[i],
