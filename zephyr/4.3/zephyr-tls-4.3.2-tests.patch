+static void dtls_client_unpin_work_handler(struct k_work *work)
+{
+	struct k_work_delayable *dwork = k_work_delayable_from_work(work);
+	struct connect_data *data = CONTAINER_OF(dwork, struct connect_data, work);
+	uint8_t tx_buf = 0;
