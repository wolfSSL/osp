+
+#if defined(CONFIG_WOLFSSL) && (!defined(HAVE_EXT_CACHE) || defined(NO_SESSION_CACHE))
+	/* Same gate as ZTLS_WOLFSSL_EXT_CACHE: without it there is nothing to resume from. */
+	ztest_test_skip();
