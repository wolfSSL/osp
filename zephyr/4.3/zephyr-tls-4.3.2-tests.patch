+	r = zsock_recv(client_fd, buf, sizeof(buf), 0);
+	zassert_equal(r, SECRET_SIZE, "recv() failed (%d)", errno);
+	r = zsock_send(client_fd, SECRET, SECRET_SIZE, 0);
