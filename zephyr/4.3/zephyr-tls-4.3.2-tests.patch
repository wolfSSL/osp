+	int server_fd, client_fd, r;
+
+	chain_ca_add_credentials();
+	k_sem_init(&server_sem, 0, 1);
+
+	server_fd = zsock_socket(AF_INET, SOCK_DGRAM, IPPROTO_DTLS_1_2);
