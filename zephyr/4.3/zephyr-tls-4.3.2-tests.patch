+				   (void *)cipher_list_psk, sizeof(cipher_list_psk));
+	zassert_equal(ret, 0, "Unable to set ciphersuites on server");
+	ret = zsock_setsockopt(c_sock, SOL_TLS, TLS_CIPHERSUITE_LIST,
