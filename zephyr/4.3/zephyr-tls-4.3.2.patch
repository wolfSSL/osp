+/* Stores in *out the length of the DER SEQUENCE at buf with its header, or returns -EINVAL */
+static int tls_der_object_len(const byte *buf, word32 len, word32 *out)
+{
+	word32 hdr, body, n, i;
+
+	if (len < 2 || buf[0] != (ASN_SEQUENCE | ASN_CONSTRUCTED)) {
+		return -EINVAL;
+	}
+
