+	if (tls_ctx->options.role == ZTLS_IS_SERVER) {
+		tls_ctx->dtls_rx_expiry = sys_timepoint_calc(
+			CONFIG_NET_SOCKETS_DTLS_TIMEOUT == 0 ?
+			K_FOREVER : K_MSEC(CONFIG_NET_SOCKETS_DTLS_TIMEOUT));
+	}
+
+	return received;
+}
