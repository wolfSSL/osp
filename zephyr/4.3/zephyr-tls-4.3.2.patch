+		n = buf[1] & 0x7f;
+		if (n == 0 || n > 4 || len < 2 + n) {
+			return -EINVAL;
+		}
+
+		body = 0;
+		for (i = 0; i < n; i++) {
+			body = (body << 8) | buf[2 + i];
+		}
+
+		hdr = 2 + n;
+	}
+
+	if (body > len - hdr) {
+		return -EINVAL;
+	}
+
+	*out = hdr + body;
+
+	return 0;
