From d5123327215c46eff7a77598dda80c4cf325ac49 Mon Sep 17 00:00:00 2001
From: Juliusz Sosinowicz <juliusz@wolfssl.com>
Date: Thu, 22 Oct 2026 17:23:51 +0000
Subject: [PATCH] Add wolfSSL support

All C changes are under OPENSSL_IS_WOLFSSL, and configure.ac,
xmlsec1-openssl.pc and testrun.sh change only when they find wolfSSL.
OpenSSL builds are the same as before. Run autoreconf -fi after
applying this patch.

- configure.ac: detect wolfSSL by OPENSSL_IS_WOLFSSL, before the version
  checks. wolfSSL reports a version number below the 1.1.1 minimum.
- Use the OpenSSL 1.1.1 API. Turn off DH (no X9.42 DHX keys) and
  Camellia (no EVP Camellia ciphers), as for LibreSSL and BoringSSL.
- Work around APIs wolfSSL does not have, as for LibreSSL and
  BoringSSL: no OSSL_STORE, no sk_X509_deep_copy, no sk_X509_reserve
  (stacks are lists) and no password prompt (EVP_read_pw_string).
- xmlsec1-openssl.pc: do not require the openssl pkg-config module
  with wolfSSL. Libs already has OPENSSL_LIBS.
- testrun.sh: add a wolfssl flavor that skips the OSSL_STORE key tests,
  as for LibreSSL and BoringSSL.
---
 configure.ac                    | 17 +++++++++++++++++
 include/xmlsec/openssl/crypto.h |  8 ++++++++
 src/openssl/openssl_compat.h    | 21 +++++++++++++++++++++
 tests/testrun.sh                |  3 +++
 xmlsec-openssl.pc.in            |  2 +-
 5 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index eb5071b..6f996fc 100644
--- a/configure.ac
+++ b/configure.ac
@@ -691,6 +691,7 @@ XMLSEC_OPENSSL_VERSION=""
 OPENSSL_INCLUDE_PATH=
 OPENSSL_LIB_PATH=
 OPENSSL_TEST_CONFIG=
+OPENSSL_PC_REQUIRES="openssl, "
 OPENSSL_FOUND=no
 AC_ARG_WITH([openssl], [AS_HELP_STRING([--with-openssl@<:@=PFX@:>@],[openssl location])])
 
@@ -857,6 +858,21 @@ if test "z$OPENSSL_FOUND" = "zyes" ; then
         ])
     fi
 
+    if test "z$XMLSEC_OPENSSL_VERSION" = "z" ; then
+        AC_EGREP_CPP(greater-than-minvers, [
+            #include <openssl/opensslv.h>
+            #ifdef OPENSSL_IS_WOLFSSL
+            greater-than-minvers
+            #endif
+        ],[
+            XMLSEC_OPENSSL_VERSION="wolfSSL"
+            OPENSSL_PC_REQUIRES=""
+            enable_dh=no
+        ],[
+            XMLSEC_OPENSSL_VERSION=""
+        ])
+    fi
+
     if test "z$XMLSEC_OPENSSL_VERSION" = "z" ; then
         AC_EGREP_CPP(greater-than-minvers, [
             #include <openssl/opensslv.h>
@@ -933,6 +949,7 @@ AC_SUBST(OPENSSL_CRYPTO_LIB)
 AC_SUBST(OPENSSL_TEST_CONFIG)
 AC_SUBST(OPENSSL_MIN_VERSION)
 AC_SUBST(OPENSSL3_MIN_VERSION)
+AC_SUBST(OPENSSL_PC_REQUIRES)
 AC_SUBST(XMLSEC_OPENSSL_VERSION)
 
 dnl See if we should build OpenSSL 3+ with engines support
diff --git a/include/xmlsec/openssl/crypto.h b/include/xmlsec/openssl/crypto.h
index ba118d3..cbe467c 100644
--- a/include/xmlsec/openssl/crypto.h
+++ b/include/xmlsec/openssl/crypto.h
@@ -48,6 +48,9 @@
 #define XMLSEC_OPENSSL_API_300      1
 #elif OPENSSL_VERSION_NUMBER >= 0x10101000L
 #define XMLSEC_OPENSSL_API_111      1
+#elif defined(OPENSSL_IS_WOLFSSL)
+/* wolfSSL reports an older version number but implements the OpenSSL 1.1.1 API */
+#define XMLSEC_OPENSSL_API_111      1
 #else  /* OPENSSL_VERSION_NUMBER */
 #error "This version of OpenSSL library is not supported"
 #endif /* OPENSSL_VERSION_NUMBER */
@@ -73,6 +76,11 @@
 #define XMLSEC_NO_CHACHA20              1
 #endif /* defined(LIBRESSL_VERSION_NUMBER) */
 
+#if defined(OPENSSL_IS_WOLFSSL)
+#define XMLSEC_NO_DH                    1
+#define XMLSEC_NO_CAMELLIA              1
+#endif /* defined(OPENSSL_IS_WOLFSSL) */
+
 #if !defined(XMLSEC_OPENSSL_API_350)
 #define XMLSEC_NO_MLDSA                 1
 #define XMLSEC_NO_MLKEM                 1
diff --git a/src/openssl/openssl_compat.h b/src/openssl/openssl_compat.h
index 694c8b1..b7d61a3 100644
--- a/src/openssl/openssl_compat.h
+++ b/src/openssl/openssl_compat.h
@@ -140,6 +140,27 @@ typedef int xmlSecOpenSSLSizeT;
 
 #endif /* defined(LIBRESSL_VERSION_NUMBER) */
 
+/******************************************************************************
+ *
+ * wolfSSL compatibility
+ *
+  *****************************************************************************/
+#if defined(OPENSSL_IS_WOLFSSL)
+
+/* Not implemented by wolfSSL */
+#define XMLSEC_OPENSSL_NO_STORE             1
+#define XMLSEC_OPENSSL_NO_DEEP_COPY         1
+
+/* EVP_read_pw_string() is not built: no password prompt, as with BoringSSL */
+#undef EVP_read_pw_string
+#define EVP_read_pw_string(buf,len, prompt, verify)     (-1)
+
+/* simply return success */
+#define sk_X509_reserve(crts, num)          (1)
+#define sk_X509_CRL_reserve(crls, num)      (1)
+
+#endif /* defined(OPENSSL_IS_WOLFSSL) */
+
 /******************************************************************************
  *
  * OpenSSL 4.0.0 compatibility
diff --git a/tests/testrun.sh b/tests/testrun.sh
index 58741cb..8532c17 100755
--- a/tests/testrun.sh
+++ b/tests/testrun.sh
@@ -103,6 +103,9 @@ case $XMLSEC_OPENSSL_VERSION in
 *AWSLC*)
     xmlsec_openssl_flavor="aws-lc"
     ;;
+*wolfSSL*)
+    xmlsec_openssl_flavor="wolfssl"
+    ;;
 *)
     xmlsec_openssl_flavor="openssl"
     ;;
diff --git a/xmlsec-openssl.pc.in b/xmlsec-openssl.pc.in
index 15a4b23..121e44f 100644
--- a/xmlsec-openssl.pc.in
+++ b/xmlsec-openssl.pc.in
@@ -6,7 +6,7 @@ includedir=@includedir@
 Name: xmlsec1-openssl
 Version: @VERSION@
 Description: XML Security Library implements XML Signature and XML Encryption standards
-Requires: openssl, libxml-2.0 >= @LIBXML_MIN_VERSION@ @LIBXSLT_PC_FILE_COND@
+Requires: @OPENSSL_PC_REQUIRES@libxml-2.0 >= @LIBXML_MIN_VERSION@ @LIBXSLT_PC_FILE_COND@
 Cflags: @XMLSEC_OPENSSL_CFLAGS@
 Cflags.private: -DXMLSEC_STATIC
 Libs: @XMLSEC_OPENSSL_LIBS@
-- 
2.43.0

